@using System.Globalization
@using Telerik.DataSource
@using Telerik.SvgIcons
@using BlazorBusiness.Web.Components.SingleSourceGrid

<TelerikCard ThemeColor="@ThemeConstants.Card.ThemeColor.Light" Width="100%" Class="pd-financials-card">
    <CardBody Class="pd-financials-body">
        <TelerikStackLayout Orientation="@StackLayoutOrientation.Vertical" Spacing="4px">

            <h2 class="pd-financials-title">Financials</h2>

            @* Filter bar: Search | Work Order | Clear all *@
            <div class="pd-filter-row">

                <div class="pd-filter-field pd-filter-field--search">
                    <label class="pd-filter-label">Search</label>
                    <TelerikTextBox Value="@_search"
                                    ValueChanged="@OnSearchChanged"
                                    Placeholder="Search by work order, vendor, line item, or description"
                                    Width="100%">
                        <TextBoxPrefixTemplate>
                            <TelerikSvgIcon Icon="@SvgIcon.Search" />
                        </TextBoxPrefixTemplate>
                    </TelerikTextBox>
                </div>

                @* WoItem wrapper required — TelerikMultiSelect resolves TextField/ValueField
                   via reflection; plain string has no "Text"/"Value" properties (runtime error). *@
                <div class="pd-filter-field pd-filter-field--wo">
                    <label class="pd-filter-label">Work Order</label>
                    <TelerikMultiSelect TItem="WoItem"
                                        TValue="string"
                                        Data="@_allWorkOrderItems"
                                        Value="@_selectedWorkOrders"
                                        ValueChanged="@OnWorkOrdersChanged"
                                        TextField="@nameof(WoItem.Label)"
                                        ValueField="@nameof(WoItem.Id)"
                                        Placeholder="All work orders"
                                        Filterable="true"
                                        Class="pd-wo-multiselect" />
                </div>

                <div class="pd-filter-actions">
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   Icon="@SvgIcon.FilterClear"
                                   OnClick="@ClearAllFilters"
                                   Class="pd-clear-all">
                        Clear all
                    </TelerikButton>
                </div>
            </div>

            @{
                var financialTemplates = new Dictionary<string, RenderFragment<FinancialGridRow>>
                {
                    [nameof(FinancialGridRow.ImportedDate)] =
                        row => @<text>@row.ImportedDate.ToString("MM/dd/yyyy")</text>,

                    [nameof(FinancialGridRow.ApQty)] =
                        row => @<text>@(row.ApQty.HasValue ? row.ApQty.Value.ToString("0.##") : "—")</text>,

                    [nameof(FinancialGridRow.ApUnit)] =
                        row => @<text>@(string.IsNullOrEmpty(row.ApUnit) ? "—" : row.ApUnit)</text>,

                    [nameof(FinancialGridRow.VendorFee)] =
                        row => @<text>@(row.VendorFee.HasValue ? row.VendorFee.Value.ToString("C", _usCulture) : "—")</text>,

                    [nameof(FinancialGridRow.ArQty)] =
                        row => @<text>@(row.ArQty.HasValue ? row.ArQty.Value.ToString("0.##") : "—")</text>,

                    [nameof(FinancialGridRow.ArUnit)] =
                        row => @<text>@(string.IsNullOrEmpty(row.ArUnit) ? "—" : row.ArUnit)</text>,

                    [nameof(FinancialGridRow.ClientFee)] =
                        row => @<text>@(row.ClientFee.HasValue ? row.ClientFee.Value.ToString("C", _usCulture) : "—")</text>,

                    [nameof(FinancialGridRow.BusinessStatus)] =
                        row => @<span class="@StatusPillClass(row.BusinessStatus)">@StatusPillText(row.BusinessStatus)</span>,

                    [nameof(FinancialGridRow.ClientStatus)] =
                        row => @<span class="@StatusPillClass(row.ClientStatus)">@StatusPillText(row.ClientStatus)</span>,

                    [nameof(FinancialGridRow.InvestorStatus)] =
                        row => @<span class="@StatusPillClass(row.InvestorStatus)">@StatusPillText(row.InvestorStatus)</span>,
                };
            }

            <div class="pd-financials-grid">
                <SingleSourceGrid TItem="FinancialGridRow"
                                   Data="@_filteredRows"
                                   InitialGroupDescriptors="@_woGroupDescriptors"
                                   HideGroupingBar="true"
                                   Height="560px"
                                   ColumnTemplates="@financialTemplates" />
            </div>

        </TelerikStackLayout>
    </CardBody>
</TelerikCard>


@code {
    private static readonly CultureInfo _usCulture = CultureInfo.GetCultureInfo("en-US");

    private readonly List<FinancialGridRow> _rows = BuildRows();
    private IEnumerable<FinancialGridRow> _filteredRows = Enumerable.Empty<FinancialGridRow>();

    private readonly IEnumerable<GroupDescriptor> _woGroupDescriptors =
    [
        new GroupDescriptor
        {
            Member     = nameof(FinancialGridRow.WorkOrder),
            MemberType = typeof(string)
        }
    ];

    private List<WoItem> _allWorkOrderItems = new();
    private List<string> _selectedWorkOrders = new();
    private string _search = string.Empty;

    protected override void OnInitialized()
    {
        _allWorkOrderItems = BuildAllWorkOrders()
            .Select(wo => new WoItem(wo))
            .ToList();
        RefreshFilteredRows();
    }

    private void RefreshFilteredRows()
    {
        _filteredRows = _rows
            .Where(MatchesSearch)
            .Where(MatchesWorkOrder)
            .OrderByDescending(r => r.ImportedDate)
            .ThenBy(r => r.WorkOrder)
            .ThenBy(r => r.LineItem)
            .ToList();
    }

    private bool MatchesSearch(FinancialGridRow row)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var q = _search.Trim();
        return row.WorkOrder.Contains(q, StringComparison.OrdinalIgnoreCase)
               || row.Vendor.Contains(q, StringComparison.OrdinalIgnoreCase)
               || row.Description.Contains(q, StringComparison.OrdinalIgnoreCase)
               || row.LineItem.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    // Empty selection means "all work orders".
    private bool MatchesWorkOrder(FinancialGridRow row) =>
        _selectedWorkOrders.Count == 0
        || _selectedWorkOrders.Contains(row.WorkOrder, StringComparer.OrdinalIgnoreCase);

    private void OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        RefreshFilteredRows();
    }

    private void OnWorkOrdersChanged(List<string> values)
    {
        _selectedWorkOrders = values ?? new();
        RefreshFilteredRows();
    }

    private void ClearAllFilters()
    {
        _search = string.Empty;
        _selectedWorkOrders = new();
        RefreshFilteredRows();
    }

    private List<string> BuildAllWorkOrders() =>
        _rows
            .Select(r => r.WorkOrder)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();

    private static string StatusPillClass(string? status) => status switch
    {
        "Approved"                      => "fin-spill fin-spill--approved",
        "Corrections Needed"            => "fin-spill fin-spill--corrections",
        "Not Required"                  => "fin-spill fin-spill--not-required",
        "Awaiting Approval Submitted"   => "fin-spill fin-spill--awaiting",
        "Approval Needed Not Submitted" => "fin-spill fin-spill--approval-needed",
        _                               => "fin-spill fin-spill--placeholder"
    };

    private static string StatusPillText(string? status) =>
        string.IsNullOrWhiteSpace(status) ? "Set status" : status;

    // Wrapper required so TelerikMultiSelect can resolve TextField/ValueField via reflection.
    // Using plain string gives a runtime error: "Text"/"Value" properties don't exist on string.
    private sealed class WoItem
    {
        public string Id    { get; }
        public string Label { get; }
        public WoItem(string value) { Id = value; Label = value; }
    }

    // ── Display model ──────────────────────────────────────────────────────────
    // Attributes drive SingleSourceGrid column generation via reflection.
    // WorkOrder is excluded from visible columns (AutoGenerate=false) but still
    // used as the InitialGroupDescriptors grouping field.

    [SingleSourceGridGroup(DisplayName = "Payable",    Key = "Payable",    Order = 7, Collapsible = true)]
    [SingleSourceGridGroup(DisplayName = "Receivable", Key = "Receivable", Order = 8, Collapsible = true)]
    [SingleSourceGridGroup(DisplayName = "Status",     Key = "Status",     Order = 9, Collapsible = true)]
    private sealed record FinancialGridRow(
        [property: SingleSourceGridAttribute(AutoGenerate = false)]
        string WorkOrder,

        [property: SingleSourceGridAttribute(DisplayName = "AP GPID",      Width = "120px", Order = 1, Groupable = false)]
        string ApGpid,

        [property: SingleSourceGridAttribute(DisplayName = "AR GPID",      Width = "120px", Order = 2, Groupable = false)]
        string ArGpid,

        [property: SingleSourceGridAttribute(DisplayName = "Line Item",    Width = "150px", Order = 3, Groupable = false)]
        string LineItem,

        [property: SingleSourceGridAttribute(DisplayName = "Description",  Width = "210px", Order = 4)]
        string Description,

        [property: SingleSourceGridAttribute(DisplayName = "Imported Date", Width = "125px", Order = 5, Groupable = false)]
        DateTime ImportedDate,

        [property: SingleSourceGridAttribute(DisplayName = "Vendor",       Width = "175px", Order = 6)]
        string Vendor,

        // ── Payable group ─────────────────────────────────────────────────────
        [property: SingleSourceGridAttribute(DisplayName = "QTY",     Width = "65px",  GroupKey = "Payable", Order = 1, Groupable = false)]
        decimal? ApQty,

        [property: SingleSourceGridAttribute(DisplayName = "UNIT",    Width = "65px",  GroupKey = "Payable", Order = 2, Groupable = false)]
        string? ApUnit,

        [property: SingleSourceGridAttribute(DisplayName = "Vendor $", Width = "110px", GroupKey = "Payable", Order = 3, Groupable = false)]
        decimal? VendorFee,

        // ── Receivable group ──────────────────────────────────────────────────
        [property: SingleSourceGridAttribute(DisplayName = "QTY",     Width = "65px",  GroupKey = "Receivable", Order = 1, Groupable = false)]
        decimal? ArQty,

        [property: SingleSourceGridAttribute(DisplayName = "UNIT",    Width = "65px",  GroupKey = "Receivable", Order = 2, Groupable = false)]
        string? ArUnit,

        [property: SingleSourceGridAttribute(DisplayName = "Client $", Width = "110px", GroupKey = "Receivable", Order = 3, Groupable = false)]
        decimal? ClientFee,

        // ── Status group ──────────────────────────────────────────────────────
        [property: SingleSourceGridAttribute(DisplayName = "Business", Width = "165px", GroupKey = "Status", Order = 1, Groupable = false)]
        string BusinessStatus,

        [property: SingleSourceGridAttribute(DisplayName = "Client",   Width = "195px", GroupKey = "Status", Order = 2, Groupable = false)]
        string ClientStatus,

        [property: SingleSourceGridAttribute(DisplayName = "Investor", Width = "205px", GroupKey = "Status", Order = 3, Groupable = false)]
        string InvestorStatus
    );

    private static List<FinancialGridRow> BuildRows()
    {
        var us = CultureInfo.GetCultureInfo("en-US");
        return
        [
            // ── 463456003-LMR  Lawn Maintenance Recurring ─────────────────────
            new("463456003-LMR", "GPAP-2026-0401", "—",
                "Lawn Maintenance", "Full mow, edge, and blow service",
                DateTime.Parse("04/03/2026", us), "Leyland Property Management",
                1m, "Ea", 95.00m, null, null, null,
                "Approved", "Not Required", "Not Required"),

            new("463456003-LMR", "—", "GPAR-2026-0402",
                "Lawn Maintenance", "12 recurring lawn maintenance cuts",
                DateTime.Parse("04/04/2026", us), "Leyland Property Management",
                null, null, null, 12m, "Mo", 1140.00m,
                "Approved", "Approval Needed Not Submitted", "Awaiting Approval Submitted"),

            // ── 463456003-BDE  Board / Door / Exterior ────────────────────────
            new("463456003-BDE", "GPAP-2026-0301", "—",
                "Boarding", "Board window opening",
                DateTime.Parse("03/03/2026", us), "Leyland Property Management",
                2m, "Ea", 99.16m, null, null, null,
                "Approved", "Not Required", "Not Required"),

            new("463456003-BDE", "—", "GPAR-2026-0302",
                "Exterior Door", "Repair/replace exterior door",
                DateTime.Parse("03/03/2026", us), "Leyland Property Management",
                null, null, null, 1m, "Ea", 1000.00m,
                "Corrections Needed", "", ""),

            new("463456003-BDE", "GPAP-2026-0303", "—",
                "Plumbing Service", "Plumbing repair service call",
                DateTime.Parse("03/03/2026", us), "Leyland Property Management",
                1m, "Hr", 467.00m, null, null, null,
                "Corrections Needed", "", ""),

            // ── 463456003-RFS  Roof Stabilization ─────────────────────────────
            new("463456003-RFS", "—", "GPAR-2026-0219",
                "Roof Inspection", "Roof condition and leak inspection",
                DateTime.Parse("02/19/2026", us), "Summit Roofing",
                null, null, null, 1m, "Ea", 220.00m,
                "Approved", "Not Required", "Approval Needed Not Submitted"),

            new("463456003-RFS", "GPAP-2026-0220", "—",
                "Tarp Installation", "Emergency tarp installation",
                DateTime.Parse("02/20/2026", us), "Summit Roofing",
                1m, "Ea", 460.00m, null, null, null,
                "Corrections Needed", "Approval Needed Not Submitted", ""),

            // ── 463456003-WTR  Water Damage Restoration ───────────────────────
            new("463456003-WTR", "—", "GPAR-2026-0112",
                "Water Extraction", "Water extraction and dry-out",
                DateTime.Parse("01/12/2026", us), "DryFast Restoration",
                null, null, null, 1m, "Ea", 1325.00m,
                "Approved", "Not Required", "Not Required"),

            new("463456003-WTR", "GPAP-2026-0115", "—",
                "Mold Treatment", "Mold treatment in lower level",
                DateTime.Parse("01/15/2026", us), "DryFast Restoration",
                1m, "Ea", 875.00m, null, null, null,
                "", "", ""),

            // ── 463456003-SEC  Security / Access ──────────────────────────────
            new("463456003-SEC", "—", "GPAR-2026-0106",
                "Rekey Locks", "Rekey front and rear doors",
                DateTime.Parse("01/06/2026", us), "Secure Entry Services",
                null, null, null, 2m, "Ea", 185.00m,
                "Approved", "Not Required", "Not Required"),

            new("463456003-SEC", "GPAP-2026-0106", "—",
                "Board Rear Door", "Temporary rear door board-up",
                DateTime.Parse("01/06/2026", us), "Secure Entry Services",
                1m, "Ea", 240.00m, null, null, null,
                "Approved", "Not Required", "Not Required"),

            // ── 463456003-CLN  Cleanup ─────────────────────────────────────────
            new("463456003-CLN", "—", "GPAR-2025-1217",
                "Trash Out", "Interior trash-out and haul away",
                DateTime.Parse("12/17/2025", us), "First Pass Preservation",
                null, null, null, 1m, "Ea", 510.00m,
                "", "Approval Needed Not Submitted", "Awaiting Approval Submitted"),
        ];
    }
}

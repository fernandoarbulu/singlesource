@using System.Globalization
@using Telerik.DataSource
@using Telerik.SvgIcons
@using BlazorBusiness.Web.Components.SingleSourceGrid

<TelerikCard ThemeColor="@ThemeConstants.Card.ThemeColor.Light" Width="100%" Class="pd-financials-card">
    <CardBody Class="pd-financials-body">
        <TelerikStackLayout Orientation="@StackLayoutOrientation.Vertical" Spacing="4px">

            <h2 class="pd-financials-title">Financials</h2>

            @* Filter bar: Search | Work Order | Clear all *@
            <div class="pd-filter-row">

                <div class="pd-filter-field pd-filter-field--search">
                    <label class="pd-filter-label">Search</label>
                    <TelerikTextBox Value="@_search"
                                    ValueChanged="@OnSearchChanged"
                                    Placeholder="Search by work order, vendor, line item, or description"
                                    Width="100%">
                        <TextBoxPrefixTemplate>
                            <TelerikSvgIcon Icon="@SvgIcon.Search" />
                        </TextBoxPrefixTemplate>
                    </TelerikTextBox>
                </div>

                @* WoItem wrapper required — TelerikMultiSelect resolves TextField/ValueField
                   via reflection; plain string has no "Text"/"Value" properties (runtime error). *@
                <div class="pd-filter-field pd-filter-field--wo">
                    <label class="pd-filter-label">Work Order</label>
                    <TelerikMultiSelect TItem="WoItem"
                                        TValue="string"
                                        Data="@_allWorkOrderItems"
                                        Value="@_selectedWorkOrders"
                                        ValueChanged="@OnWorkOrdersChanged"
                                        TextField="@nameof(WoItem.Label)"
                                        ValueField="@nameof(WoItem.Id)"
                                        Placeholder="All work orders"
                                        Filterable="true"
                                        Class="pd-wo-multiselect" />
                </div>

                <div class="pd-filter-actions">
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   Icon="@SvgIcon.FilterClear"
                                   OnClick="@ClearAllFilters"
                                   Class="pd-clear-all">
                        Clear all
                    </TelerikButton>
                </div>
            </div>

            @{
                var financialTemplates = new Dictionary<string, RenderFragment<FinancialGridRow>>
                {
                    [nameof(FinancialGridRow.ImportedDate)] =
                        row => @<text>@row.ImportedDate.ToString("MM/dd/yyyy")</text>,

                    [nameof(FinancialGridRow.ApQty)] =
                        row => @<text>@(row.ApQty.HasValue ? row.ApQty.Value.ToString("0.##") : "—")</text>,

                    [nameof(FinancialGridRow.ApUnit)] =
                        row => @<text>@(string.IsNullOrEmpty(row.ApUnit) ? "—" : row.ApUnit)</text>,

                    [nameof(FinancialGridRow.VendorFee)] =
                        row => @<text>@(row.VendorFee.HasValue ? row.VendorFee.Value.ToString("C", _usCulture) : "—")</text>,

                    [nameof(FinancialGridRow.ArQty)] =
                        row => @<text>@(row.ArQty.HasValue ? row.ArQty.Value.ToString("0.##") : "—")</text>,

                    [nameof(FinancialGridRow.ArUnit)] =
                        row => @<text>@(string.IsNullOrEmpty(row.ArUnit) ? "—" : row.ArUnit)</text>,

                    [nameof(FinancialGridRow.ClientFee)] =
                        row => @<text>@(row.ClientFee.HasValue ? row.ClientFee.Value.ToString("C", _usCulture) : "—")</text>,

                    [nameof(FinancialGridRow.BusinessStatus)] =
                        row => @<span class="@StatusPillClass(row.BusinessStatus)">@StatusPillText(row.BusinessStatus)</span>,

                    [nameof(FinancialGridRow.ClientStatus)] =
                        row => @<span class="@StatusPillClass(row.ClientStatus)">@StatusPillText(row.ClientStatus)</span>,

                    [nameof(FinancialGridRow.InvestorStatus)] =
                        row => @<span class="@StatusPillClass(row.InvestorStatus)">@StatusPillText(row.InvestorStatus)</span>,
                };
            }

            <div class="pd-financials-grid">
                <SingleSourceGrid TItem="FinancialGridRow"
                                   Data="@_filteredRows"
                                   InitialGroupDescriptors="@_woGroupDescriptors"
                                   HideGroupingBar="true"
                                   Height="560px"
                                   ColumnTemplates="@financialTemplates" />
            </div>

        </TelerikStackLayout>
    </CardBody>
</TelerikCard>


@code {
    // ── Developer handoff ─────────────────────────────────────────────────────
    // COMPONENT: PropertyFinancialsTab
    //
    // PARAMETERS:
    //   PropertyId — ID of the property whose financials to display.
    //                Passed to the data-fetch call when the API layer is connected.
    //   Rows       — Financial rows to render. When null, falls back to BuildMockRows()
    //                so the tab renders in isolation during development/demo.
    //                Pass API-loaded rows from the parent page to replace mock data.
    //
    // GRID DATA SHAPE:
    //   See Models/FinancialGridRow.cs for the full field contract.
    //   WorkOrder is the Telerik grouping key (InitialGroupDescriptors below).
    //   All rows with the same WorkOrder value are grouped together automatically.
    //
    // MOCK DATA LOCATION:
    //   BuildMockRows() at the bottom of this file.
    //
    // TO CONNECT REAL API:
    //   1. Inject your financial data service above @code.
    //   2. In OnParametersSetAsync(), fetch rows via PropertyId when Rows is null.
    //   3. Or supply rows from the parent: <PropertyFinancialsTab Rows="@_apiRows" />
    // ─────────────────────────────────────────────────────────────────────────

    /// <summary>ID of the property being displayed. Used to scope the API data fetch.</summary>
    [Parameter] public string? PropertyId { get; set; }

    /// <summary>
    /// Financial rows to render. When null, the component falls back to built-in mock data.
    /// Pass API-loaded <see cref="FinancialGridRow"/> instances from the parent page.
    /// </summary>
    [Parameter] public IEnumerable<FinancialGridRow>? Rows { get; set; }

    private static readonly CultureInfo _usCulture = CultureInfo.GetCultureInfo("en-US");

    private List<FinancialGridRow> _rows = [];
    private IEnumerable<FinancialGridRow> _filteredRows = Enumerable.Empty<FinancialGridRow>();

    private readonly IEnumerable<GroupDescriptor> _woGroupDescriptors =
    [
        new GroupDescriptor
        {
            Member     = nameof(FinancialGridRow.WorkOrder),
            MemberType = typeof(string)
        }
    ];

    private List<WoItem> _allWorkOrderItems = new();
    private List<string> _selectedWorkOrders = new();
    private string _search = string.Empty;

    // Track the last Rows reference to avoid rebuilding on every parent re-render.
    private IEnumerable<FinancialGridRow>? _lastRows;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_lastRows, Rows)) return;
        _lastRows = Rows;
        _rows = Rows?.ToList() ?? BuildMockRows();
        _allWorkOrderItems = BuildAllWorkOrders()
            .Select(wo => new WoItem(wo))
            .ToList();
        RefreshFilteredRows();
    }

    private void RefreshFilteredRows()
    {
        _filteredRows = _rows
            .Where(MatchesSearch)
            .Where(MatchesWorkOrder)
            .OrderByDescending(r => r.ImportedDate)
            .ThenBy(r => r.WorkOrder)
            .ThenBy(r => r.LineItem)
            .ToList();
    }

    private bool MatchesSearch(FinancialGridRow row)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var q = _search.Trim();
        return row.WorkOrder.Contains(q, StringComparison.OrdinalIgnoreCase)
               || row.Vendor.Contains(q, StringComparison.OrdinalIgnoreCase)
               || row.Description.Contains(q, StringComparison.OrdinalIgnoreCase)
               || row.LineItem.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    // Empty selection means "all work orders".
    private bool MatchesWorkOrder(FinancialGridRow row) =>
        _selectedWorkOrders.Count == 0
        || _selectedWorkOrders.Contains(row.WorkOrder, StringComparer.OrdinalIgnoreCase);

    private void OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        RefreshFilteredRows();
    }

    private void OnWorkOrdersChanged(List<string> values)
    {
        _selectedWorkOrders = values ?? new();
        RefreshFilteredRows();
    }

    private void ClearAllFilters()
    {
        _search = string.Empty;
        _selectedWorkOrders = new();
        RefreshFilteredRows();
    }

    private List<string> BuildAllWorkOrders() =>
        _rows
            .Select(r => r.WorkOrder)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();

    private static string StatusPillClass(string? status) => status switch
    {
        "Approved"                      => "fin-spill fin-spill--approved",
        "Corrections Needed"            => "fin-spill fin-spill--corrections",
        "Not Required"                  => "fin-spill fin-spill--not-required",
        "Awaiting Approval Submitted"   => "fin-spill fin-spill--awaiting",
        "Approval Needed Not Submitted" => "fin-spill fin-spill--approval-needed",
        _                               => "fin-spill fin-spill--placeholder"
    };

    private static string StatusPillText(string? status) =>
        string.IsNullOrWhiteSpace(status) ? "Set status" : status;

    // Wrapper required so TelerikMultiSelect can resolve TextField/ValueField via reflection.
    // Using plain string gives a runtime error: "Text"/"Value" properties don't exist on string.
    private sealed class WoItem
    {
        public string Id    { get; }
        public string Label { get; }
        public WoItem(string value) { Id = value; Label = value; }
    }


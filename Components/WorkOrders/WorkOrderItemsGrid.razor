@namespace SinglesourceApp.Components.WorkOrders
@using System.Globalization
@using Telerik.SvgIcons

<div class="cwoi-root">

    @if (_displayItems.Count == 0)
    {
        <div class="cwoi-empty-state">
            <p class="cwoi-empty-msg">No services have been added yet.</p>
            <p class="cwoi-empty-hint">Add supplemental items below to begin building this work order.</p>
        </div>
    }
    else
    {
    <div class="cwoi-grid-scroll">
        <TelerikGrid TItem="WorkOrderLineItem"
                     Data="@_displayItems"
                     Pageable="false"
                     Sortable="false"
                     Resizable="false"
                     Reorderable="false"
             Width="100%"
             Class="cwoi-grid"
             OnRowRender="@OnRowRenderHandler">

            <GridColumns>

                <GridColumn Title="Work Item" Width="240px">
                    <Template>
                        @{
                            var row = (WorkOrderLineItem)context;
                        }
                        <div class="cwoi-wi-stack">
                            <div class="cwoi-wi-name">@row.WorkItemName</div>
                            <div class="cwoi-wi-meta">
                                @(row.IsInherited ? "Suggested from pricing rules" : "Manually added")
                            </div>
                        </div>
                    </Template>
                </GridColumn>

                <GridColumn Title="Instructions">
                    <Template>
                        @{
                            var row = (WorkOrderLineItem)context;
                        }
                        <div class="cwoi-instr-cell">
                            @RenderInstructions(row)
                        </div>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(WorkOrderLineItem.UoM)" Title="UoM" Width="96px">
                    <Template>
                        @{
                            var row = (WorkOrderLineItem)context;
                        }
                        <span class="cwoi-cell-ro cwoi-cell-ro--fill">@row.UoM</span>
                    </Template>
                </GridColumn>

                <GridColumn Title="AR" Width="120px">
                    <Template>
                        @{
                            var row = (WorkOrderLineItem)context;
                        }
                        <span class="cwoi-cell-ro cwoi-cell-ro--fill cwoi-cell-num">@FormatRate(row.AR)</span>
                    </Template>
                </GridColumn>

                <GridColumn Title="AP" Width="130px">
                    <Template>
                        @{
                            var row = (WorkOrderLineItem)context;
                        }
                        <TelerikNumericTextBox T="decimal"
                                               Value="@row.AP"
                                               ValueChanged="@((decimal v) => OnApChanged(row, v))"
                                               Min="0m"
                                               Decimals="2"
                                               Format="N2"
                                               Width="100%" />
                    </Template>
                </GridColumn>

                <GridColumn Title="Qty" Width="110px">
                    <Template>
                        @{
                            var row = (WorkOrderLineItem)context;
                        }
                        <TelerikNumericTextBox T="decimal"
                                               Value="@row.Qty"
                                               ValueChanged="@((decimal v) => OnQtyChanged(row, v))"
                                               Min="0m"
                                               Decimals="2"
                                               Format="N2"
                                               Width="100%" />
                    </Template>
                </GridColumn>

                <GridColumn Title="Line Total" Width="130px">
                    <Template>
                        @{
                            var row = (WorkOrderLineItem)context;
                        }
                        <span class="cwoi-cell-calc cwoi-cell-ro--fill cwoi-cell-num">@FormatAmount(row.LineTotal)</span>
                    </Template>
                </GridColumn>

                <GridColumn Title="" Width="56px">
                    <HeaderTemplate>
                        <span class="cwoi-action-hdr" title="Remove">&nbsp;</span>
                    </HeaderTemplate>
                    <Template>
                        @{
                            var row = (WorkOrderLineItem)context;
                        }
                        <div class="cwoi-action-cell">
                            <TelerikButton Icon="@SvgIcon.Trash"
                                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                           Title="Remove item"
                                           OnClick="@(() => RemoveItem(row))" />
                        </div>
                    </Template>
                </GridColumn>

            </GridColumns>
        </TelerikGrid>

        <div class="cwoi-totals-strip">
            <span class="cwoi-totals-label">Totals</span>
            <span class="cwoi-totals-gap"></span>
            <span class="cwoi-total-uom-spacer"></span>
            <span class="cwoi-total-ar cwoi-cell-num">@FormatAmount(TotalAR)</span>
            <span class="cwoi-total-ap cwoi-cell-num">@FormatAmount(TotalAP)</span>
            <span class="cwoi-total-spacer"></span>
            <span class="cwoi-total-lt cwoi-cell-num">@FormatAmount(TotalLineTotal)</span>
            <span class="cwoi-total-actions"></span>
        </div>
    </div>
    }

    @if (_editingItem is not null)
    {
        <div class="cwoi-instr-backdrop" @onclick="CancelInstructions"></div>
        <div class="cwoi-instr-panel" @onkeydown="HandlePanelKeyDown">
            <div class="cwoi-instr-panel-hdr">
                <div class="cwoi-instr-panel-hdr-left">
                    <span class="cwoi-instr-panel-label">Instructions</span>
                    <span class="cwoi-instr-panel-divider" aria-hidden="true"></span>
                    <span class="cwoi-instr-panel-item">@_editingItem.WorkItemName</span>
                </div>
                <div class="cwoi-instr-panel-hdr-right">
                    <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                   OnClick="@CancelInstructions">Cancel</TelerikButton>
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   OnClick="@SaveInstructions">Save</TelerikButton>
                </div>
            </div>
            <div class="cwoi-instr-panel-body">
                <TelerikEditor @bind-Value="@_editDraft"
                               Height="210px"
                               Width="100%"
                               Tools="@_editorTools" />
            </div>
        </div>
    }

    <div class="cwoi-add-row">
        <div class="cwoi-add-row-main">
            <span class="cwoi-add-label">
                <span class="cwoi-add-plus" aria-hidden="true">+</span>
                Add Supplemental Item
            </span>
            <TelerikDropDownList Data="@FilteredAvailableNames"
                                 Value="@_selectedSupplementalItemName"
                                 ValueChanged="@((string? v) => OnSupplementalItemChangedAsync(v))"
                                 DefaultText="Select item…"
                                 Width="248px" />
        </div>
        @if (!string.IsNullOrEmpty(_addItemFeedback))
        {
            <span class="cwoi-add-feedback" role="alert">@_addItemFeedback</span>
        }
        else
        {
            <span class="cwoi-add-hint">Add additional services not included in pricing rules.</span>
        }
    </div>

</div>

@code {
    private static readonly CultureInfo _us = CultureInfo.GetCultureInfo("en-US");

    [Parameter, EditorRequired]
    public List<WorkOrderLineItem> Items { get; set; } = new();

    [Parameter]
    public EventCallback<List<WorkOrderLineItem>> ItemsChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> AvailableItemNames { get; set; } = WorkOrderTypeCatalog.AllWorkItemNames;

    private List<WorkOrderLineItem> _displayItems = new();
    private List<WorkOrderLineItem>? _lastSyncedItems;

    private string? _selectedSupplementalItemName;
    private string? _addItemFeedback;

    // ── Row-highlight state (new supplemental item flash) ─────────────────
    private string? _newlyAddedItemId;
    private int _highlightVersion;

    // ── Instructions panel state ──────────────────────────────────────────
    private WorkOrderLineItem? _editingItem;
    private string _editDraft = "";

    // IEditorTool lives in Telerik.Blazor.Components (already imported globally).
    // Tool classes live in Telerik.Blazor.Components.Editor — qualify fully to
    // avoid ambiguity with same-named types in Telerik.SvgIcons (Bold, Italic).
    private static readonly List<IEditorTool> _editorTools = new List<IEditorTool>
    {
        new Telerik.Blazor.Components.Editor.EditorButtonGroup(
            new Telerik.Blazor.Components.Editor.Bold(),
            new Telerik.Blazor.Components.Editor.Italic()),
        new Telerik.Blazor.Components.Editor.EditorButtonGroup(
            new Telerik.Blazor.Components.Editor.UnorderedList(),
            new Telerik.Blazor.Components.Editor.OrderedList()),
    };

    private decimal TotalAR => _displayItems.Sum(i => (i.AR ?? 0m) * i.Qty);

    private decimal TotalAP => _displayItems.Sum(i => i.AP * i.Qty);

    private decimal TotalLineTotal => _displayItems.Sum(i => i.LineTotal);

    private IReadOnlyList<string> FilteredAvailableNames =>
        AvailableItemNames
            .Where(n => !_displayItems.Any(i => i.WorkItemName.Equals(n, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Items, _lastSyncedItems))
        {
            _displayItems = Items?.ToList() ?? new();
            _lastSyncedItems = Items;
        }
    }

    private RenderFragment RenderInstructions(WorkOrderLineItem row) => __builder =>
    {
        var preview = GetInstructionsPreview(row.Instructions, 70);
        var hasContent = preview.Length > 0;

        <div class="cwoi-instr-preview-wrap">
            @if (hasContent)
            {
                <span class="cwoi-instr-preview-text">@preview</span>
            }
            else
            {
                <span class="cwoi-instr-none">—</span>
            }
        </div>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Link"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                       Class="cwoi-instr-edit-btn"
                       Title="@(hasContent ? "Edit instructions" : "Add instructions")"
                       OnClick="@(() => OpenInstructionsPanel(row))">
            @(hasContent ? "Edit" : "Add")
        </TelerikButton>
    };

    private void OpenInstructionsPanel(WorkOrderLineItem row)
    {
        _editingItem = row;
        _editDraft = row.Instructions ?? "";
        StateHasChanged();
    }

    private void CancelInstructions()
    {
        _editingItem = null;
        _editDraft = "";
    }

    private void SaveInstructions()
    {
        if (_editingItem is null) return;
        _editingItem.Instructions = _editDraft;
        _editingItem = null;
        _editDraft = "";
        StateHasChanged();
    }

    private static string GetInstructionsPreview(string? instructions, int maxLen)
    {
        if (string.IsNullOrWhiteSpace(instructions)) return "";
        var stripped = System.Text.RegularExpressions.Regex.Replace(instructions, "<[^>]+>", " ")
            .Replace("&nbsp;", " ")
            .Replace("&amp;", "&")
            .Replace("&lt;", "<")
            .Replace("&gt;", ">")
            .Replace("\r\n", " ")
            .Replace("\n", " ")
            .Trim();
        while (stripped.Contains("  ")) stripped = stripped.Replace("  ", " ");
        return stripped.Length > maxLen ? stripped[..maxLen] + "…" : stripped;
    }

    private void OnRowRenderHandler(GridRowRenderEventArgs args)
    {
        var item = (WorkOrderLineItem)args.Item;
        var classes = new System.Text.StringBuilder();
        if (!item.IsInherited)
            classes.Append("cwoi-row-manual ");
        if (_newlyAddedItemId is not null && _newlyAddedItemId == item.Id)
            classes.Append("cwoi-row-new ");
        args.Class = classes.ToString().Trim();
    }

    private void HandlePanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CancelInstructions();
    }

    private void ScheduleHighlightClear(string itemId)
    {
        var version = ++_highlightVersion;
        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            if (_highlightVersion == version)
            {
                _newlyAddedItemId = null;
                InvokeAsync(StateHasChanged);
            }
        });
    }

    private static string FormatRate(decimal? value) =>
        value.HasValue ? value.Value.ToString("C2", _us) : "—";

    private static string FormatAmount(decimal value) =>
        value.ToString("C2", _us);

    private void OnApChanged(WorkOrderLineItem item, decimal value)
    {
        item.AP = value;
        StateHasChanged();
    }

    private void OnQtyChanged(WorkOrderLineItem item, decimal value)
    {
        item.Qty = value;
        StateHasChanged();
    }

    private void RemoveItem(WorkOrderLineItem item)
    {
        if (ReferenceEquals(_editingItem, item))
            CancelInstructions();
        _displayItems = _displayItems.Where(i => !ReferenceEquals(i, item)).ToList();
        _lastSyncedItems = _displayItems;
        _selectedSupplementalItemName = null;
        _addItemFeedback = null;
        _ = ItemsChanged.InvokeAsync(_displayItems);
        StateHasChanged();
    }

    private Task OnSupplementalItemChangedAsync(string? itemName)
    {
        _addItemFeedback = null;

        if (string.IsNullOrWhiteSpace(itemName))
        {
            _selectedSupplementalItemName = null;
            return Task.CompletedTask;
        }

        if (_displayItems.Any(i => i.WorkItemName.Equals(itemName, StringComparison.OrdinalIgnoreCase)))
        {
            _addItemFeedback = "That item is already on this work order.";
            _selectedSupplementalItemName = null;
            StateHasChanged();
            return Task.CompletedTask;
        }

        var newItem = WorkOrderTypeCatalog.CreateSupplementalLine(itemName);
        _newlyAddedItemId = newItem.Id;
        ScheduleHighlightClear(newItem.Id);
        _displayItems = [.. _displayItems, newItem];
        _lastSyncedItems = _displayItems;
        _selectedSupplementalItemName = null;
        _ = ItemsChanged.InvokeAsync(_displayItems);
        StateHasChanged();
        return Task.CompletedTask;
    }
}

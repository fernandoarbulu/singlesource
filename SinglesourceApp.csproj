<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- index.html references _framework/blazor.webassembly.js by its stable name, so the
         loader script must not be fingerprinted in any configuration. -->
    <BlazorFingerprintBlazorJs>false</BlazorFingerprintBlazorJs>
  </PropertyGroup>

  <!-- DEV-ONLY workarounds.
       The WASM dev server only serves stable label routes (SinglesourceApp.wasm → 200,
       SinglesourceApp.{hash}.wasm → 404), and index.html fingerprint placeholders are not
       reliably rewritten on the watch path (aspnetcore#65710). Disabling fingerprinting and
       placeholder rewriting keeps `dotnet run`/`dotnet watch` working locally.
       These MUST stay Debug-only — Release relies on fingerprinting for integrity safety. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <!-- RELEASE / publish (Vercel).
       Fingerprinting is ON (SDK default). Every runtime asset is content-addressed
       (dotnet.native.[hash].wasm, etc.) so its URL is its content hash — a CDN cannot
       serve bytes that mismatch the integrity hash in the boot manifest. This is the
       version-safe design and the real fix for the SRI mismatch on Vercel.
       OverrideHtmlAssetPlaceholders is left at its default (true) so index.html receives
       the fingerprinted asset URLs. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WasmFingerprintAssets>true</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude reference files from compilation — they contain SDK/API dependencies
         that are not available in this project. Use only as design reference. -->
    <Compile Remove="_reference/**" />
    <Content Remove="_reference/**" />
    <EmbeddedResource Remove="_reference/**" />
    <None Remove="_reference/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- LogicalName keeps a stable manifest name across SDK/root-namespace changes -->
    <EmbeddedResource Include="Data/PropertyMdmV4.json">
      <LogicalName>PropertyMdmV4.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" PrivateAssets="all" />
    <PackageReference Include="Telerik.UI.for.Blazor" Version="12.0.0" />
  </ItemGroup>

</Project>

@using BlazorBusiness.Web.Components.SingleSourceGrid
﻿@using BlazorBusiness.Web.Components.Tasks.Chips
@using BlazorBusiness.Web.Models.Tasking
@using SingleSource.WebAPI.Business.SDK

@inject IAuthenticationService AuthenticationService

<TelerikTooltip TargetSelector=".address-tooltip" />

@{
    Dictionary<string, RenderFragment<TaskGridDisplayModel>> TaskTemplates =
        new()
        {
            {
                nameof(TaskGridDisplayModel.PropertyAddress),
                task => @<span title="@task.PropertyAddress" class="address-tooltip truncate-text">
                            @task.PropertyAddress
                         </span>
            },
            {
                nameof(TaskGridDisplayModel.DueDate),
                task => @<span class="@GetDueDateCssClass(task)">
                            @GetDueDateText(task)
                         </span>
            },
            {
                nameof(TaskGridDisplayModel.TaskInstanceStatusName),
                task => 
                    @<span class="@GetStatusClass(task.TaskInstanceStatusName)">
                        @task.TaskInstanceStatusName
                    </span>
            },
            {
                nameof(TaskGridDisplayModel.Ranking),
                task => @<span>@GetRank(task)</span>
            },
            {
                nameof(TaskGridDisplayModel.Action),
                task => @<TelerikButton FillMode="@(IsViewAction(task) ? ThemeConstants.Button.FillMode.Outline : ThemeConstants.Button.FillMode.Solid)"
                            ThemeColor="@(IsViewAction(task) ? ThemeConstants.Button.ThemeColor.Light : ThemeConstants.Button.ThemeColor.Primary)"
                            OnClick="@(() => OnActionClicked(task))">
                        @GetActionText(task)
                     </TelerikButton>
            }
        };
}

<SingleSourceGrid TItem="TaskGridDisplayModel" Data="TasksToDisplay"
                  ColumnTemplates="TaskTemplates"
                  Height="calc(100vh - 200px)">
</SingleSourceGrid>
    private void ApplyMapping()
    {
        _rmAttempted = true;
        if (string.IsNullOrWhiteSpace(_rmSelectedType)) return;

        // Strip "Category — " prefix to get the clean work item name.
        var sep   = " — ";
        var idx   = _rmSelectedType.IndexOf(sep, StringComparison.Ordinal);
        var label = idx >= 0 ? _rmSelectedType[(idx + sep.Length)..] : _rmSelectedType;

        var item = _resolveMappingTarget!;
        item.Description          = label;
        item.IsUnmapped           = false;
        item.VendorRawDescription = "";
        _hasStagedChanges         = true;
        _resolveMappingVisible    = false;

        _toastMessage = $"Mapped to \"{label}\" — review variance and set status.";
        _ = ShowSuccessToastAsync();
        StateHasChanged();
    }


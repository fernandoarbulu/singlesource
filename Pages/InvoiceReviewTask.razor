    // ── Status edit modal ─────────────────────────────────────────────────────
    // Single-row: clicking any status pill opens the modal pre-filled with that row's statuses.
    // Bulk: selecting rows and clicking "Edit Status" opens with empty/no-change defaults.
    //
    // "" (empty string) is used as the sentinel meaning "not set" (single mode) or
    // "no change" (bulk mode).  The placeholder option in each list has Value="".

    private bool _statusModalVisible;
    private bool _statusModalIsBulk;
    private List<IrtLineItem> _statusModalTargets = [];
    private string _statusDraftBusiness = "";
    private string _statusDraftClient   = "";
    private string _statusDraftInvestor = "";
    private string? _statusDraftComment;

    // StatusOption is a simple value/label pair for TelerikDropDownList.
    private sealed record StatusOption(string Value, string Label);

    private static readonly List<StatusOption> _statusOptsCore =
    [
        new("Approved",                   "Approved"),
        new("Approved Within Allowable",  "Approved Within Allowable"),
        new("Denied",                     "Denied"),
        new("Needs Corrections",          "Needs Corrections"),
        new("Pending Review",             "Pending Review"),
        new("Not Required",               "Not Required"),
        new("Not Submitted",              "Not Submitted"),
        new("Awaiting Approval",          "Awaiting Approval"),
        new("Submitted",                  "Submitted"),
    ];

    // Prepend the context-appropriate placeholder as the first option.
    private IReadOnlyList<StatusOption> StatusOptsForModal =>
        _statusModalIsBulk
            ? [new("", "— No change —"),  .. _statusOptsCore]
            : [new("", "— Not Set —"),    .. _statusOptsCore];

    private void OpenStatusModal(IrtLineItem item)
    {
        _statusModalIsBulk   = false;
        _statusModalTargets  = [item];
        _statusDraftBusiness = item.BusinessStatus ?? "";
        _statusDraftClient   = item.ClientStatus   ?? "";
        _statusDraftInvestor = item.InvestorStatus  ?? "";
        _statusDraftComment  = null;
        _statusModalVisible  = true;
    }

    private void OpenStatusModalBulk(List<IrtLineItem> items)
    {
        _statusModalIsBulk   = true;
        _statusModalTargets  = items;
        _statusDraftBusiness = "";   // "" = no change
        _statusDraftClient   = "";
        _statusDraftInvestor = "";
        _statusDraftComment  = null;
        _statusModalVisible  = true;
    }

    private void SaveStatusModal()
    {
        foreach (var item in _statusModalTargets)
        {
            // In bulk mode, "" means "no change" — skip those fields so existing values
            // on other rows are not overwritten.
            if (!_statusModalIsBulk || !string.IsNullOrEmpty(_statusDraftBusiness))
                item.BusinessStatus = string.IsNullOrEmpty(_statusDraftBusiness) ? null : _statusDraftBusiness;
            if (!_statusModalIsBulk || !string.IsNullOrEmpty(_statusDraftClient))
                item.ClientStatus   = string.IsNullOrEmpty(_statusDraftClient)   ? null : _statusDraftClient;
            if (!_statusModalIsBulk || !string.IsNullOrEmpty(_statusDraftInvestor))
                item.InvestorStatus = string.IsNullOrEmpty(_statusDraftInvestor) ? null : _statusDraftInvestor;
        }
        _statusModalVisible = false;
        _hasStagedChanges   = true;
        StateHasChanged();
    }

    // ── Send Back for Corrections ─────────────────────────────────────────────
    // Reusable component concept: required reason comment + confirmation before action.

    private bool   _sendBackVisible;
    private string _sendBackComment  = "";

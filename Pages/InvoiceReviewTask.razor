        item.VendorUnitCost = v;
        _hasStagedChanges = true;
        StateHasChanged();
    }

    private void OnClientUnitCostChanged(IrtLineItem item, decimal v)
    {
        item.ClientUnitCost = v;
        _hasStagedChanges = true;
        StateHasChanged();
    }


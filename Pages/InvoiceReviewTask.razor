    // ── Line item model ───────────────────────────────────────────────────────
    // SingleSourceGridGroup attributes drive the collapsible column header groups via reflection.
    // Computed properties update live because the EditTemplates call StateHasChanged() on each change.
    // HasQtyMismatch drives the orange Qty highlight in the ColumnTemplate.

    [SingleSourceGridGroup(DisplayName = "Work Item",            Key = "WI",  Order = 1, Collapsible = true, HeaderClass = "irt-gh--wi")]
    [SingleSourceGridGroup(DisplayName = "Work Item Financials", Key = "WIF", Order = 2, Collapsible = true, HeaderClass = "irt-gh--wif")]
    [SingleSourceGridGroup(DisplayName = "Variance",             Key = "Var", Order = 3, Collapsible = true, HeaderClass = "irt-gh--var")]
    [SingleSourceGridGroup(DisplayName = "Status",               Key = "Dec", Order = 4, Collapsible = true, HeaderClass = "irt-gh--dec")]
    private sealed class IrtLineItem
    {
        // ── Work Item group ──────────────────────────────────────────────────────
        [SingleSourceGridAttribute(DisplayName = "Line Item",    Width = "100px", GroupKey = "WI", Order = 1, Groupable = false, Sortable = true,  Filterable = false, Editable = false, ShowColumnMenu = false)]
        public string LineItem { get; set; } = "";

        [SingleSourceGridAttribute(DisplayName = "Description",               GroupKey = "WI", Order = 2, Groupable = false, Sortable = true,  Filterable = false, Editable = false, VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string Description { get; set; } = "";

        [SingleSourceGridAttribute(DisplayName = "WO Unit",      Width = "76px",  GroupKey = "WI", Order = 3, Groupable = false, Sortable = false, Filterable = false, Editable = false, ShowColumnMenu = false)]
        public string WoUnit { get; set; } = "";

        [SingleSourceGridAttribute(DisplayName = "WO Unit Cost", Width = "112px", GroupKey = "WI", Order = 4, Groupable = false, Sortable = false, Filterable = false, Editable = false, ShowColumnMenu = false)]
        public decimal? WoUnitCost { get; set; }

        // ── Work Item Financials group ──────────────────────────────────────────
        [SingleSourceGridAttribute(DisplayName = "Qty",          Width = "80px",  GroupKey = "WIF", Order = 1, Groupable = false, Sortable = true,  Filterable = false, Editable = true,  ShowColumnMenu = false)]
        public decimal Qty { get; set; }

        // Hidden: WO original quantity used only for HasQtyMismatch — not rendered as a column
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public decimal? OriginalQty { get; set; }

        [SingleSourceGridAttribute(DisplayName = "UOM",          Width = "70px",  GroupKey = "WIF", Order = 2, Groupable = false, Sortable = false, Filterable = false, Editable = false, VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string Unit { get; set; } = "";

        [SingleSourceGridAttribute(DisplayName = "Vendor Cost",  Width = "120px", GroupKey = "WIF", Order = 3, Groupable = false, Sortable = false, Filterable = false, Editable = true,  ShowColumnMenu = false)]
        public decimal? VendorUnitCost { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Vendor Total", Width = "120px", GroupKey = "WIF", Order = 4, Groupable = false, Sortable = true,  Filterable = false, Editable = false, VisibleWhenCollapsed = true, IsCalculated = true, ShowColumnMenu = false)]
        public decimal VendorFeeTotal => Qty * (VendorUnitCost ?? 0m);

        [SingleSourceGridAttribute(DisplayName = "Client Cost",  Width = "120px", GroupKey = "WIF", Order = 5, Groupable = false, Sortable = false, Filterable = false, Editable = true,  ShowColumnMenu = false)]
        public decimal? ClientUnitCost { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Client Total", Width = "120px", GroupKey = "WIF", Order = 6, Groupable = false, Sortable = true,  Filterable = false, Editable = false, VisibleWhenCollapsed = true, IsCalculated = true, ShowColumnMenu = false)]
        public decimal ClientFeeTotal => Qty * (ClientUnitCost ?? 0m);

        // ── Variance group ──────────────────────────────────────────────────────
        [SingleSourceGridAttribute(DisplayName = "Vendor Var.",  Width = "118px", GroupKey = "Var", Order = 1, Groupable = false, Sortable = true,  Filterable = false, Editable = false, IsCalculated = true, ShowColumnMenu = false)]
        public decimal? VendorVariance =>
            VendorUnitCost.HasValue && WoUnitCost.HasValue
                ? Qty * (VendorUnitCost.Value - WoUnitCost.Value)
                : null;

        [SingleSourceGridAttribute(DisplayName = "Client Var.",  Width = "118px", GroupKey = "Var", Order = 2, Groupable = false, Sortable = true,  Filterable = false, Editable = false, IsCalculated = true, ShowColumnMenu = false)]
        public decimal? ClientVariance =>
            ClientUnitCost.HasValue && WoUnitCost.HasValue
                ? Qty * (ClientUnitCost.Value - WoUnitCost.Value)
                : null;

        // ── Status group — clickable pills open status-edit modal ─────────────
        [SingleSourceGridAttribute(DisplayName = "Business",     Width = "150px", GroupKey = "Dec", Order = 1, Groupable = false, Sortable = true,  Filterable = false, Editable = false, ShowColumnMenu = false)]
        public string? BusinessStatus { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Client",       Width = "158px", GroupKey = "Dec", Order = 2, Groupable = false, Sortable = true,  Filterable = false, Editable = false, VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string? ClientStatus { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Investor",     Width = "162px", GroupKey = "Dec", Order = 3, Groupable = false, Sortable = true,  Filterable = false, Editable = false, VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string? InvestorStatus { get; set; }

        // Internal flag — not a column. Drives the orange Qty highlight in the ColumnTemplate.
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public bool HasQtyMismatch => OriginalQty.HasValue && Qty != OriginalQty.Value;
    }


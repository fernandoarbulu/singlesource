    // ── Unexpensed item model ─────────────────────────────────────────────────
    private sealed class IrtUnexpensedItem
    {
        public string  WorkItem         { get; set; } = "";
        public string  Description      { get; set; } = "";
        public decimal RequestedQty     { get; set; }
        public string  Unit             { get; set; } = "";
        public decimal ExpectedUnitCost { get; set; }
        public string  Status           { get; set; } = "";
        public string  WorkOrderNumber  { get; set; } = "";
        public string  VendorName       { get; set; } = "";
        public decimal ExpectedTotal    => RequestedQty * ExpectedUnitCost;
        // Resolution state (local/staged)
        public bool    IsMarkedNotDone  { get; set; }
        public bool    IsFlagged        { get; set; }
    }

    // ── Orphan section state ──────────────────────────────────────────────────
    private bool _orphansCollapsed;

    private void MarkOrphanNotDone(IrtUnexpensedItem item)
    {
        item.IsMarkedNotDone = true;
        _hasStagedChanges    = true;
        _toastMessage        = $"\"{item.Description}\" marked as not done.";
        _ = ShowSuccessToastAsync();
        StateHasChanged();
    }

    private void FlagOrphanIssue(IrtUnexpensedItem item)
    {
        item.IsFlagged    = true;
        _hasStagedChanges = true;
        _toastMessage     = $"\"{item.Description}\" flagged for follow-up.";
        _ = ShowSuccessToastAsync();
        StateHasChanged();
    }

    private void DenyOrphanItem(IrtOrphanRow row)
    {
        if (row.SourceLine is not null)
        {
            row.SourceLine.BusinessStatus = "Denied";
            _hasStagedChanges             = true;
            _toastMessage                 = $"\"{row.VendorDescription}\" denied.";
            _ = ShowSuccessToastAsync();
            StateHasChanged();
        }
    }

    // Opens the status modal pre-targeting an orphan source line for quick NC.
    private void OpenNcOrphan(IrtOrphanRow row)
    {
        if (row.SourceLine is not null)
            OpenStatusModal(row.SourceLine);
        else if (row.SourceItem is not null)
            FlagOrphanIssue(row.SourceItem);
    }

    // Spec Scenario D — Create Work Item for an orphan invoice line.
    // Mock implementation: resolves the line by treating it as a newly created work item,
    // clearing the unmapped/external flag so it graduates to the matched table.
    private void CreateWorkItemForOrphan(IrtOrphanRow row)
    {
        if (row.SourceLine is null) return;

        var line = row.SourceLine;
        // For demo: assign the vendor description as the new work item name,
        // clear orphan flags, stamp a nominal WO cost to show it is now mapped.
        line.Description       = string.IsNullOrWhiteSpace(line.VendorRawDescription) ? line.Description : line.VendorRawDescription;
        line.WoDescription     = $"Created from vendor submission — {line.VendorRawDescription}";
        line.IsUnmapped        = false;
        line.IsExternallyCreated = false;
        line.WoUnitCost        = line.VendorUnitCost;
        line.WoCustomerUnitCost = line.ClientUnitCost;
        line.OriginalQty       = line.Qty;
        _hasStagedChanges      = true;

        _toastMessage = $"Work item created for \"{line.Description}\" — review variance and set status.";
        _ = ShowSuccessToastAsync();
        StateHasChanged();
    }

    // ── Orphan rows — cached for the current render cycle ────────────────────
    // Exposed as a property so the header and section body both reference the same
    // list without calling BuildOrphanRows() multiple times per render.
    private IReadOnlyList<IrtOrphanRow> _orphanRows => BuildOrphanRows();

    // ── Orphan exposure totals (for the section footer) ───────────────────────
    private decimal OrphanVendorExposure   => _orphanRows.Sum(r => r.ApAmount ?? 0m);
    private decimal OrphanCustomerExposure => _orphanRows.Sum(r => r.ArAmount ?? 0m);

    private string OrphanStatusCss(IrtOrphanRow row) => row.OrphanStatus?.ToLower() switch
    {
        "denied"             => "ss-pill ss-pill--denied",
        "needs corrections"  => "ss-pill ss-pill--corrections",
        "flagged"            => "ss-pill ss-pill--corrections",
        "approved"           => "ss-pill ss-pill--approved",
        "needs assignment"   => "ss-pill ss-pill--pending",
        "needs decision"     => "ss-pill ss-pill--pending",
        "no invoice"         => "ss-pill ss-pill--pending",
        "completed"          => "ss-pill ss-pill--neutral",
        _                    => "ss-pill ss-pill--neutral",
    };

    // ── IrtOrphanRow — unified view of unmatched invoice and missing invoice rows ──
    // Combines:
    //   Type A — Unmatched Invoice: lines where IsUnmapped || IsExternallyCreated.
    //            No WorkItemID resolved; full vendor amount surfaces as variance.
    //   Type B — Missing Invoice: _unexpensedItems entries where !IsMarkedNotDone.
    //            Work item exists but contractor invoice has not arrived yet.

    private sealed class IrtOrphanRow
    {
        public string                Id                 { get; init; } = "";
        public string                OrphanType         { get; init; } = "";  // "Unmatched Invoice" | "Externally Created" | "Missing Invoice"
        public string                OrphanTypeCss      { get; init; } = "";  // unmatched | external | missing
        public string                WorkItemRef        { get; init; } = "";
        public string                VendorDescription  { get; init; } = "";
        public decimal               Qty                { get; init; }
        public string                Unit               { get; init; } = "";
        public decimal?              ApAmount           { get; init; }
        public decimal?              ArAmount           { get; init; }
        public string                OrphanStatus       { get; init; } = "";
        public IrtLineItem?          SourceLine         { get; init; }
        public IrtUnexpensedItem?    SourceItem         { get; init; }
        // Variance: for unmatched/external = full ApAmount (no work item to compare to).
        // For missing invoice = null (no invoice yet).
        public decimal?              Variance           { get; init; }
    }

    private IReadOnlyList<IrtOrphanRow> BuildOrphanRows()
    {
        var rows = new List<IrtOrphanRow>();

        // Type A1 — Unmatched Invoice (Scenario B: unmapped product type)
        foreach (var l in _lines.Where(l => l.IsUnmapped))
        {
            rows.Add(new IrtOrphanRow
            {
                Id                = l.LineItem,
                OrphanType        = "Unmatched Invoice",
                OrphanTypeCss     = "unmatched",
                WorkItemRef       = "Requires Mapping",
                VendorDescription = l.VendorRawDescription,
                Qty               = l.Qty,
                Unit              = l.Unit,
                ApAmount          = l.VendorFeeTotal,
                ArAmount          = l.ClientFeeTotal,
                Variance          = l.VendorFeeTotal,   // full amount is unplanned
                OrphanStatus      = l.BusinessStatus ?? "Needs Assignment",
                SourceLine        = l,
            });
        }

        // Type A2 — Externally Created (Scenario A: no WO work item at all)
        foreach (var l in _lines.Where(l => l.IsExternallyCreated))
        {
            rows.Add(new IrtOrphanRow
            {
                Id                = l.LineItem,
                OrphanType        = "No Work Item Match",
                OrphanTypeCss     = "external",
                WorkItemRef       = "No Work Item",
                VendorDescription = l.VendorRawDescription,
                Qty               = l.Qty,
                Unit              = l.Unit,
                ApAmount          = l.VendorFeeTotal,
                ArAmount          = l.ClientFeeTotal,
                Variance          = l.VendorFeeTotal,
                OrphanStatus      = l.BusinessStatus ?? "Needs Decision",
                SourceLine        = l,
            });
        }

        // Type B — Missing Invoice (work item prescribed, no vendor invoice received)
        foreach (var u in _unexpensedItems.Where(i => !i.IsMarkedNotDone))
        {
            rows.Add(new IrtOrphanRow
            {
                Id                = u.WorkItem,
                OrphanType        = "Missing Invoice",
                OrphanTypeCss     = "missing",
                WorkItemRef       = u.WorkItem,
                VendorDescription = u.Description,
                Qty               = u.RequestedQty,
                Unit              = u.Unit,
                ApAmount          = null,              // no invoice yet — $0 placeholder
                ArAmount          = u.ExpectedTotal,   // estimated AR from WO
                Variance          = null,              // no invoice to compare
                OrphanStatus      = u.IsFlagged ? "Flagged" : u.Status switch {
                    "No Expense Submitted"      => "No Invoice",
                    "Completed Without Expense" => "Completed",
                    _                           => u.Status,
                },
                SourceItem        = u,
            });
        }

        return rows;
    }
}

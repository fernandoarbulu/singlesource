    private void HandleAddExpenseFromDrawer()
    {
        var orphan = _drawerOrphanItem;
        CloseDrawer();
        if (orphan is null)
            return;

        HandleAddExpense(orphan);
    }

    private void HandleAddExpense(IrtUnexpensedItem item)
    {
        if (item is null)
            return;

        _addExpenseTarget     = item;
        // Pre-fill work item name from the Description column (human-readable);
        // trigger catalog lookup to populate description template if it exists.
        _aeWorkItemName       = item.Description;
        _aeDescription        = item.Description;
        if (_workItemCatalog.TryGetValue(item.Description, out var catalogMeta))
            _aeDescription = catalogMeta.Description;
        _aeQty                = item.RequestedQty;
        _aeUnit               = item.Unit;
        _aeVendorCost         = item.ExpectedUnitCost > 0 ? item.ExpectedUnitCost : null;
        _aeClientCost         = null;
        _aeNotes              = "";
        _aeAttempted          = false;
        _aeFocusQtyOnOpen     = true;
        _addExpenseModalVisible = true;
    }

    private void CloseAddExpenseModal()
    {
        _addExpenseModalVisible = false;
        _aeFocusQtyOnOpen = false;
    }

    private async Task CommitAddExpense()
    {
        _aeAttempted = true;
        if (!AeFormIsValid) return;

        var newItem = new IrtLineItem
        {
            LineItem       = _aeWorkItemName,
            Description    = _aeWorkItemName,                                // work item type name
            WoDescription  = string.IsNullOrWhiteSpace(_aeDescription) ? _aeWorkItemName : _aeDescription,
            WoUnit         = _aeUnit,
            WoUnitCost     = null,   // no WO pricing rule — variance = full fee total
            WoCustomerUnitCost = null,
            OriginalQty    = _addExpenseTarget?.RequestedQty,
            Qty            = _aeQty,
            Unit           = _aeUnit,
            VendorUnitCost = _aeVendorCost,
            ClientUnitCost = _aeClientCost,
            BusinessStatus = null,   // reviewer assigns status after the expense is added
            ClientStatus   = null,
            InvestorStatus = null,
        };

        // Create a new list reference so SingleSourceGrid.OnParametersSet detects the change.
        // TODO: persist via API when wired.
        _lines = [.. _lines, newItem];

        // Remove the satisfied row from the unexpensed section.
        if (_addExpenseTarget is not null)
            _unexpensedItems = _unexpensedItems.Where(i => i != _addExpenseTarget).ToList();

        _addExpenseModalVisible = false;
        _aeFocusQtyOnOpen       = false;
        _hasStagedChanges       = true;

        _newlyAddedLineItem = newItem.LineItem;
        _toastMessage = "Expense added successfully";
        await ShowSuccessToastAsync();
        ScheduleClearRowHighlight();

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_addExpenseModalVisible && _aeFocusQtyOnOpen && _aeQtyRef is not null)
        {
            _aeFocusQtyOnOpen = false;
            await _aeQtyRef.FocusAsync();
        }
    }

    // ── Toast / row-highlight helpers ─────────────────────────────────────────

    private bool     _successToastVisible;
    private string   _toastMessage = "Expense added successfully";
    private string?  _newlyAddedLineItem;
    private CancellationTokenSource? _toastCts;
    private CancellationTokenSource? _highlightCts;

    private async Task ShowSuccessToastAsync()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        _successToastVisible = true;
        StateHasChanged();

        try
        {
            await Task.Delay(3000, token);
            _successToastVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private void ScheduleClearRowHighlight()
    {
        _highlightCts?.Cancel();
        _highlightCts?.Dispose();
        _highlightCts = new CancellationTokenSource();
        _ = ClearRowHighlightAfterDelayAsync(_highlightCts.Token);
    }

    private async Task ClearRowHighlightAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(2400, token);
            _newlyAddedLineItem = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private string LineItemCellClass(IrtLineItem item) =>
        item.LineItem == _newlyAddedLineItem ? "irt-row-new-marker" : "";

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _highlightCts?.Cancel();
        _highlightCts?.Dispose();
    }


@page "/invoice-review-task/{taskId}"
@layout PropertyShellLayout
@using BlazorBusiness.Web.Components.SingleSourceGrid
@using BlazorBusiness.Web.Components.Tasks.Cards
@using Telerik.DataSource
@using System.Globalization
@inject NavigationManager Navigation

<PageTitle>Invoice Review — @TaskId</PageTitle>

<div class="irt-root">

    @* ── Back link ──────────────────────────────────────────────────── *@
    <a href="/property-details?tab=Tasks" class="irt-back">← Back to Tasks</a>

    @* ── Header ─────────────────────────────────────────────────────── *@
    <div class="irt-header">
        <div class="irt-header__left">
            <h1 class="irt-header__title">Review vendor submitted invoice</h1>
            <span class="irt-header__meta">Last updated 9/11/2025 2:32 PM</span>
        </div>
        <div class="irt-header__actions">
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           OnClick="@(() => Navigation.NavigateTo("/property-details?tab=Tasks"))">
                Exit Task
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base">
                Save
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Solid"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Success">
                Complete Task
            </TelerikButton>
        </div>
    </div>

    @* ── Task data card ──────────────────────────────────────────────── *@
    <TaskDetailCard Status="In Progress"
                    StatusVariant="@StatusBadgeVariant.Active"
                    OrderNumber="ORD-882741"
                    FullAddress="1321 Posner Blvd, Davenport, FL 33837"
                    TaskTypeName="Invoice Review"
                    LoanNumber="935720463"
                    InvoiceDate="9/11/2025"
                    DueDate="9/17/2025"
                    InvoiceNumber="INV-29481"
                    TimeElapsed="1d 6h"
                    Assignee="Kristyn G"
                    Vendor="GreenScape LLC" />

    @* ── Submission guidance card ────────────────────────────────────── *@
    @* Cards parameter is omitted — TaskSubmissionGuidanceCard renders its built-in default mock cards.
       TODO: pass Cards="@_guidanceCards" when API-backed guidance data is available. *@
    <TaskSubmissionGuidanceCard />

    @* ── Supporting documents card ───────────────────────────────────── *@
    @* Files parameter is omitted → renders empty state.
       TODO: pass Files="@_attachedFiles" and OnSelectFiles="@HandleSelectFiles" when file service is wired. *@
    <TaskSupportingDocumentsCard />

    @* ── Invoice line items grid ─────────────────────────────────────── *@
    <TelerikCard Class="irt-card" ThemeColor="@ThemeConstants.Card.ThemeColor.Light">
        <CardHeader Class="irt-card-hdr">
            <CardTitle>Invoice Line Items</CardTitle>
        </CardHeader>
        <CardBody Class="irt-grid-body">
            @{
                var us = CultureInfo.GetCultureInfo("en-US");

                var tpl = new Dictionary<string, RenderFragment<InvoiceLineItem>>
                {
                    // Invoice Submitted group
                    [nameof(InvoiceLineItem.InvQty)]  = r => @<text>@(r.InvQty.HasValue  ? r.InvQty.Value.ToString("0.##")  : "—")</text>,
                    [nameof(InvoiceLineItem.InvUnit)]  = r => @<text>@(r.InvUnit  ?? "—")</text>,
                    [nameof(InvoiceLineItem.VendorFee)] = r => @<text>@(r.VendorFee.HasValue ? r.VendorFee.Value.ToString("C", us) : "—")</text>,
                    // Pricing Reference group
                    [nameof(InvoiceLineItem.ArPrice)]  = r => @<text>@(r.ArPrice.HasValue  ? r.ArPrice.Value.ToString("C", us)  : "—")</text>,
                    [nameof(InvoiceLineItem.ApPrice)]  = r => @<text>@(r.ApPrice.HasValue  ? r.ApPrice.Value.ToString("C", us)  : "—")</text>,
                    // Standalone
                    [nameof(InvoiceLineItem.Allowance)] = r => @<text>@(r.Allowance.HasValue ? r.Allowance.Value.ToString("C", us) : "—")</text>,
                    // Variance group — coloured text
                    [nameof(InvoiceLineItem.VarDollar)] = r =>
                        @<span class="@VarCss(r.VarDollar)">
                            @(r.VarDollar.HasValue ? r.VarDollar.Value.ToString("C", us) : "—")
                        </span>,
                    [nameof(InvoiceLineItem.VarPct)] = r =>
                        @<span class="@VarCss(r.VarPct)">
                            @(r.VarPct.HasValue ? $"{r.VarPct.Value:+0.#;-0.#;0}%" : "—")
                        </span>,
                    // Decision / Status group — badge pills
                    [nameof(InvoiceLineItem.BusinessStatus)]    = r => @<span class="@StatusCss(r.BusinessStatus)">@StatusLabel(r.BusinessStatus)</span>,
                    [nameof(InvoiceLineItem.ClientDecision)]    = r => @<span class="@StatusCss(r.ClientDecision)">@StatusLabel(r.ClientDecision)</span>,
                    [nameof(InvoiceLineItem.InvestorDecision)]  = r => @<span class="@StatusCss(r.InvestorDecision)">@StatusLabel(r.InvestorDecision)</span>,
                    [nameof(InvoiceLineItem.ApprovalState)]     = r => @<span class="@StatusCss(r.ApprovalState)">@StatusLabel(r.ApprovalState)</span>,
                };
            }
            <SingleSourceGrid TItem="InvoiceLineItem"
                               Data="@_lines"
                               InitialGroupDescriptors="@_woDescriptors"
                               Context="@SsgGridContext.Task"
                               HideGroupingBar="true"
                               Height="460px"
                               ColumnTemplates="@tpl" />
        </CardBody>
    </TelerikCard>

</div>

@code {
    [Parameter] public string? TaskId { get; set; }

    // ── Grouping ──────────────────────────────────────────────────────

    private static readonly IEnumerable<GroupDescriptor> _woDescriptors =
    [
        new GroupDescriptor { Member = nameof(InvoiceLineItem.WorkOrder), MemberType = typeof(string) }
    ];

    // ── Helpers ───────────────────────────────────────────────────────

    private static string StatusCss(string? s) => s?.ToLower() switch
    {
        "approved"                   => "irt-status irt-status--approved",
        "corrections needed"         => "irt-status irt-status--warn",
        "needs approval"             => "irt-status irt-status--warn",
        "needs client approval"      => "irt-status irt-status--warn",
        "needs investor approval"    => "irt-status irt-status--warn",
        "not required"               => "irt-status irt-status--neutral",
        "not submitted"              => "irt-status irt-status--neutral",
        "pending review"             => "irt-status irt-status--info",
        "awaiting approval"          => "irt-status irt-status--info",
        "submitted"                  => "irt-status irt-status--info",
        _                            => "irt-status irt-status--empty"
    };

    private static string StatusLabel(string? s) =>
        string.IsNullOrWhiteSpace(s) ? "Set status" : s;

    private static string VarCss(decimal? v) => v switch
    {
        > 0 => "irt-var-over",
        < 0 => "irt-var-under",
        _   => ""
    };

    // ── Mock data ─────────────────────────────────────────────────────
    // TODO: replace with API call when invoice review data layer is wired.

    private static readonly List<InvoiceLineItem> _lines =
    [
        // WO-4634: all lines clean — no variance, no approval needed
        new()
        {
            WorkOrder = "WO-4634", LineItem = "LI-001", Description = "Lawn Mowing",
            InvQty = 4, InvUnit = "EA", VendorFee = 240m,
            ArPrice = 300m, ApPrice = 240m, VarDollar = 0m, VarPct = 0m, Allowance = 300m,
            BusinessStatus = "Approved", ClientDecision = "Not Required",
            InvestorDecision = "Not Required", ApprovalState = "Approved"
        },
        new()
        {
            WorkOrder = "WO-4634", LineItem = "LI-002", Description = "Hedge Trimming",
            InvQty = 2, InvUnit = "EA", VendorFee = 180m,
            ArPrice = 200m, ApPrice = 180m, VarDollar = 0m, VarPct = 0m, Allowance = 200m,
            BusinessStatus = "Approved", ClientDecision = "Not Required",
            InvestorDecision = "Not Required", ApprovalState = "Approved"
        },
        new()
        {
            WorkOrder = "WO-4634", LineItem = "LI-003", Description = "Debris Removal",
            InvQty = 1, InvUnit = "LS", VendorFee = 95m,
            ArPrice = 100m, ApPrice = 85m, VarDollar = 10m, VarPct = 11.8m, Allowance = 100m,
            BusinessStatus = "Needs Approval", ClientDecision = "Needs Client Approval",
            InvestorDecision = "Not Required", ApprovalState = "Pending Review"
        },
        // WO-4635: mixed — over-invoiced items requiring multi-party decisions
        new()
        {
            WorkOrder = "WO-4635", LineItem = "LI-001", Description = "Tree Trimming",
            InvQty = 1, InvUnit = "EA", VendorFee = 350m,
            ArPrice = 300m, ApPrice = 350m, VarDollar = 50m, VarPct = 16.7m, Allowance = 350m,
            BusinessStatus = "Needs Approval", ClientDecision = "Not Submitted",
            InvestorDecision = "Needs Investor Approval", ApprovalState = "Pending Review"
        },
        new()
        {
            WorkOrder = "WO-4635", LineItem = "LI-002", Description = "Stump Grinding",
            InvQty = 3, InvUnit = "EA", VendorFee = 420m,
            ArPrice = 200m, ApPrice = 280m, VarDollar = 140m, VarPct = 50m, Allowance = 300m,
            BusinessStatus = null, ClientDecision = null,
            InvestorDecision = null, ApprovalState = null
            // TODO: wire inline editing for decision fields (AllowEdit=true when API is ready)
        },
        new()
        {
            WorkOrder = "WO-4635", LineItem = "LI-003", Description = "Fertilization",
            InvQty = 1, InvUnit = "LS", VendorFee = 75m,
            ArPrice = 80m, ApPrice = 75m, VarDollar = -5m, VarPct = -6.3m, Allowance = 80m,
            BusinessStatus = "Approved", ClientDecision = "Not Required",
            InvestorDecision = "Not Required", ApprovalState = "Approved"
        },
    ];

    // ── InvoiceLineItem model ─────────────────────────────────────────
    // TODO: promote to a shared models file when connecting to the backend API.

    // Column groups — all collapsible so complex decision data can be hidden
    // when reviewers need a focused view. The Financials tab uses the same
    // collapsible pattern; both share the SingleSourceGrid collapse engine.
    [SingleSourceGridGroup(DisplayName = "Work Order",        Key = "WO",  Order = 1, Collapsible = true)]
    [SingleSourceGridGroup(DisplayName = "Invoice Submitted", Key = "Inv", Order = 2, Collapsible = true)]
    [SingleSourceGridGroup(DisplayName = "Pricing Reference", Key = "Ref", Order = 3, Collapsible = true)]
    [SingleSourceGridGroup(DisplayName = "Variance",          Key = "Var", Order = 4, Collapsible = true)]
    [SingleSourceGridGroup(DisplayName = "Decision / Status", Key = "Dec", Order = 6, Collapsible = true)]
    private sealed class InvoiceLineItem
    {
        // Hidden from columns; used only as the InitialGroupDescriptors field.
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public string WorkOrder { get; set; } = "";

        // Work Order group — line identity
        [SingleSourceGridAttribute(DisplayName = "Line Item",   Width = "120px", GroupKey = "WO", Order = 1, Groupable = false, Filterable = false)]
        public string LineItem { get; set; } = "";

        [SingleSourceGridAttribute(DisplayName = "Description", Width = "180px", GroupKey = "WO", Order = 2)]
        public string Description { get; set; } = "";

        // Invoice Submitted group — what the vendor actually submitted
        [SingleSourceGridAttribute(DisplayName = "QTY",      Width = "65px",  GroupKey = "Inv", Order = 1, Groupable = false, Sortable = false)]
        public decimal? InvQty    { get; set; }

        [SingleSourceGridAttribute(DisplayName = "UNIT",     Width = "65px",  GroupKey = "Inv", Order = 2, Groupable = false, Sortable = false)]
        public string?  InvUnit   { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Vendor $", Width = "105px", GroupKey = "Inv", Order = 3, Groupable = false, Sortable = false)]
        public decimal? VendorFee { get; set; }

        // Pricing Reference group — contract vs. AP pricing
        [SingleSourceGridAttribute(DisplayName = "AR", Width = "90px", GroupKey = "Ref", Order = 1, Groupable = false, Sortable = false)]
        public decimal? ArPrice { get; set; }

        [SingleSourceGridAttribute(DisplayName = "AP", Width = "90px", GroupKey = "Ref", Order = 2, Groupable = false, Sortable = false)]
        public decimal? ApPrice { get; set; }

        // Variance group — delta between invoice and reference
        [SingleSourceGridAttribute(DisplayName = "$ Var", Width = "95px", GroupKey = "Var", Order = 1, Groupable = false, Sortable = false, Filterable = false)]
        public decimal? VarDollar { get; set; }

        [SingleSourceGridAttribute(DisplayName = "% Var", Width = "80px", GroupKey = "Var", Order = 2, Groupable = false, Sortable = false, Filterable = false)]
        public decimal? VarPct    { get; set; }

        // Standalone — allowable ceiling for the line item
        [SingleSourceGridAttribute(DisplayName = "Allowance", Width = "100px", Order = 5, Groupable = false, Sortable = false)]
        public decimal? Allowance { get; set; }

        // Decision / Status group — multi-party approval tracking
        // TODO: wire inline editing for decision fields (AllowEdit=true when API is ready)
        [SingleSourceGridAttribute(DisplayName = "Business",          Width = "155px", GroupKey = "Dec", Order = 1, Groupable = false, Sortable = false)]
        public string? BusinessStatus { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Client Decision",   Width = "175px", GroupKey = "Dec", Order = 2, Groupable = false, Sortable = false)]
        public string? ClientDecision { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Investor Decision", Width = "175px", GroupKey = "Dec", Order = 3, Groupable = false, Sortable = false)]
        public string? InvestorDecision { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Approval State",    Width = "155px", GroupKey = "Dec", Order = 4, Groupable = false, Sortable = false)]
        public string? ApprovalState { get; set; }
    }
}

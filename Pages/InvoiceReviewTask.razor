    // ── Line item model ───────────────────────────────────────────────────────
    // Spec: Financial Table Design Handoff — PART 1 MVP.
    // Column naming follows spec letter references: A=OriginalQty, B=WoUnitCost, C=WoCustomerUnitCost,
    //   AB=WoTotalAP, AC=WoTotalAR, D=Qty, E=VendorUnitCost, F=VendorFeeTotal,
    //   G=ClientUnitCost, H=ClientFeeTotal.
    // Variance formula: Vendor Var = F - AB; Customer Var = H - AC.
    //   When no work item exists (unmapped / externally created): AB=AC=0 → variance = full fee total.
    //   When no expense (VendorUnitCost/ClientUnitCost null): variance = null (shown as "—").

    [SingleSourceGridGroup(DisplayName = "Work Item",            Key = "WI",  Order = 1, Collapsible = true, HeaderClass = "irt-gh--wi")]
    [SingleSourceGridGroup(DisplayName = "Work Item Financials", Key = "WIF", Order = 2, Collapsible = true, HeaderClass = "irt-gh--wif")]
    [SingleSourceGridGroup(DisplayName = "Variance",             Key = "Var", Order = 3, Collapsible = true, HeaderClass = "irt-gh--var")]
    [SingleSourceGridGroup(DisplayName = "Status",               Key = "Dec", Order = 4, Collapsible = true, HeaderClass = "irt-gh--dec")]
    private sealed class IrtLineItem
    {
        // ── Work Item group ──────────────────────────────────────────────────────

        // Internal row ID — not a grid column; used for drawer identity and staging references.
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public string LineItem { get; set; } = "";

        // "Work Item" column = work item type name. Always visible. Editable via dropdown.
        [SingleSourceGridAttribute(DisplayName = "Work Item",                    GroupKey = "WI", Order = 1, Groupable = false, Sortable = true,  Filterable = false, Editable = true,  VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string Description { get; set; } = "";

        // "Description" column = DescriptionNoCRLF from PPW work order. Always visible, read-only.
        [SingleSourceGridAttribute(DisplayName = "Description",                  GroupKey = "WI", Order = 2, Groupable = false, Sortable = false, Filterable = false, Editable = false, VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string WoDescription { get; set; } = "";

        // (A) Original work order quantity — expand-only, read-only.
        [SingleSourceGridAttribute(DisplayName = "(A) Qty",      Width = "82px",  GroupKey = "WI", Order = 3, Groupable = false, Sortable = false, Filterable = false, Editable = false, ShowColumnMenu = false)]
        public decimal? OriginalQty { get; set; }

        // Work order UOM — expand-only, read-only.
        [SingleSourceGridAttribute(DisplayName = "UOM",          Width = "70px",  GroupKey = "WI", Order = 4, Groupable = false, Sortable = false, Filterable = false, Editable = false, ShowColumnMenu = false)]
        public string WoUnit { get; set; } = "";

        // (B) Work order vendor unit cost (AP) — expand-only, read-only.
        [SingleSourceGridAttribute(DisplayName = "(B) Unit Cost AP", Width = "132px", GroupKey = "WI", Order = 5, Groupable = false, Sortable = false, Filterable = false, Editable = false, ShowColumnMenu = false)]
        public decimal? WoUnitCost { get; set; }

        // (C) Work order customer unit cost (AR) — expand-only, read-only.
        [SingleSourceGridAttribute(DisplayName = "(C) Unit Cost AR", Width = "132px", GroupKey = "WI", Order = 6, Groupable = false, Sortable = false, Filterable = false, Editable = false, ShowColumnMenu = false)]
        public decimal? WoCustomerUnitCost { get; set; }

        // (AB) Work Item Total AP = B × A — expand-only, read-only, calculated.
        [SingleSourceGridAttribute(DisplayName = "(AB) WI Total AP", Width = "132px", GroupKey = "WI", Order = 7, Groupable = false, Sortable = false, Filterable = false, Editable = false, IsCalculated = true, ShowColumnMenu = false)]
        public decimal WoTotalAP => WoUnitCost.HasValue ? WoUnitCost.Value * (OriginalQty ?? 0m) : 0m;

        // (AC) Work Item Total AR = C × A — expand-only, read-only, calculated.
        [SingleSourceGridAttribute(DisplayName = "(AC) WI Total AR", Width = "132px", GroupKey = "WI", Order = 8, Groupable = false, Sortable = false, Filterable = false, Editable = false, IsCalculated = true, ShowColumnMenu = false)]
        public decimal WoTotalAR => WoCustomerUnitCost.HasValue ? WoCustomerUnitCost.Value * (OriginalQty ?? 0m) : 0m;

        // ── Work Item Financials group ──────────────────────────────────────────

        // (D) PPW expense qty — always visible, editable, orange if mismatch vs. WO qty.
        [SingleSourceGridAttribute(DisplayName = "(D) Qty",      Width = "80px",  GroupKey = "WIF", Order = 1, Groupable = false, Sortable = true,  Filterable = false, Editable = true,  VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public decimal Qty { get; set; }

        // PPW expense UOM — always visible, read-only. Visually flagged if differs from WoUnit.
        [SingleSourceGridAttribute(DisplayName = "Unit",         Width = "70px",  GroupKey = "WIF", Order = 2, Groupable = false, Sortable = false, Filterable = false, Editable = false, VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string Unit { get; set; } = "";

        // (E) Vendor unit cost — expand-only, editable. Drives F.
        [SingleSourceGridAttribute(DisplayName = "(E) Vendor Cost", Width = "126px", GroupKey = "WIF", Order = 3, Groupable = false, Sortable = false, Filterable = false, Editable = true,  ShowColumnMenu = false)]
        public decimal? VendorUnitCost { get; set; }

        // (F) Vendor Total = D × E — expand-only, auto-calculated, read-only, italic.
        [SingleSourceGridAttribute(DisplayName = "(F) Vendor Total", Width = "126px", GroupKey = "WIF", Order = 4, Groupable = false, Sortable = true,  Filterable = false, Editable = false, IsCalculated = true, ShowColumnMenu = false)]
        public decimal VendorFeeTotal => Qty * (VendorUnitCost ?? 0m);

        // (G) Customer unit cost — expand-only, editable. Drives H.
        [SingleSourceGridAttribute(DisplayName = "(G) Customer Cost", Width = "134px", GroupKey = "WIF", Order = 5, Groupable = false, Sortable = false, Filterable = false, Editable = true,  ShowColumnMenu = false)]
        public decimal? ClientUnitCost { get; set; }

        // (H) Customer Total = D × G — expand-only, auto-calculated, read-only, italic.
        [SingleSourceGridAttribute(DisplayName = "(H) Customer Total", Width = "134px", GroupKey = "WIF", Order = 6, Groupable = false, Sortable = true,  Filterable = false, Editable = false, IsCalculated = true, ShowColumnMenu = false)]
        public decimal ClientFeeTotal => Qty * (ClientUnitCost ?? 0m);

        // ── Variance group ──────────────────────────────────────────────────────
        // Vendor Var = F - AB. When no expense (VendorUnitCost null): null → shown as "—".
        // When no work item (unmapped/external): AB = 0 → variance = full F in red.
        [SingleSourceGridAttribute(DisplayName = "Vendor Var.",    Width = "120px", GroupKey = "Var", Order = 1, Groupable = false, Sortable = true,  Filterable = false, Editable = false, IsCalculated = true, ShowColumnMenu = false)]
        public decimal? VendorVariance =>
            VendorUnitCost.HasValue ? VendorFeeTotal - WoTotalAP : null;

        // Customer Var = H - AC.
        [SingleSourceGridAttribute(DisplayName = "Customer Var.",  Width = "124px", GroupKey = "Var", Order = 2, Groupable = false, Sortable = true,  Filterable = false, Editable = false, IsCalculated = true, ShowColumnMenu = false)]
        public decimal? ClientVariance =>
            ClientUnitCost.HasValue ? ClientFeeTotal - WoTotalAR : null;

        // ── Status group — clickable pills open status-edit modal ─────────────
        [SingleSourceGridAttribute(DisplayName = "Business",      Width = "162px", GroupKey = "Dec", Order = 1, Groupable = false, Sortable = true,  Filterable = false, Editable = false, ShowColumnMenu = false)]
        public string? BusinessStatus { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Customer",      Width = "162px", GroupKey = "Dec", Order = 2, Groupable = false, Sortable = true,  Filterable = false, Editable = false, VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string? ClientStatus { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Investor",      Width = "162px", GroupKey = "Dec", Order = 3, Groupable = false, Sortable = true,  Filterable = false, Editable = false, VisibleWhenCollapsed = true, ShowColumnMenu = false)]
        public string? InvestorStatus { get; set; }

        // ── Computed flags ─────────────────────────────────────────────────────
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public bool HasQtyMismatch => OriginalQty.HasValue && Qty != OriginalQty.Value;

        [SingleSourceGridAttribute(AutoGenerate = false)]
        public bool HasUomMismatch => !string.IsNullOrEmpty(WoUnit) && !string.IsNullOrEmpty(Unit) && Unit != WoUnit;

        // ── Drawer-only fields ─────────────────────────────────────────────────
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public string WorkOrderNumber { get; set; } = "";

        [SingleSourceGridAttribute(AutoGenerate = false)]
        public string VendorName { get; set; } = "";

        [SingleSourceGridAttribute(AutoGenerate = false)]
        public string VendorReference { get; set; } = "";

        [SingleSourceGridAttribute(AutoGenerate = false)]
        public int PhotoCount { get; set; }

        // ── Unmapped product type (Scenario B) ────────────────────────────────
        // Set true when expense arrives with no known work item type mapping.
        // Cleared by ApplyMapping() once resolved.
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public bool IsUnmapped { get; set; }

        [SingleSourceGridAttribute(AutoGenerate = false)]
        public string VendorRawDescription { get; set; } = "";

        // ── Externally created expense (Scenario A) ───────────────────────────
        // Expense submitted by vendor outside a work order — no work item exists.
        // AB = AC = 0 → variance = full F and H in red.
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public bool IsExternallyCreated { get; set; }

        // ── Per-row Needs Corrections comment (staged) ────────────────────────
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public string? StatusComment { get; set; }
    }

    // ── Unexpensed work items mock data ───────────────────────────────────────

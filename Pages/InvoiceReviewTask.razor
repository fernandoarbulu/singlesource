@page "/invoice-review-task/{taskId}"
@layout PropertyShellLayout
@using BlazorBusiness.Web.Components.SingleSourceGrid
@using BlazorBusiness.Web.Components.Tasks.Cards
@using Telerik.DataSource
@using System.Globalization
@inject NavigationManager Navigation

<PageTitle>Invoice Review — @TaskId</PageTitle>

<div class="irt-root">

    @* ── Back link ──────────────────────────────────────────────────── *@
    <a href="/property-details?tab=Tasks" class="irt-back">← Back to Tasks</a>

    @* ── Header ─────────────────────────────────────────────────────── *@
    <div class="irt-header">
        <div class="irt-header__left">
            <h1 class="irt-header__title">Review vendor submitted invoice</h1>
            <span class="irt-header__meta">Last updated 9/11/2025 2:32 PM</span>
        </div>
        <div class="irt-header__actions">
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           OnClick="@(() => Navigation.NavigateTo("/property-details?tab=Tasks"))">
                Exit Task
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base">
                Save
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Solid"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Success">
                Complete Task
            </TelerikButton>
        </div>
    </div>

    @* ── Task data card ──────────────────────────────────────────────── *@
    <TaskDetailCard Status="In Progress"
                    StatusVariant="@StatusBadgeVariant.Active"
                    OrderNumber="ORD-882741"
                    FullAddress="1321 Posner Blvd, Davenport, FL 33837"
                    TaskTypeName="Invoice Review"
                    LoanNumber="935720463"
                    InvoiceDate="9/11/2025"
                    DueDate="9/17/2025"
                    InvoiceNumber="INV-29481"
                    TimeElapsed="1d 6h"
                    Assignee="Kristyn G"
                    Vendor="GreenScape LLC" />

    @* ── Submission guidance card ────────────────────────────────────── *@
    @* Cards parameter is omitted — TaskSubmissionGuidanceCard renders its built-in default content.
       TODO: pass Cards="@_guidanceCards" when API-backed guidance data is available. *@
    <TaskSubmissionGuidanceCard />

    @* ── Supporting documents card ───────────────────────────────────── *@
    @* Files parameter is omitted → renders empty state.
       TODO: pass Files="@_attachedFiles" and OnSelectFiles="@HandleSelectFiles" when file service is wired. *@
    <TaskSupportingDocumentsCard />

    @* ── Invoice line items grid ─────────────────────────────────────── *@
    <TelerikCard Class="irt-card" ThemeColor="@ThemeConstants.Card.ThemeColor.Light">
        <CardHeader Class="irt-card-hdr">
            <CardTitle>Invoice Line Items</CardTitle>
        </CardHeader>
        <CardBody Class="irt-grid-body">
            @{
                var us = CultureInfo.GetCultureInfo("en-US");

                // ── Display templates ─────────────────────────────────────────────
                var colTpl = new Dictionary<string, RenderFragment<IrtLineItem>>
                {
                    // Work Item — WO reference cost as currency
                    [nameof(IrtLineItem.WoUnitCost)] = r =>
                        @<text>@(r.WoUnitCost.HasValue ? r.WoUnitCost.Value.ToString("C2", us) : "—")</text>,

                    // Qty — orange when vendor Qty ≠ original WO Qty
                    [nameof(IrtLineItem.Qty)] = r =>
                        @<span class="@(r.HasQtyMismatch ? "irt-qty-mismatch" : null)">@r.Qty.ToString("0.##")</span>,

                    // Unit costs — "—" when not set
                    [nameof(IrtLineItem.VendorUnitCost)] = r =>
                        @<text>@(r.VendorUnitCost.HasValue ? r.VendorUnitCost.Value.ToString("C2", us) : "—")</text>,
                    [nameof(IrtLineItem.ClientUnitCost)] = r =>
                        @<text>@(r.ClientUnitCost.HasValue ? r.ClientUnitCost.Value.ToString("C2", us) : "—")</text>,

                    // Auto-calculated totals
                    [nameof(IrtLineItem.VendorFeeTotal)] = r =>
                        @<text>@r.VendorFeeTotal.ToString("C2", us)</text>,
                    [nameof(IrtLineItem.ClientFeeTotal)] = r =>
                        @<text>@r.ClientFeeTotal.ToString("C2", us)</text>,

                    // Variance — "—" when WoUnitCost is null (no pricing rule)
                    [nameof(IrtLineItem.VendorVariance)] = r =>
                        @<span class="@VarCss(r.VendorVariance)">@(r.VendorVariance.HasValue ? r.VendorVariance.Value.ToString("C2", us) : "—")</span>,
                    [nameof(IrtLineItem.ClientVariance)] = r =>
                        @<span class="@VarCss(r.ClientVariance)">@(r.ClientVariance.HasValue ? r.ClientVariance.Value.ToString("C2", us) : "—")</span>,

                    // Status pills — existing CSS reused; Editable=false prevents inline editing
                    [nameof(IrtLineItem.BusinessStatus)] = r =>
                        @<span class="@StatusCss(r.BusinessStatus)">@StatusLabel(r.BusinessStatus)</span>,
                    [nameof(IrtLineItem.ClientStatus)] = r =>
                        @<span class="@StatusCss(r.ClientStatus)">@StatusLabel(r.ClientStatus)</span>,
                    [nameof(IrtLineItem.InvestorStatus)] = r =>
                        @<span class="@StatusCss(r.InvestorStatus)">@StatusLabel(r.InvestorStatus)</span>,
                };

                // ── Edit templates ────────────────────────────────────────────────
                // Each ValueChanged calls StateHasChanged() so computed totals and variance
                // update live while the row is open for editing.
                var editTpl = new Dictionary<string, RenderFragment<IrtLineItem>>
                {
                    [nameof(IrtLineItem.Qty)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@item.Qty"
                            ValueChanged="@((decimal v) => OnQtyChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,

                    [nameof(IrtLineItem.VendorUnitCost)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@(item.VendorUnitCost ?? 0m)"
                            ValueChanged="@((decimal v) => OnVendorUnitCostChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,

                    [nameof(IrtLineItem.ClientUnitCost)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@(item.ClientUnitCost ?? 0m)"
                            ValueChanged="@((decimal v) => OnClientUnitCostChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,
                };
            }

            <SingleSourceGrid TItem="IrtLineItem"
                               Data="@_lines"
                               InitialGroupDescriptors="@_woDescriptors"
                               Context="@SsgGridContext.Task"
                               HideGroupingBar="true"
                               Height="540px"
                               AllowEdit="true"
                               AllowSelect="true"
                               SaveButtonLabel="Save Changes"
                               ColumnTemplates="@colTpl"
                               EditTemplates="@editTpl"
                               OnSaveClicked="@HandleSaveClicked">
                <SelectionCommands Context="selected">
                    @if (selected.Any())
                    {
                        <span style="font-size: 0.8125rem; color: #6B7280; align-self: center;">
                            @selected.Count() row(s) selected
                        </span>
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       OnClick="@(() => OpenBulkEditDialog(selected.ToList()))">
                            Bulk Edit
                        </TelerikButton>
                    }
                </SelectionCommands>
            </SingleSourceGrid>
        </CardBody>
    </TelerikCard>

    @* ── Bulk edit dialog ─────────────────────────────────────────────────── *@
    <TelerikWindow @bind-Visible="@_bulkDialogVisible"
                   Modal="true"
                   Width="380px"
                   Draggable="false"
                   Resizable="false"
                   FooterLayoutAlign="WindowFooterLayoutAlign.End">
        <WindowTitle>Bulk Edit — @_bulkTargets.Count row(s)</WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@(() => _bulkDialogVisible = false)" />
        </WindowActions>
        <WindowContent>
            <p style="margin: 0 0 14px; font-size: 0.8125rem; color: #6B7280;">
                Leave a field blank to keep existing values unchanged.
            </p>
            <div style="display: flex; flex-direction: column; gap: 14px;">
                <div>
                    <label style="display: block; font-size: 0.8125rem; margin-bottom: 4px; color: #374151;">Qty</label>
                    <TelerikNumericTextBox T="decimal?"
                                          @bind-Value="@_bulkQty"
                                          Min="0" Decimals="2" Width="100%" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.8125rem; margin-bottom: 4px; color: #374151;">Vendor Unit Cost</label>
                    <TelerikNumericTextBox T="decimal?"
                                          @bind-Value="@_bulkVendorUnitCost"
                                          Min="0" Decimals="2" Width="100%" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.8125rem; margin-bottom: 4px; color: #374151;">Client Unit Cost</label>
                    <TelerikNumericTextBox T="decimal?"
                                          @bind-Value="@_bulkClientUnitCost"
                                          Min="0" Decimals="2" Width="100%" />
                </div>
            </div>
        </WindowContent>
        <WindowFooter>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           OnClick="@(() => _bulkDialogVisible = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="@ApplyBulkEdit">Apply</TelerikButton>
        </WindowFooter>
    </TelerikWindow>

</div>

@code {
    [Parameter] public string? TaskId { get; set; }

    // ── Grouping ──────────────────────────────────────────────────────────────────

    private static readonly IEnumerable<GroupDescriptor> _woDescriptors =
    [
        new GroupDescriptor { Member = nameof(IrtLineItem.WorkOrder), MemberType = typeof(string) }
    ];

    // ── Inline-edit handlers — trigger StateHasChanged for live calculated fields ──

    private void OnQtyChanged(IrtLineItem item, decimal v)
    {
        item.Qty = v;
        StateHasChanged();
    }

    private void OnVendorUnitCostChanged(IrtLineItem item, decimal v)
    {
        item.VendorUnitCost = v;
        StateHasChanged();
    }

    private void OnClientUnitCostChanged(IrtLineItem item, decimal v)
    {
        item.ClientUnitCost = v;
        StateHasChanged();
    }

    // ── Save handler ──────────────────────────────────────────────────────────────
    // TODO: Persist changes via API when invoice data layer is wired.
    // changes.EditedItems contains every row that was modified.
    private Task HandleSaveClicked(SingleSourceGridChangeSet<IrtLineItem> changes)
        => Task.CompletedTask;

    // ── Bulk edit state ───────────────────────────────────────────────────────────

    private bool _bulkDialogVisible;
    private List<IrtLineItem> _bulkTargets = [];
    private decimal? _bulkQty;
    private decimal? _bulkVendorUnitCost;
    private decimal? _bulkClientUnitCost;

    private void OpenBulkEditDialog(List<IrtLineItem> targets)
    {
        _bulkTargets = targets;
        _bulkQty = null;
        _bulkVendorUnitCost = null;
        _bulkClientUnitCost = null;
        _bulkDialogVisible = true;
    }

    private void ApplyBulkEdit()
    {
        foreach (var item in _bulkTargets)
        {
            if (_bulkQty.HasValue)             item.Qty = _bulkQty.Value;
            if (_bulkVendorUnitCost.HasValue)   item.VendorUnitCost = _bulkVendorUnitCost.Value;
            if (_bulkClientUnitCost.HasValue)   item.ClientUnitCost = _bulkClientUnitCost.Value;
        }
        _bulkDialogVisible = false;
        StateHasChanged();
    }

    // ── Display helpers ───────────────────────────────────────────────────────────

    private static string StatusCss(string? s) => s?.ToLower() switch
    {
        "approved"                   => "irt-status irt-status--approved",
        "corrections needed"         => "irt-status irt-status--warn",
        "needs approval"             => "irt-status irt-status--warn",
        "needs client approval"      => "irt-status irt-status--warn",
        "needs investor approval"    => "irt-status irt-status--warn",
        "not required"               => "irt-status irt-status--neutral",
        "not submitted"              => "irt-status irt-status--neutral",
        "pending review"             => "irt-status irt-status--info",
        "awaiting approval"          => "irt-status irt-status--info",
        "submitted"                  => "irt-status irt-status--info",
        _                            => "irt-status irt-status--empty"
    };

    private static string StatusLabel(string? s) =>
        string.IsNullOrWhiteSpace(s) ? "Set status" : s;

    private static string VarCss(decimal? v) => v switch
    {
        > 0 => "irt-var-over",
        < 0 => "irt-var-under",
        _   => ""
    };

    // ── Placeholder data — replace with API call once the invoice data layer is wired ─────
    // WO-4634 LI-003: Qty mismatch (vendor submitted 1, WO expected 2 → orange highlight).
    // WO-4635 LI-002: no pricing rule (WoUnitCost null → variance displays "—").

    private static readonly List<IrtLineItem> _lines =
    [
        // ── WO-4634: Lawn maintenance — LI-003 has Qty mismatch ───────────────
        new() { WorkOrder = "WO-4634", LineItem = "LI-001", Description = "Lawn Mowing",
                WoUnit = "EA", WoUnitCost = 60m,  OriginalQty = 4,
                Qty = 4,  Unit = "EA", VendorUnitCost = 60m,  ClientUnitCost = 75m,
                BusinessStatus = "Approved",       ClientStatus = "Not Required",  InvestorStatus = "Not Required" },

        new() { WorkOrder = "WO-4634", LineItem = "LI-002", Description = "Hedge Trimming",
                WoUnit = "EA", WoUnitCost = 45m,  OriginalQty = 2,
                Qty = 2,  Unit = "EA", VendorUnitCost = 45m,  ClientUnitCost = 55m,
                BusinessStatus = "Approved",       ClientStatus = "Not Required",  InvestorStatus = "Not Required" },

        new() { WorkOrder = "WO-4634", LineItem = "LI-003", Description = "Debris Removal",
                WoUnit = "LS", WoUnitCost = 85m,  OriginalQty = 2,  // WO qty = 2
                Qty = 1,  Unit = "LS", VendorUnitCost = 95m,  ClientUnitCost = 100m,  // vendor submitted 1 → mismatch
                BusinessStatus = "Needs Approval", ClientStatus = "Needs Client Approval", InvestorStatus = "Not Required" },

        // ── WO-4635: Tree work — LI-001 over-invoiced; LI-002 no pricing rule ──
        new() { WorkOrder = "WO-4635", LineItem = "LI-001", Description = "Tree Trimming",
                WoUnit = "EA", WoUnitCost = 300m, OriginalQty = 1,
                Qty = 1,  Unit = "EA", VendorUnitCost = 350m, ClientUnitCost = 380m,
                BusinessStatus = "Needs Approval", ClientStatus = null,            InvestorStatus = "Needs Investor Approval" },

        new() { WorkOrder = "WO-4635", LineItem = "LI-002", Description = "Stump Grinding",
                WoUnit = "EA", WoUnitCost = null, OriginalQty = 3,  // no pricing rule → variance = "—"
                Qty = 3,  Unit = "EA", VendorUnitCost = 140m, ClientUnitCost = 160m,
                BusinessStatus = null,             ClientStatus = null,            InvestorStatus = null },

        new() { WorkOrder = "WO-4635", LineItem = "LI-003", Description = "Fertilization",
                WoUnit = "LS", WoUnitCost = 75m,  OriginalQty = 1,
                Qty = 1,  Unit = "LS", VendorUnitCost = 75m,  ClientUnitCost = 80m,
                BusinessStatus = "Approved",       ClientStatus = "Not Required",  InvestorStatus = "Not Required" },
    ];

    // ── Line item model ───────────────────────────────────────────────────────────────────
    // SingleSourceGridGroup attributes drive the collapsible column header groups via reflection.
    // Computed properties (VendorFeeTotal, ClientFeeTotal, VendorVariance, ClientVariance)
    // update live because the EditTemplates call StateHasChanged() on each field change.
    // HasQtyMismatch drives the orange Qty highlight in the ColumnTemplate.

    [SingleSourceGridGroup(DisplayName = "Work Item",            Key = "WI",  Order = 1, Collapsible = true, HeaderClass = "irt-gh--wi")]
    [SingleSourceGridGroup(DisplayName = "Work Item Financials", Key = "WIF", Order = 2, Collapsible = true, HeaderClass = "irt-gh--wif")]
    [SingleSourceGridGroup(DisplayName = "Variance",             Key = "Var", Order = 3, Collapsible = true, HeaderClass = "irt-gh--var")]
    [SingleSourceGridGroup(DisplayName = "Status",               Key = "Dec", Order = 4, Collapsible = true, HeaderClass = "irt-gh--dec")]
    private sealed class IrtLineItem
    {
        // Hidden: Telerik InitialGroupDescriptors grouping key only — not rendered as a column
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public string WorkOrder { get; set; } = "";

        // ── Work Item group ──────────────────────────────────────────────────────
        // Line Item: first anchor column — always visible.
        // Description: identity column — stays visible when group is collapsed.
        // WO Unit / WO Unit Cost: expanded-only detail; hidden when group is collapsed.
        [SingleSourceGridAttribute(DisplayName = "Line Item",    Width = "110px", GroupKey = "WI", Order = 1, Groupable = false, Filterable = false, Editable = false)]
        public string LineItem { get; set; } = "";

        [SingleSourceGridAttribute(DisplayName = "Description",  Width = "195px", GroupKey = "WI", Order = 2, Editable = false, VisibleWhenCollapsed = true)]
        public string Description { get; set; } = "";

        // WO reference values — hidden when collapsed; revealed when Work Item is expanded
        [SingleSourceGridAttribute(DisplayName = "WO Unit",      Width = "80px",  GroupKey = "WI", Order = 3, Groupable = false, Sortable = false, Filterable = false, Editable = false)]
        public string WoUnit { get; set; } = "";

        [SingleSourceGridAttribute(DisplayName = "WO Unit Cost", Width = "105px", GroupKey = "WI", Order = 4, Groupable = false, Sortable = false, Filterable = false, Editable = false)]
        public decimal? WoUnitCost { get; set; }

        // ── Work Item Financials group ──────────────────────────────────────────
        // Qty: first anchor column — always visible.
        // Unit + fee totals: summary columns — stay visible when group is collapsed.
        // Vendor Unit Cost / Client Unit Cost: expanded-only detail; hidden when collapsed.
        [SingleSourceGridAttribute(DisplayName = "Qty",              Width = "80px",  GroupKey = "WIF", Order = 1, Groupable = false, Sortable = false, Filterable = false, Editable = true)]
        public decimal Qty { get; set; }

        // Hidden: WO original quantity used only for HasQtyMismatch — not rendered as a column
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public decimal? OriginalQty { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Unit",             Width = "70px",  GroupKey = "WIF", Order = 2, Groupable = false, Sortable = false, Filterable = false, Editable = false, VisibleWhenCollapsed = true)]
        public string Unit { get; set; } = "";

        // Vendor Unit Cost — expanded-only; hidden when group is collapsed
        [SingleSourceGridAttribute(DisplayName = "Vendor Cost", Width = "130px", GroupKey = "WIF", Order = 3, Groupable = false, Sortable = false, Filterable = false, Editable = true)]
        public decimal? VendorUnitCost { get; set; }

        // Vendor Fee Total = Qty × Vendor Unit Cost — calculated; stays visible when collapsed
        [SingleSourceGridAttribute(DisplayName = "Vendor Fee Total", Width = "120px", GroupKey = "WIF", Order = 4, Groupable = false, Sortable = false, Filterable = false, Editable = false, VisibleWhenCollapsed = true, IsCalculated = true)]
        public decimal VendorFeeTotal => Qty * (VendorUnitCost ?? 0m);

        // Client Unit Cost — expanded-only; hidden when group is collapsed
        [SingleSourceGridAttribute(DisplayName = "Client Cost", Width = "130px", GroupKey = "WIF", Order = 5, Groupable = false, Sortable = false, Filterable = false, Editable = true)]
        public decimal? ClientUnitCost { get; set; }

        // Client Fee Total = Qty × Client Unit Cost — calculated; stays visible when collapsed
        [SingleSourceGridAttribute(DisplayName = "Client Fee Total", Width = "120px", GroupKey = "WIF", Order = 6, Groupable = false, Sortable = false, Filterable = false, Editable = false, VisibleWhenCollapsed = true, IsCalculated = true)]
        public decimal ClientFeeTotal => Qty * (ClientUnitCost ?? 0m);

        // ── Variance group ──────────────────────────────────────────────────────
        // Null when WoUnitCost is not set (no pricing rule) — displayed as "—" via ColumnTemplate.
        // Both columns are calculated; variance colours applied via ColumnTemplate + CSS.
        [SingleSourceGridAttribute(DisplayName = "Vendor Var. $", Width = "120px", GroupKey = "Var", Order = 1, Groupable = false, Sortable = false, Filterable = false, Editable = false, IsCalculated = true)]
        public decimal? VendorVariance =>
            VendorUnitCost.HasValue && WoUnitCost.HasValue
                ? Qty * (VendorUnitCost.Value - WoUnitCost.Value)
                : null;

        [SingleSourceGridAttribute(DisplayName = "Client Var. $", Width = "120px", GroupKey = "Var", Order = 2, Groupable = false, Sortable = false, Filterable = false, Editable = false, IsCalculated = true)]
        public decimal? ClientVariance =>
            ClientUnitCost.HasValue && WoUnitCost.HasValue
                ? Qty * (ClientUnitCost.Value - WoUnitCost.Value)
                : null;

        // ── Status group — hardcoded pills; Editable=false blocks inline editing ───
        // All three status columns stay visible when the group is collapsed so that no
        // approval state is ever hidden from the reviewer's view.
        [SingleSourceGridAttribute(DisplayName = "Business", Width = "155px", GroupKey = "Dec", Order = 1, Groupable = false, Sortable = false, Editable = false)]
        public string? BusinessStatus { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Client",   Width = "155px", GroupKey = "Dec", Order = 2, Groupable = false, Sortable = false, Editable = false, VisibleWhenCollapsed = true)]
        public string? ClientStatus { get; set; }

        [SingleSourceGridAttribute(DisplayName = "Investor", Width = "155px", GroupKey = "Dec", Order = 3, Groupable = false, Sortable = false, Editable = false, VisibleWhenCollapsed = true)]
        public string? InvestorStatus { get; set; }

        // Internal flag — not a column. Drives the orange Qty highlight in the ColumnTemplate.
        [SingleSourceGridAttribute(AutoGenerate = false)]
        public bool HasQtyMismatch => OriginalQty.HasValue && Qty != OriginalQty.Value;
    }
}

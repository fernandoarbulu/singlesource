@page "/invoice-review-task/{taskId}"
@layout PropertyShellLayout
@using BlazorBusiness.Web.Components.SingleSourceGrid
@using BlazorBusiness.Web.Components.Tasks.Cards
@using System.Globalization
@implements IDisposable
@inject NavigationManager Navigation

<PageTitle>Invoice Review — @TaskId</PageTitle>

<div class="irt-root">

    @* ── Success toast ───────────────────────────────────────────────── *@
    @if (_successToastVisible)
    {
        <div class="irt-toast" role="status" aria-live="polite">@_toastMessage</div>
    }

    @* ── Unsaved-changes staging indicator ───────────────────────────── *@
    @if (_hasStagedChanges)
    {
        <div class="irt-staging-bar" role="status">
            <span class="irt-staging-bar__dot" aria-hidden="true"></span>
            <span class="irt-staging-bar__msg">Unsaved changes — not yet committed globally.</span>
            <span class="irt-staging-bar__spacer"></span>
            <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           OnClick="@DiscardStagedChanges">Discard</TelerikButton>
            <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="@SaveStagedChanges">Save Draft</TelerikButton>
        </div>
    }

    @* ── Back link — button so we can intercept when edits are pending ── *@
    <button class="irt-back" @onclick="HandleBackClick">← Back to Tasks</button>

    @* ── Header ─────────────────────────────────────────────────────── *@
    <div class="irt-header">
        <div class="irt-header__left">
            <h1 class="irt-header__title">Review vendor submitted invoice</h1>
            <span class="irt-header__meta">
                Last updated 9/11/2025 2:32 PM
                @if (_taskSaved)
                {
                    <span class="irt-header__saved-chip">Draft saved</span>
                }
            </span>
            @if (_orphanRows.Count > 0)
            {
                <div class="irt-workflow-status">
                    <span class="irt-workflow-status__icon" aria-hidden="true">⚠</span>
                    <div class="irt-workflow-status__body">
                        <span class="irt-workflow-status__title">@_orphanRows.Count Financial Exception@(_orphanRows.Count == 1 ? "" : "s")</span>
                        <span class="irt-workflow-status__sub">Business approval blocked until all exceptions are resolved</span>
                    </div>
                </div>
            }
        </div>
        <div class="irt-header__actions">
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           OnClick="@HandleExitTask">
                Exit Task
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           Enabled="@_hasStagedChanges"
                           OnClick="@SaveStagedChanges">
                Save Draft
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           OnClick="@(() => _sendBackVisible = true)">
                Send Back
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Solid"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Success"
                           OnClick="@HandleCompleteTask">
                Complete Task
            </TelerikButton>
        </div>
    </div>

    @* ── Task data card ──────────────────────────────────────────────── *@
    <TaskDetailCard Status="In Progress"
                    StatusVariant="@StatusBadgeVariant.Active"
                    OrderNumber="ORD-882741"
                    FullAddress="1321 Posner Blvd, Davenport, FL 33837"
                    TaskTypeName="Invoice Review"
                    LoanNumber="935720463"
                    InvoiceDate="9/11/2025"
                    DueDate="9/17/2025"
                    InvoiceNumber="INV-29481"
                    TimeElapsed="1d 6h"
                    Assignee="Kristyn G"
                    Vendor="GreenScape LLC" />

    @* ── Submission guidance card ────────────────────────────────────── *@
    @* Cards parameter is omitted — TaskSubmissionGuidanceCard renders its built-in default content.
       TODO: pass Cards="@_guidanceCards" when API-backed guidance data is available. *@
    <TaskSubmissionGuidanceCard />

    @* ── Supporting documents card ───────────────────────────────────── *@
    @* Files parameter is omitted → renders empty state.
       TODO: pass Files="@_attachedFiles" and OnSelectFiles="@HandleSelectFiles" when file service is wired. *@
    <TaskSupportingDocumentsCard />

    @* ── Summary cards ───────────────────────────────────────────────────── *@
    <div class="irt-summary-cards">
        <div class="irt-summary-card">
            <span class="irt-summary-card__label">Prescribed Total</span>
            <span class="irt-summary-card__value irt-num">@TotalPrescribed.ToString("C2", _us)</span>
            <span class="irt-summary-card__sub">WO AP work item totals</span>
        </div>
        <div class="irt-summary-card">
            <span class="irt-summary-card__label">Submitted Total</span>
            <span class="irt-summary-card__value irt-num">@TotalVendorFeeTotal.ToString("C2", _us)</span>
            <span class="irt-summary-card__sub">Vendor submitted</span>
        </div>
        <div class="irt-summary-card @(TotalVendorVariance > 0 ? "irt-summary-card--alert" : "")">
            <span class="irt-summary-card__label">Variance</span>
            <span class="irt-summary-card__value irt-num irt-var-cell @VarCss(TotalVendorVariance == 0m ? (decimal?)null : TotalVendorVariance)">@VarFormatted(TotalVendorVariance == 0m ? (decimal?)null : (decimal?)TotalVendorVariance)</span>
            <span class="irt-summary-card__sub">vs. work item totals</span>
        </div>
        <div class="irt-summary-card @(RequiresReviewCount > 0 ? "irt-summary-card--warning" : "")">
            <span class="irt-summary-card__label">Requires Review</span>
            <span class="irt-summary-card__value">@RequiresReviewCount</span>
            <span class="irt-summary-card__sub">rows without Business status</span>
        </div>
    </div>

    @* ── STEP 1 card — Review Financial Exceptions ───────────────────── *@
    <TelerikCard Class="irt-exceptions-card" ThemeColor="@ThemeConstants.Card.ThemeColor.Light">
        <CardBody Class="irt-grid-body">

            @* ── STEP 1 — Review Financial Exceptions ─────────────────────── *@
            <div class="irt-needs-review @(_orphanRows.Count == 0 ? "irt-needs-review--resolved" : "")">
                <div class="irt-needs-review-hdr" @onclick="@(() => _orphansCollapsed = !_orphansCollapsed)">
                    <span class="irt-step-badge @(_orphanRows.Count == 0 ? "irt-step-badge--done" : "")">1</span>
                    <div class="irt-needs-review-titles">
                        <span class="irt-needs-review-title">
                            Review Financial Exceptions
                            @if (_orphanRows.Count > 0)
                            {
                                <span class="irt-needs-review-badge">@_orphanRows.Count unresolved</span>
                            }
                            else
                            {
                                <span class="irt-needs-review-badge irt-needs-review-badge--clear">✓ All clear</span>
                            }
                        </span>
                        @if (_orphanRows.Count > 0)
                        {
                            <span class="irt-needs-review-subtitle">
                                Business approval is unavailable until all @_orphanRows.Count exception@(_orphanRows.Count == 1 ? "" : "s") @(_orphanRows.Count == 1 ? "is" : "are") resolved.
                                <span class="irt-needs-review-blocking">Blocks completion.</span>
                            </span>
                            <div class="irt-exception-breakdown">
                                @if (_orphanRows.Count(r => r.OrphanTypeCss == "unmatched") is int u && u > 0)
                                {
                                    <span class="irt-exc-item">
                                        <svg class="irt-exc-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M5.5 8.5a3 3 0 0 0 4.24 0l1.3-1.3a3 3 0 0 0-4.24-4.24l-.74.74"/>
                                            <path d="M8.5 5.5a3 3 0 0 0-4.24 0L2.96 6.8a3 3 0 0 0 4.24 4.24l.74-.74"/>
                                        </svg>
                                        @u unmatched invoice@(u == 1 ? "" : "s")
                                    </span>
                                }
                                @if (_orphanRows.Count(r => r.OrphanTypeCss == "external") is int e && e > 0)
                                {
                                    <span class="irt-exc-item">
                                        <svg class="irt-exc-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="2" y="1.5" width="10" height="11" rx="1"/>
                                            <line x1="4.5" y1="4.5" x2="9.5" y2="4.5"/>
                                            <line x1="4.5" y1="7" x2="9.5" y2="7"/>
                                            <line x1="4.5" y1="9.5" x2="7" y2="9.5"/>
                                        </svg>
                                        @e external item@(e == 1 ? "" : "s") without work item
                                    </span>
                                }
                                @if (_orphanRows.Count(r => r.OrphanTypeCss == "missing") is int m && m > 0)
                                {
                                    <span class="irt-exc-item">
                                        <svg class="irt-exc-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M8 1H3.5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V5L8 1z"/>
                                            <path d="M8 1v4h3.5"/>
                                            <line x1="4.5" y1="7.5" x2="9.5" y2="7.5"/>
                                            <line x1="4.5" y1="9.5" x2="7.5" y2="9.5"/>
                                        </svg>
                                        @m missing invoice@(m == 1 ? "" : "s")
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="irt-needs-review-subtitle">
                                All items resolved — business approval is not blocked by this section.
                            </span>
                        }
                    </div>
                    <span class="irt-needs-review-hdr-spacer"></span>
                    <span class="irt-needs-review-collapse" aria-hidden="true">@(_orphansCollapsed ? "▶" : "▼")</span>
                </div>

                @if (!_orphansCollapsed)
                {
                    @if (_orphanRows.Count == 0)
                    {
                        @* ── Resolved state ───────────────────────────────────────── *@
                        <div class="irt-needs-review-resolved-body">
                            <span class="irt-resolved-check" aria-hidden="true">✓</span>
                            <div>
                                <p class="irt-resolved-title">All financial exceptions resolved</p>
                                <p class="irt-resolved-sub">All invoice items have been matched and are ready for approval.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Single TelerikTooltip renders at body level — bypasses grid cell overflow clipping *@
                        <TelerikTooltip TargetSelector=".irt-action-tip" />

                        <TelerikGrid Data="@_orphanRows"
                                     Pageable="false"
                                     Sortable="false"
                                     ShowColumnMenu="false"
                                     Class="irt-orphan-grid">
                            <GridColumns>
                                <GridColumn Title="Exception Type" Width="154px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        <div class="irt-orphan-type-cell">
                                            @* Per-type inline icon *@
                                            @if (or.OrphanTypeCss == "unmatched")
                                            {
                                                <svg class="irt-type-icon irt-type-icon--unmatched" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M5.5 8.5a3 3 0 0 0 4.24 0l1.3-1.3a3 3 0 0 0-4.24-4.24l-.74.74"/>
                                                    <path d="M8.5 5.5a3 3 0 0 0-4.24 0L2.96 6.8a3 3 0 0 0 4.24 4.24l.74-.74"/>
                                                </svg>
                                            }
                                            else if (or.OrphanTypeCss == "external")
                                            {
                                                <svg class="irt-type-icon irt-type-icon--external" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="2" y="1.5" width="10" height="11" rx="1"/>
                                                    <line x1="4.5" y1="4.5" x2="9.5" y2="4.5"/>
                                                    <line x1="4.5" y1="7" x2="9.5" y2="7"/>
                                                    <line x1="4.5" y1="9.5" x2="7" y2="9.5"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="irt-type-icon irt-type-icon--missing" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M8 1H3.5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V5L8 1z"/>
                                                    <path d="M8 1v4h3.5"/>
                                                    <line x1="5" y1="8" x2="9" y2="8"/>
                                                    <line x1="5" y1="10" x2="7" y2="10"/>
                                                </svg>
                                            }
                                            <span class="irt-orphan-type irt-orphan-type--@or.OrphanTypeCss">@or.OrphanType</span>
                                        </div>
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Work Item" Width="100px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        <span class="irt-orphan-ref">@or.WorkItemRef</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Description">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        <span class="irt-orphan-desc">@or.VendorDescription</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Qty" Width="52px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        <span class="irt-num">@or.Qty.ToString("0.##")</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Unit" Width="50px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        <span>@or.Unit</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Vendor AP" Width="94px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        @if (or.ApAmount.HasValue)
                                        {
                                            <span class="irt-num">@or.ApAmount.Value.ToString("C2", _us)</span>
                                        }
                                        else
                                        {
                                            <span class="irt-orphan-placeholder">—</span>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Customer AR" Width="102px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        @if (or.ArAmount.HasValue && or.ArAmount.Value > 0)
                                        {
                                            <span class="irt-num">@or.ArAmount.Value.ToString("C2", _us)</span>
                                        }
                                        else
                                        {
                                            <span class="irt-orphan-placeholder">—</span>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Variance" Width="104px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        @if (or.Variance.HasValue)
                                        {
                                            <span class="irt-num irt-var-cell irt-var-over" title="Full amount is unplanned">@VarFormatted(or.Variance)</span>
                                        }
                                        else
                                        {
                                            <span class="irt-orphan-placeholder">—</span>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Status" Width="130px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        <span class="@OrphanStatusCss(or) irt-pill-sm">@or.OrphanStatus</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Title="Actions" Width="112px">
                                    <Template Context="row">
                                        @{ var or = (IrtOrphanRow)row; }
                                        <div class="irt-icon-actions">
                                            @* Primary action — context-dependent *@
                                            @if (or.OrphanTypeCss == "unmatched")
                                            {
                                                <button class="irt-icon-btn irt-icon-btn--primary irt-action-tip"
                                                        title="Match to Work Item"
                                                        aria-label="Match to Work Item"
                                                        @onclick="@(() => OpenResolveMapping(or.SourceLine!))">
                                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M6.5 9.5a3.5 3.5 0 0 0 4.95 0l1.5-1.5a3.5 3.5 0 0 0-4.95-4.95l-.86.86"/>
                                                        <path d="M9.5 6.5a3.5 3.5 0 0 0-4.95 0L3.05 8a3.5 3.5 0 0 0 4.95 4.95l.86-.86"/>
                                                    </svg>
                                                </button>
                                                <button class="irt-icon-btn irt-action-tip"
                                                        title="Create Work Item"
                                                        aria-label="Create Work Item"
                                                        @onclick="@(() => CreateWorkItemForOrphan(or))">
                                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="2.5" y="2" width="11" height="12" rx="1.5"/>
                                                        <line x1="8" y1="5.5" x2="8" y2="10.5"/>
                                                        <line x1="5.5" y1="8" x2="10.5" y2="8"/>
                                                    </svg>
                                                </button>
                                            }
                                            else if (or.OrphanTypeCss == "missing")
                                            {
                                                <button class="irt-icon-btn irt-icon-btn--primary irt-action-tip"
                                                        title="Match Invoice"
                                                        aria-label="Match Invoice"
                                                        @onclick="@(() => HandleAddExpense(or.SourceItem!))">
                                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M9 2H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V6L9 2z"/>
                                                        <path d="M9 2v4h4"/>
                                                        <path d="M5.5 9.5l1.5 1.5 3-3"/>
                                                    </svg>
                                                </button>
                                                <button class="irt-icon-btn irt-action-tip"
                                                        title="Mark Not Done"
                                                        aria-label="Mark Not Done"
                                                        @onclick="@(() => MarkOrphanNotDone(or.SourceItem!))">
                                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                                                        <circle cx="8" cy="8" r="5.5"/>
                                                        <line x1="5.5" y1="8" x2="10.5" y2="8"/>
                                                    </svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="irt-icon-btn irt-icon-btn--primary irt-action-tip"
                                                        title="Review &amp; Decide"
                                                        aria-label="Review and Decide"
                                                        @onclick="@(() => OpenStatusModal(or.SourceLine!))">
                                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="4" y="3" width="8" height="10" rx="1"/>
                                                        <path d="M6.5 3V2.5a1.5 1.5 0 0 1 3 0V3"/>
                                                        <line x1="6" y1="7" x2="10" y2="7"/>
                                                        <line x1="6" y1="9.5" x2="9" y2="9.5"/>
                                                    </svg>
                                                </button>
                                                <button class="irt-icon-btn irt-action-tip"
                                                        title="Create Work Item"
                                                        aria-label="Create Work Item"
                                                        @onclick="@(() => CreateWorkItemForOrphan(or))">
                                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="2.5" y="2" width="11" height="12" rx="1.5"/>
                                                        <line x1="8" y1="5.5" x2="8" y2="10.5"/>
                                                        <line x1="5.5" y1="8" x2="10.5" y2="8"/>
                                                    </svg>
                                                </button>
                                            }
                                            <button class="irt-icon-btn irt-action-tip"
                                                    title="Needs Corrections"
                                                    aria-label="Needs Corrections"
                                                    @onclick="@(() => OpenNcOrphan(or))">
                                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M13 2H3a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7l3 2V3a1 1 0 0 0-1-1z"/>
                                                    <line x1="5" y1="6" x2="11" y2="6"/>
                                                    <line x1="5" y1="8.5" x2="8.5" y2="8.5"/>
                                                </svg>
                                            </button>
                                            @if (or.SourceLine is not null)
                                            {
                                                <button class="irt-icon-btn irt-icon-btn--deny irt-action-tip"
                                                        title="Deny"
                                                        aria-label="Deny"
                                                        @onclick="@(() => DenyOrphanItem(or))">
                                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                                                        <circle cx="8" cy="8" r="5.5"/>
                                                        <line x1="10" y1="6" x2="6" y2="10"/>
                                                        <line x1="6" y1="6" x2="10" y2="10"/>
                                                    </svg>
                                                </button>
                                            }
                                        </div>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </TelerikGrid>

                        @* ── Exception exposure totals footer ──────────────────── *@
                        <div class="irt-orphan-totals">
                            <span class="irt-orphan-totals__label">Unresolved Exposure</span>
                            <span class="irt-orphan-totals__spacer"></span>
                            <span class="irt-orphan-totals__item">
                                <span class="irt-orphan-totals__key">Vendor AP</span>
                                <span class="irt-orphan-totals__val irt-num">@OrphanVendorExposure.ToString("C2", _us)</span>
                            </span>
                            <span class="irt-orphan-totals__item">
                                <span class="irt-orphan-totals__key">Customer AR</span>
                                <span class="irt-orphan-totals__val irt-num">@OrphanCustomerExposure.ToString("C2", _us)</span>
                            </span>
                        </div>
                    }
                }
            </div>

        </CardBody>
    </TelerikCard>

    @* ── STEP 2 card — Review Matched Financials ─────────────────────── *@
    <TelerikCard Class="irt-card" ThemeColor="@ThemeConstants.Card.ThemeColor.Light">
        <CardHeader Class="irt-card-hdr">
            <div class="irt-card-hdr-row irt-card-hdr-row--step2">
                <div class="irt-step2-title">
                    <span class="irt-step-badge irt-step-badge--secondary">2</span>
                    <div>
                        <CardTitle>Review Matched Financials</CardTitle>
                        <span class="irt-step2-subtitle">@FilteredMatchedLines.Count() matched rows</span>
                    </div>
                </div>
                <TelerikTextBox @bind-Value="@_searchTerm"
                                PlaceHolder="Search description or line item…"
                                Width="260px" />
            </div>
        </CardHeader>
        <CardBody Class="irt-grid-body">

            @{
                // ── Display templates ─────────────────────────────────────────────
                var colTpl = new Dictionary<string, RenderFragment<IrtLineItem>>
                {
                    // "Work Item" column — work item type name.
                    // Normal: review button. Unmapped: ⚠ badge + resolve action. External: blue-gray badge.
                    [nameof(IrtLineItem.Description)] = r =>
                        @<div class="irt-wi-cell">
                            @if (r.IsUnmapped)
                            {
                                <span class="irt-cell-unmapped-id">
                                    <span class="irt-cell-unmapped-icon" aria-hidden="true">⚠</span>Requires Mapping
                                </span>
                                <button class="irt-cell-resolve-btn"
                                        @onclick="@(() => OpenResolveMapping(r))"
                                        @onclick:stopPropagation>
                                    Resolve
                                </button>
                            }
                            else if (r.IsExternallyCreated)
                            {
                                <span class="irt-cell-external-badge">⬡ Externally Created</span>
                                <span class="irt-cell-external-name">@r.VendorRawDescription</span>
                            }
                            else
                            {
                                <button class="irt-cell-review-btn @LineItemCellClass(r)"
                                        title="Open detailed review"
                                        @onclick="@(() => OpenReviewDrawer(r))">@r.Description</button>
                            }
                        </div>,

                    // (A) Original WO qty — expand-only, read-only
                    [nameof(IrtLineItem.OriginalQty)] = r =>
                        @<span class="irt-num">@(r.OriginalQty.HasValue ? r.OriginalQty.Value.ToString("0.##") : "—")</span>,

                    // (B) WO Unit Cost AP — expand-only
                    [nameof(IrtLineItem.WoUnitCost)] = r =>
                        @<span class="irt-num">@(r.WoUnitCost.HasValue ? r.WoUnitCost.Value.ToString("C2", _us) : "—")</span>,

                    // (C) WO Unit Cost AR — expand-only
                    [nameof(IrtLineItem.WoCustomerUnitCost)] = r =>
                        @<span class="irt-num">@(r.WoCustomerUnitCost.HasValue ? r.WoCustomerUnitCost.Value.ToString("C2", _us) : "—")</span>,

                    // (AB) WO Total AP — expand-only
                    [nameof(IrtLineItem.WoTotalAP)] = r =>
                        @<span class="irt-num">@(r.WoUnitCost.HasValue ? r.WoTotalAP.ToString("C2", _us) : "—")</span>,

                    // (AC) WO Total AR — expand-only
                    [nameof(IrtLineItem.WoTotalAR)] = r =>
                        @<span class="irt-num">@(r.WoCustomerUnitCost.HasValue ? r.WoTotalAR.ToString("C2", _us) : "—")</span>,

                    // (D) Qty — orange when vendor Qty ≠ original WO Qty
                    [nameof(IrtLineItem.Qty)] = r =>
                        @<span class="irt-num @(r.HasQtyMismatch ? "irt-qty-mismatch" : null)">@r.Qty.ToString("0.##")</span>,

                    // Unit — flag if differs from WO unit
                    [nameof(IrtLineItem.Unit)] = r =>
                        @<span class="@(r.HasUomMismatch ? "irt-uom-changed" : null)" title="@(r.HasUomMismatch ? $"WO unit: {r.WoUnit}" : null)">@r.Unit</span>,

                    // (E) Vendor Cost — expand-only, show "—" when null
                    [nameof(IrtLineItem.VendorUnitCost)] = r =>
                        @<span class="irt-num">@(r.VendorUnitCost.HasValue ? r.VendorUnitCost.Value.ToString("C2", _us) : "—")</span>,

                    // (F) Vendor Total — expand-only, italic (read-only auto-calc)
                    [nameof(IrtLineItem.VendorFeeTotal)] = r =>
                        @<span class="irt-num irt-total-italic">@r.VendorFeeTotal.ToString("C2", _us)</span>,

                    // (G) Customer Cost — expand-only
                    [nameof(IrtLineItem.ClientUnitCost)] = r =>
                        @<span class="irt-num">@(r.ClientUnitCost.HasValue ? r.ClientUnitCost.Value.ToString("C2", _us) : "—")</span>,

                    // (H) Customer Total — expand-only, italic
                    [nameof(IrtLineItem.ClientFeeTotal)] = r =>
                        @<span class="irt-num irt-total-italic">@r.ClientFeeTotal.ToString("C2", _us)</span>,

                    // Variance — icon + signed value; "—" when no expense (null)
                    [nameof(IrtLineItem.VendorVariance)] = r =>
                        @<span class="irt-num irt-var-cell @VarCss(r.VendorVariance)" title="@VarDirectionLabel(r.VendorVariance)">@VarFormatted(r.VendorVariance)</span>,
                    [nameof(IrtLineItem.ClientVariance)] = r =>
                        @<span class="irt-num irt-var-cell @VarCss(r.ClientVariance)" title="@VarDirectionLabel(r.ClientVariance)">@VarFormatted(r.ClientVariance)</span>,

                    // Status pills — clickable: opens status-edit modal for this row
                    [nameof(IrtLineItem.BusinessStatus)] = r =>
                        @<span class="@StatusCss(r.BusinessStatus) irt-status-clickable"
                               title="Click to edit status"
                               @onclick="@(() => OpenStatusModal(r))">@StatusLabel(r.BusinessStatus)</span>,
                    [nameof(IrtLineItem.ClientStatus)] = r =>
                        @<span class="@StatusCss(r.ClientStatus) irt-status-clickable"
                               title="Click to edit status"
                               @onclick="@(() => OpenStatusModal(r))">@StatusLabel(r.ClientStatus)</span>,
                    [nameof(IrtLineItem.InvestorStatus)] = r =>
                        @<span class="@StatusCss(r.InvestorStatus) irt-status-clickable"
                               title="Click to edit status"
                               @onclick="@(() => OpenStatusModal(r))">@StatusLabel(r.InvestorStatus)</span>,
                };

                // ── Edit templates ────────────────────────────────────────────────
                // Each ValueChanged calls StateHasChanged() so computed totals and variance
                // update live while the row is open for editing.
                var editTpl = new Dictionary<string, RenderFragment<IrtLineItem>>
                {
                    // Work Item type — dropdown of mapped work item types
                    [nameof(IrtLineItem.Description)] = item =>
                        @<TelerikComboBox Data="@_workItemCatalogKeys"
                            TItem="string"
                            TValue="string"
                            Value="@item.Description"
                            ValueChanged="@((string v) => OnDescriptionChanged(item, v))"
                            Filterable="true"
                            Placeholder="Select work item type…"
                            Width="100%" />,

                    [nameof(IrtLineItem.Qty)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@item.Qty"
                            ValueChanged="@((decimal v) => OnQtyChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,

                    [nameof(IrtLineItem.VendorUnitCost)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@(item.VendorUnitCost ?? 0m)"
                            ValueChanged="@((decimal v) => OnVendorUnitCostChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,

                    [nameof(IrtLineItem.ClientUnitCost)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@(item.ClientUnitCost ?? 0m)"
                            ValueChanged="@((decimal v) => OnClientUnitCostChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,
                };
            }

            <SingleSourceGrid TItem="IrtLineItem"
                               Data="@FilteredMatchedLines"
                               Context="@SsgGridContext.Task"
                               HideGroupingBar="true"
                               ShowColumnMenu="false"
                               AllowEdit="true"
                               AllowSelect="true"
                               SaveButtonLabel="Save Changes"
                               ColumnTemplates="@colTpl"
                               EditTemplates="@editTpl"
                               OnSaveClicked="@HandleSaveClicked">
                <SelectionCommands Context="selected">
                    @if (selected.Any())
                    {
                        <span style="font-size: 0.8125rem; color: #6B7280; align-self: center;">
                            @selected.Count() row(s) selected
                        </span>
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       OnClick="@(() => OpenStatusModalBulk(selected.ToList()))">
                            Edit Status
                        </TelerikButton>
                    }
                </SelectionCommands>
            </SingleSourceGrid>

            @* ── Aggregates bar ── shown below the grid, outside Telerik pagination *@
            <div class="irt-totals-bar">
                <span class="irt-totals-label">Matched Totals</span>
                <span class="irt-totals-count">@FilteredMatchedLines.Count() rows</span>
                <span class="irt-totals-spacer"></span>
                <span class="irt-totals-item">
                    <span class="irt-totals-item__label">Vendor</span>
                    <span class="irt-totals-item__value irt-num">@TotalVendorFeeTotal.ToString("C2", _us)</span>
                </span>
                <span class="irt-totals-item">
                    <span class="irt-totals-item__label">Customer</span>
                    <span class="irt-totals-item__value irt-num">@TotalClientFeeTotal.ToString("C2", _us)</span>
                </span>
                <span class="irt-totals-item">
                    <span class="irt-totals-item__label">Vendor Var.</span>
                    <span class="irt-totals-item__value irt-num irt-var-cell @VarCss(TotalVendorVariance == 0m ? (decimal?)null : TotalVendorVariance)">@VarFormatted((decimal?)TotalVendorVariance)</span>
                </span>
                <span class="irt-totals-item">
                    <span class="irt-totals-item__label">Customer Var.</span>
                    <span class="irt-totals-item__value irt-num irt-var-cell @VarCss(TotalClientVariance == 0m ? (decimal?)null : TotalClientVariance)">@VarFormatted((decimal?)TotalClientVariance)</span>
                </span>
            </div>
        </CardBody>
    </TelerikCard>


    @* ── Status Edit Modal ─────────────────────────────────────────────────── *@
    @* Used for both single-row click (clickable status pills) and bulk selection. *@
    <TelerikWindow @bind-Visible="@_statusModalVisible"
                   Modal="true"
                   Width="380px"
                   Class="irt-sm-window"
                   Draggable="false"
                   Resizable="false"
                   FooterLayoutAlign="WindowFooterLayoutAlign.End">
        <WindowTitle>
            @if (_statusModalIsBulk)
            {
                <span>Bulk Status Edit — @_statusModalTargets.Count item(s)</span>
            }
            else if (_statusModalTargets.Count == 1)
            {
                <span>Edit Status — @_statusModalTargets[0].Description</span>
            }
        </WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@(() => _statusModalVisible = false)" />
        </WindowActions>
        <WindowContent>
            <div class="irt-sm-form">
                @if (_statusModalIsBulk)
                {
                    <p class="irt-sm-hint">Leave a field as "No change" to keep existing values on all selected rows.</p>
                }
                <div class="irt-sm-field">
                    <label class="irt-sm-label">Business Status</label>
                    <TelerikDropDownList Data="@StatusOptsForModal"
                                         TItem="StatusOption"
                                         TValue="string"
                                         TextField="@nameof(StatusOption.Label)"
                                         ValueField="@nameof(StatusOption.Value)"
                                         Value="@_statusDraftBusiness"
                                         ValueChanged="@((string v) => _statusDraftBusiness = v)"
                                         Width="100%" />
                </div>
                <div class="irt-sm-field">
                    <label class="irt-sm-label">Client Status</label>
                    <TelerikDropDownList Data="@StatusOptsForModal"
                                         TItem="StatusOption"
                                         TValue="string"
                                         TextField="@nameof(StatusOption.Label)"
                                         ValueField="@nameof(StatusOption.Value)"
                                         Value="@_statusDraftClient"
                                         ValueChanged="@((string v) => _statusDraftClient = v)"
                                         Width="100%" />
                </div>
                <div class="irt-sm-field">
                    <label class="irt-sm-label">Investor Status</label>
                    <TelerikDropDownList Data="@StatusOptsForModal"
                                         TItem="StatusOption"
                                         TValue="string"
                                         TextField="@nameof(StatusOption.Label)"
                                         ValueField="@nameof(StatusOption.Value)"
                                         Value="@_statusDraftInvestor"
                                         ValueChanged="@((string v) => _statusDraftInvestor = v)"
                                         Width="100%" />
                </div>
                @{
                    var _ncSelected = _statusDraftBusiness == "Needs Corrections";
                    var _ncRequiredMsg = _smAttempted && _ncSelected && string.IsNullOrWhiteSpace(_statusDraftComment)
                        ? "A comment is required when setting Needs Corrections." : null;
                }
                <div class="irt-sm-field">
                    <label class="irt-sm-label">
                        Comment
                        @if (_ncSelected)
                        {
                            <span class="irt-sm-required" aria-label="required">*</span>
                        }
                        else
                        {
                            <span class="irt-sm-optional">(optional)</span>
                        }
                    </label>
                    <textarea class="irt-sm-comment @(_ncSelected ? "irt-sm-comment--required" : null)"
                              @bind="@_statusDraftComment"
                              placeholder="@(_ncSelected ? "Required: describe the corrections needed…" : "Add a note about this status change…")"
                              rows="3"></textarea>
                    @if (_ncRequiredMsg is not null)
                    {
                        <span class="irt-sm-error">@_ncRequiredMsg</span>
                    }
                </div>
            </div>
        </WindowContent>
        <WindowFooter>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           OnClick="@(() => _statusModalVisible = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="@SaveStatusModal">Save Changes</TelerikButton>
        </WindowFooter>
    </TelerikWindow>

    @* ── Exit / navigation guard modal ──────────────────────────────────────── *@
    @* Shown when user tries to exit while _hasStagedChanges is true. *@
    <TelerikWindow @bind-Visible="@_exitGuardVisible"
                   Modal="true"
                   Width="400px"
                   Draggable="false"
                   Resizable="false"
                   FooterLayoutAlign="WindowFooterLayoutAlign.End">
        <WindowTitle>Unsaved Changes</WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@(() => _exitGuardVisible = false)" />
        </WindowActions>
        <WindowContent>
            <div class="irt-guard-body">
                <p class="irt-guard-msg">You have unsaved changes in this task.</p>
                <p class="irt-guard-sub">
                    <strong>Save Draft</strong> — preserves your edits in task staging. Changes will be visible when you reopen this task but are <em>not yet committed globally</em>.
                </p>
                <p class="irt-guard-sub">
                    <strong>Discard</strong> — your in-session edits will be lost.
                </p>
            </div>
        </WindowContent>
        <WindowFooter>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           OnClick="@(() => _exitGuardVisible = false)">Cancel</TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           OnClick="@DiscardAndNavigate">Discard &amp; Exit</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="@SaveDraftAndNavigate">Save Draft &amp; Exit</TelerikButton>
        </WindowFooter>
    </TelerikWindow>

    @* ── Send Back for Corrections modal ─────────────────────────────────────── *@
    @* Reusable pattern: send-back with required reason, confirmation before action. *@
    <TelerikWindow @bind-Visible="@_sendBackVisible"
                   Modal="true"
                   Width="420px"
                   Class="irt-sb-window"
                   Draggable="false"
                   Resizable="false"
                   FooterLayoutAlign="WindowFooterLayoutAlign.End">
        <WindowTitle>Send Back for Corrections</WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@CloseSendBack" />
        </WindowActions>
        <WindowContent>
            <div class="irt-sb-form">
                <p class="irt-sb-intro">
                    This will return the work order to the vendor for corrections. Add a required comment before sending.
                </p>
                <div class="irt-sb-field">
                    <label class="irt-sb-label">
                        Reason / Required Corrections
                        <span class="irt-sb-required" aria-hidden="true">*</span>
                    </label>
                    <textarea class="irt-sb-textarea"
                              @bind="@_sendBackComment"
                              placeholder="Describe the corrections required before resubmission…"
                              rows="4"></textarea>
                    @if (_sendBackAttempted && string.IsNullOrWhiteSpace(_sendBackComment))
                    {
                        <span class="irt-sb-validation">A correction comment is required.</span>
                    }
                </div>
            </div>
        </WindowContent>
        <WindowFooter>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           OnClick="@CloseSendBack">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                           OnClick="@ConfirmSendBack">Confirm Send Back</TelerikButton>
        </WindowFooter>
    </TelerikWindow>

    @* ── Right-side Review Drawer ─────────────────────────────────────────── *@
    @* position:fixed so it overlays the full viewport regardless of scroll offset. *@
    @if (_drawerVisible)
    {
        <div class="irt-drawer-overlay" @onclick="CloseDrawer"></div>
        <div class="irt-drawer">
            @{
                var drawerTitle  = _drawerIsOrphan ? _drawerOrphanItem!.Description : _drawerItem!.Description;
                var drawerSub    = _drawerIsOrphan ? "Work Item — No Expense Linked" : "Vendor Expense Review";
            }

            @* ── Drawer header ───────────────────────────────────────────── *@
            <div class="irt-drawer-hdr">
                <div class="irt-drawer-hdr-left">
                    @if (_drawerIsOrphan && _drawerOrphanItem is not null)
                    {
                        <h2 class="irt-drawer-hdr-title">@_drawerOrphanItem.Description</h2>
                        <span class="irt-drawer-hdr-sub">
                            @_drawerOrphanItem.WorkItem
                            <span class="irt-drawer-hdr-sep" aria-hidden="true">•</span>
                            <span class="@UweStatusCss(_drawerOrphanItem.Status)">@_drawerOrphanItem.Status</span>
                        </span>
                        <div class="irt-drawer-hdr-chips">
                            <span class="irt-drawer-hdr-chip">
                                <span class="irt-drawer-hdr-chip__lbl">WO</span>
                                <span class="irt-drawer-hdr-chip__val">@_drawerOrphanItem.WorkOrderNumber</span>
                            </span>
                            <span class="irt-drawer-hdr-chip">
                                <span class="irt-drawer-hdr-chip__lbl">Vendor</span>
                                <span class="irt-drawer-hdr-chip__val">@_drawerOrphanItem.VendorName</span>
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="irt-drawer-hdr-eyebrow">@drawerSub</span>
                        <h2 class="irt-drawer-hdr-title">@drawerTitle</h2>
                        @if (_drawerItem is not null)
                        {
                            <div class="irt-drawer-hdr-pills">
                                <span class="irt-drawer-hdr-pill-lbl">Business</span>
                                <span class="@StatusCss(_drawerItem.BusinessStatus) irt-status-clickable"
                                      title="Click to edit status"
                                      @onclick="@(() => OpenStatusModal(_drawerItem))">@StatusLabel(_drawerItem.BusinessStatus)</span>
                                <span class="irt-drawer-hdr-pill-lbl">Client</span>
                                <span class="@StatusCss(_drawerItem.ClientStatus) irt-status-clickable"
                                      title="Click to edit status"
                                      @onclick="@(() => OpenStatusModal(_drawerItem))">@StatusLabel(_drawerItem.ClientStatus)</span>
                                <span class="irt-drawer-hdr-pill-lbl">Investor</span>
                                <span class="@StatusCss(_drawerItem.InvestorStatus) irt-status-clickable"
                                      title="Click to edit status"
                                      @onclick="@(() => OpenStatusModal(_drawerItem))">@StatusLabel(_drawerItem.InvestorStatus)</span>
                            </div>
                        }
                    }
                </div>
                <button class="irt-drawer-close" @onclick="CloseDrawer" title="Close review panel" aria-label="Close">&times;</button>
            </div>

            @* ── Drawer scrollable body ───────────────────────────────────── *@
            <div class="irt-drawer-body">

                @if (_drawerIsOrphan && _drawerOrphanItem is not null)
                {
                    @* ──────────── ORPHAN MODE ──────────── *@

                    @* Review summary band — Expected Total as hero, secondary stats right *@
                    <div class="irt-orphan-summary">
                        @if (_drawerOrphanItem.ExpectedUnitCost > 0)
                        {
                            <div class="irt-orphan-summary__hero">
                                <span class="irt-orphan-summary__hero-lbl">Expected Total</span>
                                <span class="irt-orphan-summary__hero-val">@_drawerOrphanItem.ExpectedTotal.ToString("C2", _us)</span>
                            </div>
                            <div class="irt-orphan-summary__secondary">
                                <div class="irt-orphan-summary__sec-item">
                                    <span class="irt-orphan-summary__sec-lbl">Qty</span>
                                    <span class="irt-orphan-summary__sec-val">@_drawerOrphanItem.RequestedQty.ToString("0.##")</span>
                                </div>
                                <div class="irt-orphan-summary__sec-item">
                                    <span class="irt-orphan-summary__sec-lbl">Unit</span>
                                    <span class="irt-orphan-summary__sec-val">@_drawerOrphanItem.Unit</span>
                                </div>
                                <div class="irt-orphan-summary__sec-item">
                                    <span class="irt-orphan-summary__sec-lbl">Unit Cost</span>
                                    <span class="irt-orphan-summary__sec-val">@_drawerOrphanItem.ExpectedUnitCost.ToString("C2", _us)</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="irt-orphan-summary__hero">
                                <span class="irt-orphan-summary__hero-lbl">Expected Qty</span>
                                <span class="irt-orphan-summary__hero-val">@_drawerOrphanItem.RequestedQty.ToString("0.##")</span>
                            </div>
                            <div class="irt-orphan-summary__secondary">
                                <div class="irt-orphan-summary__sec-item">
                                    <span class="irt-orphan-summary__sec-lbl">Unit</span>
                                    <span class="irt-orphan-summary__sec-val">@_drawerOrphanItem.Unit</span>
                                </div>
                            </div>
                        }
                    </div>

                    @* Missing expense notice + primary action *@
                    <section class="irt-drawer-section">
                        <div class="irt-orphan-notice">
                            <span class="irt-orphan-notice__icon" aria-hidden="true">&#9888;</span>
                            <div class="irt-orphan-notice__body">
                                <span class="irt-orphan-notice__headline">No expense has been submitted for this work item.</span>
                                <span class="irt-orphan-notice__sub">This work item was sent to the vendor but no returned expense is currently linked.</span>
                            </div>
                        </div>
                        <div class="irt-orphan-action">
                            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                           FillMode="@ThemeConstants.Button.FillMode.Solid"
                                           OnClick="@HandleAddExpenseFromDrawer">
                                + Add Expense
                            </TelerikButton>
                        </div>
                    </section>

                    @* Related work items on this work order — informational *@
                    <section class="irt-drawer-section">
                        <h3 class="irt-drawer-section-title">Related Work Items on This Work Order</h3>
                        <div class="irt-drawer-wo-items">
                            @foreach (var li in _lines)
                            {
                                <div class="irt-drawer-wo-item irt-drawer-wo-item--done">
                                    <span class="irt-drawer-wo-item__icon" aria-hidden="true">&#10003;</span>
                                    <span class="irt-drawer-wo-item__name">@li.Description</span>
                                    <span class="irt-drawer-wo-item__id">@li.LineItem</span>
                                </div>
                            }
                            @foreach (var ui in _unexpensedItems)
                            {
                                var isCurrent = ReferenceEquals(ui, _drawerOrphanItem);
                                <div class="irt-drawer-wo-item @(isCurrent ? "irt-drawer-wo-item--current" : "irt-drawer-wo-item--missing")">
                                    <span class="irt-drawer-wo-item__icon" aria-hidden="true">@(isCurrent ? "⚠" : "–")</span>
                                    <span class="irt-drawer-wo-item__name">@ui.Description</span>
                                    <span class="irt-drawer-wo-item__id">@ui.WorkItem</span>
                                </div>
                            }
                        </div>
                    </section>

                    @* Why am I seeing this? — reviewer guidance *@
                    <section class="irt-drawer-section">
                        <h3 class="irt-drawer-section-title">Why am I seeing this?</h3>
                        <p class="irt-drawer-guidance">
                            This work item was sent to the vendor but no returned expense was received. Review the item and either manually add an expense or wait for the vendor to submit one.
                        </p>
                    </section>
                }
                else if (_drawerItem is not null)
                {
                    @* ──────────── EXPENSE REVIEW MODE ──────────── *@

                    @* Section A — Review Summary *@
                    <section class="irt-drawer-section">
                        <h3 class="irt-drawer-section-title">Review Summary</h3>
                        <div class="irt-drawer-kv-grid">
                            <span class="irt-drawer-kv-lbl">Work Order</span>
                            <span class="irt-drawer-kv-val">@_drawerItem.WorkOrderNumber</span>
                            <span class="irt-drawer-kv-lbl">Work Item</span>
                            <span class="irt-drawer-kv-val">@_drawerItem.LineItem — @_drawerItem.Description</span>
                            <span class="irt-drawer-kv-lbl">Vendor</span>
                            <span class="irt-drawer-kv-val">@_drawerItem.VendorName</span>
                            <span class="irt-drawer-kv-lbl">Submitted Total</span>
                            <span class="irt-drawer-kv-val irt-num">@_drawerItem.VendorFeeTotal.ToString("C2", _us)</span>
                            @if (_drawerItem.WoUnitCost.HasValue)
                            {
                                var origQtyS = _drawerItem.OriginalQty ?? _drawerItem.Qty;
                                var expectedTotal = origQtyS * _drawerItem.WoUnitCost!.Value;
                                <span class="irt-drawer-kv-lbl">Expected Total</span>
                                <span class="irt-drawer-kv-val irt-num">@expectedTotal.ToString("C2", _us)</span>
                                <span class="irt-drawer-kv-lbl">Total Variance</span>
                                <span class="irt-drawer-kv-val">
                                    @{
                                        var summaryVar = _drawerItem.VendorVariance;
                                    }
                                    <span class="@GetVarianceCssClass(summaryVar)">
                                        @(summaryVar.HasValue ? summaryVar.Value.ToString("C2", _us) : "—")
                                    </span>
                                    @if (summaryVar.HasValue && summaryVar.Value != 0m)
                                    {
                                        <span class="irt-drawer-var-badge @GetVarianceBadgeCss(summaryVar)">@GetVarianceLabel(summaryVar)</span>
                                    }
                                </span>
                            }
                        </div>
                    </section>

                    @* Section B — Original Work Item *@
                    <section class="irt-drawer-section">
                        <h3 class="irt-drawer-section-title">
                            Original Work Item
                            <span class="irt-drawer-section-source">From original work order</span>
                        </h3>
                        <div class="irt-drawer-kv-grid">
                            <span class="irt-drawer-kv-lbl">Description</span>
                            <span class="irt-drawer-kv-val">@_drawerItem.Description</span>
                            <span class="irt-drawer-kv-lbl">Qty</span>
                            <span class="irt-drawer-kv-val irt-num">@((_drawerItem.OriginalQty ?? _drawerItem.Qty).ToString("0.##"))</span>
                            <span class="irt-drawer-kv-lbl">Unit</span>
                            <span class="irt-drawer-kv-val">@_drawerItem.WoUnit</span>
                            <span class="irt-drawer-kv-lbl">Unit Cost</span>
                            <span class="irt-drawer-kv-val irt-num">@(_drawerItem.WoUnitCost.HasValue ? _drawerItem.WoUnitCost.Value.ToString("C2", _us) : "—")</span>
                            <span class="irt-drawer-kv-lbl">Total</span>
                            <span class="irt-drawer-kv-val irt-num">
                                @if (_drawerItem.WoUnitCost.HasValue)
                                {
                                    @(((_drawerItem.OriginalQty ?? _drawerItem.Qty) * _drawerItem.WoUnitCost!.Value).ToString("C2", _us))
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </span>
                        </div>
                    </section>

                    @* Section C — Vendor Submitted Expense *@
                    <section class="irt-drawer-section">
                        <h3 class="irt-drawer-section-title">
                            Vendor Submitted Expense
                            <span class="irt-drawer-section-source">Submitted by vendor</span>
                        </h3>
                        <div class="irt-drawer-kv-grid">
                            <span class="irt-drawer-kv-lbl">Qty</span>
                            <span class="irt-drawer-kv-val irt-num @(_drawerItem.HasQtyMismatch ? "irt-qty-mismatch" : "")">@_drawerItem.Qty.ToString("0.##")</span>
                            <span class="irt-drawer-kv-lbl">Unit</span>
                            <span class="irt-drawer-kv-val">@_drawerItem.Unit</span>
                            <span class="irt-drawer-kv-lbl">Unit Cost</span>
                            <span class="irt-drawer-kv-val irt-num">@(_drawerItem.VendorUnitCost.HasValue ? _drawerItem.VendorUnitCost.Value.ToString("C2", _us) : "—")</span>
                            <span class="irt-drawer-kv-lbl">Total</span>
                            <span class="irt-drawer-kv-val irt-num">@_drawerItem.VendorFeeTotal.ToString("C2", _us)</span>
                            @if (!string.IsNullOrEmpty(_drawerItem.VendorReference))
                            {
                                <span class="irt-drawer-kv-lbl">Ref #</span>
                                <span class="irt-drawer-kv-val">@_drawerItem.VendorReference</span>
                            }
                        </div>
                    </section>

                    @* Section D — Variance Analysis *@
                    @if (_drawerItem.WoUnitCost.HasValue)
                    {
                        var origQty   = _drawerItem.OriginalQty ?? _drawerItem.Qty;
                        var origCost  = _drawerItem.WoUnitCost!.Value;
                        var origTotal = origQty * origCost;
                        var subQty    = _drawerItem.Qty;
                        var subCost   = _drawerItem.VendorUnitCost ?? 0m;
                        var subTotal  = _drawerItem.VendorFeeTotal;
                        var varQty    = subQty - origQty;
                        var varCost   = subCost - origCost;
                        var varTotal  = subTotal - origTotal;

                        <section class="irt-drawer-section">
                            <h3 class="irt-drawer-section-title">
                                Variance Analysis
                                <span class="irt-drawer-var-badge @GetVarianceBadgeCss(varTotal != 0m ? varTotal : (decimal?)null)">@VarDirectionLabel(varTotal != 0m ? varTotal : (decimal?)null)</span>
                            </h3>
                            <table class="irt-drawer-var-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Original</th>
                                        <th>Submitted</th>
                                        <th>Variance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="irt-drawer-var-row-lbl">Quantity</td>
                                        <td class="irt-drawer-var-num">@origQty.ToString("0.##")</td>
                                        <td class="irt-drawer-var-num @(varQty != 0m ? "irt-qty-mismatch" : "")">@subQty.ToString("0.##")</td>
                                        <td class="irt-drawer-var-num @GetVarianceCssClass(varQty != 0m ? varQty : (decimal?)null)">
                                            @VarFormattedQty(varQty)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="irt-drawer-var-row-lbl">Unit Cost</td>
                                        <td class="irt-drawer-var-num">@origCost.ToString("C2", _us)</td>
                                        <td class="irt-drawer-var-num">@subCost.ToString("C2", _us)</td>
                                        <td class="irt-drawer-var-num @GetVarianceCssClass(varCost != 0m ? varCost : (decimal?)null)">
                                            @VarFormatted(varCost != 0m ? (decimal?)varCost : (decimal?)null)
                                        </td>
                                    </tr>
                                    <tr class="irt-drawer-var-total-row">
                                        <td class="irt-drawer-var-row-lbl">Total</td>
                                        <td class="irt-drawer-var-num">@origTotal.ToString("C2", _us)</td>
                                        <td class="irt-drawer-var-num">@subTotal.ToString("C2", _us)</td>
                                        <td class="irt-drawer-var-num @GetVarianceCssClass(varTotal != 0m ? varTotal : (decimal?)null)">
                                            @VarFormatted(varTotal != 0m ? (decimal?)varTotal : (decimal?)null)
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </section>
                    }

                    @* Section E — Evidence / Photos *@
                    <section class="irt-drawer-section">
                        <h3 class="irt-drawer-section-title">Evidence / Photos</h3>
                        @if (_drawerItem.PhotoCount > 0)
                        {
                            <div class="irt-drawer-photos">
                                @for (var pi = 0; pi < Math.Min(_drawerItem.PhotoCount, 4); pi++)
                                {
                                    var photoIdx = pi;
                                    <div class="irt-drawer-photo-thumb" title="Photo @(photoIdx + 1)">
                                        <span class="irt-drawer-photo-icon">&#128444;</span>
                                        <span class="irt-drawer-photo-lbl">Photo @(photoIdx + 1)</span>
                                    </div>
                                }
                            </div>
                            @if (_drawerItem.PhotoCount > 4)
                            {
                                <p class="irt-drawer-photo-more">+@(_drawerItem.PhotoCount - 4) more photos attached</p>
                            }
                        }
                        else
                        {
                            <div class="irt-drawer-empty-state irt-drawer-empty-state--sm">
                                <span class="irt-drawer-empty-msg">No photos attached to this expense.</span>
                            </div>
                        }
                    </section>

                    @* Section F — Related Work Items *@
                    <section class="irt-drawer-section">
                        <h3 class="irt-drawer-section-title">Related Work Items</h3>
                        <p class="irt-drawer-section-sub">Work items on this work order. Use <strong>Link to this expense</strong> to reassign if the expense is tied to the wrong item.</p>
                        @{
                            var relatedItems = GetRelatedWorkItems(_drawerItem.LineItem);
                        }
                        @if (relatedItems.Any())
                        {
                            <div class="irt-drawer-related-list">
                                @foreach (var rwi in relatedItems)
                                {
                                    var capturedRwi = rwi;
                                    <div class="irt-drawer-related-row @(capturedRwi.IsCurrentlyLinked ? "irt-drawer-related-row--linked" : "")">
                                        <div class="irt-drawer-related-info">
                                            <span class="irt-drawer-related-name">@capturedRwi.Description</span>
                                            <span class="irt-drawer-related-meta">
                                                @capturedRwi.ExpectedQty.ToString("0.##") @capturedRwi.ExpectedUnit
                                                @if (capturedRwi.ExpectedUnitCost > 0)
                                                {
                                                    @(" · ")@capturedRwi.ExpectedUnitCost.ToString("C2", _us)@("/unit")
                                                }
                                            </span>
                                        </div>
                                        <div class="irt-drawer-related-action">
                                            @if (capturedRwi.IsCurrentlyLinked)
                                            {
                                                <span class="irt-drawer-linked-badge">Currently linked</span>
                                            }
                                            else
                                            {
                                                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                               FillMode="@ThemeConstants.Button.FillMode.Outline"
                                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                                               OnClick="@(() => LinkExpenseToWorkItem(_drawerItem!, capturedRwi))">
                                                    Link to this expense
                                                </TelerikButton>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="irt-drawer-empty-state irt-drawer-empty-state--sm">
                                <span class="irt-drawer-empty-msg">No related work items found.</span>
                            </div>
                        }
                    </section>

                    @* Section G — Status / Decision Area *@
                    <section class="irt-drawer-section irt-drawer-section--decision">
                        <h3 class="irt-drawer-section-title">Status &amp; Decision</h3>
                        <div class="irt-drawer-status-grid">
                            <div class="irt-drawer-status-item">
                                <span class="irt-drawer-status-lbl">Business</span>
                                <span class="@StatusCss(_drawerItem.BusinessStatus) irt-status-clickable"
                                      title="Click to edit status"
                                      @onclick="@(() => OpenStatusModal(_drawerItem))">@StatusLabel(_drawerItem.BusinessStatus)</span>
                            </div>
                            <div class="irt-drawer-status-item">
                                <span class="irt-drawer-status-lbl">Client</span>
                                <span class="@StatusCss(_drawerItem.ClientStatus) irt-status-clickable"
                                      title="Click to edit status"
                                      @onclick="@(() => OpenStatusModal(_drawerItem))">@StatusLabel(_drawerItem.ClientStatus)</span>
                            </div>
                            <div class="irt-drawer-status-item">
                                <span class="irt-drawer-status-lbl">Investor</span>
                                <span class="@StatusCss(_drawerItem.InvestorStatus) irt-status-clickable"
                                      title="Click to edit status"
                                      @onclick="@(() => OpenStatusModal(_drawerItem))">@StatusLabel(_drawerItem.InvestorStatus)</span>
                            </div>
                        </div>
                        <div class="irt-drawer-status-actions">
                            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                                           OnClick="@(() => OpenStatusModal(_drawerItem))">
                                Update Statuses
                            </TelerikButton>
                        </div>
                        <p class="irt-drawer-decision-note">
                            <strong>Approving the business status</strong> confirms the work was completed, the vendor expense is acceptable, and any variance has been acknowledged.
                        </p>
                    </section>
                }
            </div>
        </div>
    }

    @* ── Add Expense modal ────────────────────────────────────────────────── *@
    @* Updated: work-item-type combobox (searchable) replaces the read-only context block. *@
    <TelerikWindow @bind-Visible="@_addExpenseModalVisible"
                   Modal="true"
                   Width="520px"
                   Class="irt-ae-window"
                   Draggable="false"
                   Resizable="false"
                   FooterLayoutAlign="WindowFooterLayoutAlign.End">
        <WindowTitle>Add Expense</WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@CloseAddExpenseModal" />
        </WindowActions>
        <WindowContent>
            <div class="irt-ae-form">
                <p class="irt-ae-intro">Map to a work item type and enter expense details.</p>

                @* ── Work Item Type selector + Description ───────────────────── *@
                <div class="irt-ae-row irt-ae-row--2col">
                    <div class="irt-ae-field">
                        <label class="irt-ae-label">
                            Work Item Type
                            <span class="irt-ae-required" aria-hidden="true">*</span>
                        </label>
                        <TelerikComboBox Data="@_workItemCatalogKeys"
                                         TItem="string"
                                         TValue="string"
                                         Value="@_aeWorkItemName"
                                         ValueChanged="@((string v) => OnAeWorkItemChanged(v))"
                                         Filterable="true"
                                         Placeholder="Search or select…"
                                         Width="100%" />
                        @if (_aeAttempted && string.IsNullOrWhiteSpace(_aeWorkItemName))
                        {
                            <span class="irt-ae-validation">Work item type is required.</span>
                        }
                    </div>
                    <div class="irt-ae-field">
                        <label class="irt-ae-label">Description</label>
                        <TelerikTextBox @bind-Value="@_aeDescription" Width="100%" />
                    </div>
                </div>

                <hr class="irt-ae-divider" />

                @* ── Qty + UOM ──────────────────────────────────────── *@
                <div class="irt-ae-row irt-ae-row--qty-uom">
                    <div class="irt-ae-field irt-ae-field--qty">
                        <label class="irt-ae-label">Qty <span class="irt-ae-required" aria-hidden="true">*</span></label>
                        <TelerikNumericTextBox @ref="_aeQtyRef"
                            T="decimal"
                            Value="@_aeQty"
                            ValueChanged="@((decimal v) => { _aeQty = v; _aeAttempted = true; StateHasChanged(); })"
                            Min="0.01m" Decimals="2" Width="100%" />
                        @if (_aeAttempted && _aeQty <= 0)
                        {
                            <span class="irt-ae-validation">Must be greater than 0.</span>
                        }
                    </div>
                    <div class="irt-ae-field irt-ae-field--uom">
                        <label class="irt-ae-label">UOM</label>
                        <TelerikTextBox @bind-Value="@_aeUnit" Width="100%" />
                    </div>
                </div>

                @* ── Vendor Cost + Vendor Total ─────────────────────── *@
                <div class="irt-ae-row irt-ae-row--cost">
                    <div class="irt-ae-field">
                        <label class="irt-ae-label">Vendor Cost <span class="irt-ae-required" aria-hidden="true">*</span></label>
                        <TelerikNumericTextBox T="decimal?"
                            Value="@_aeVendorCost"
                            ValueChanged="@((decimal? v) => { _aeVendorCost = v; _aeAttempted = true; StateHasChanged(); })"
                            Min="0" Decimals="2" Format="C2" Width="100%" />
                        @if (_aeAttempted && !_aeVendorCost.HasValue)
                        {
                            <span class="irt-ae-validation">Vendor cost is required.</span>
                        }
                    </div>
                    <div class="irt-ae-field">
                        <span class="irt-ae-label">Vendor Total</span>
                        <div class="irt-ae-calculated">@AeVendorTotal.ToString("C2", _us)</div>
                    </div>
                </div>

                @* ── Client Cost + Client Total ─────────────────────── *@
                <div class="irt-ae-row irt-ae-row--cost">
                    <div class="irt-ae-field">
                        <label class="irt-ae-label">Client Cost <span class="irt-ae-required" aria-hidden="true">*</span></label>
                        <TelerikNumericTextBox T="decimal?"
                            Value="@_aeClientCost"
                            ValueChanged="@((decimal? v) => { _aeClientCost = v; _aeAttempted = true; StateHasChanged(); })"
                            Min="0" Decimals="2" Format="C2" Width="100%" />
                        @if (_aeAttempted && !_aeClientCost.HasValue)
                        {
                            <span class="irt-ae-validation">Client cost is required.</span>
                        }
                    </div>
                    <div class="irt-ae-field">
                        <span class="irt-ae-label">Client Total</span>
                        <div class="irt-ae-calculated">@AeClientTotal.ToString("C2", _us)</div>
                    </div>
                </div>

                @* ── Notes — optional, full width ───────────────────── *@
                <div class="irt-ae-row">
                    <div class="irt-ae-field">
                        <label class="irt-ae-label">Notes <span class="irt-ae-optional">(optional)</span></label>
                        <textarea class="irt-ae-notes"
                                  @bind="@_aeNotes"
                                  placeholder="Add any notes about this expense…"
                                  rows="2"></textarea>
                    </div>
                </div>

            </div>
        </WindowContent>
        <WindowFooter>
            <div class="irt-ae-footer">
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                               OnClick="@CloseAddExpenseModal">Cancel</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Enabled="@AeFormIsValid"
                               OnClick="@CommitAddExpense">Add Expense</TelerikButton>
            </div>
        </WindowFooter>
    </TelerikWindow>

    @* ── Complete Task validation modal ──────────────────────────────────── *@
    <TelerikWindow @bind-Visible="@_completeValidVisible"
                   Modal="true"
                   Width="460px"
                   Draggable="false"
                   Resizable="false"
                   FooterLayoutAlign="WindowFooterLayoutAlign.End">
        <WindowTitle>Cannot Complete Task</WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@(() => _completeValidVisible = false)" />
        </WindowActions>
        <WindowContent>
            <div class="irt-cv-body">
                <p class="irt-cv-intro">The following issues must be resolved before completing this task:</p>
                <ul class="irt-cv-list">
                    @foreach (var err in _completeValidErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        </WindowContent>
        <WindowFooter>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="@(() => _completeValidVisible = false)">OK — I'll Fix These</TelerikButton>
        </WindowFooter>
    </TelerikWindow>

    @* ── Resolve Mapping modal ────────────────────────────────────────────── *@
    <TelerikWindow @bind-Visible="@_resolveMappingVisible"
                   Width="460px"
                   Modal="true"
                   Class="irt-rm-window">
        <WindowTitle>
            <span class="irt-rm-title">Resolve Product Type Mapping</span>
        </WindowTitle>
        <WindowContent>
            <div class="irt-rm-body">

                @* Vendor description — read-only context *@
                <div class="irt-rm-field">
                    <span class="irt-rm-label">Vendor Description</span>
                    <span class="irt-rm-vendor-desc">@(_resolveMappingTarget?.VendorRawDescription ?? "")</span>
                </div>

                <p class="irt-rm-help">
                    Select the work item type that best matches this vendor expense. The row will be
                    updated immediately and variance will be recalculated once a pricing rule is available.
                </p>

                @* Work item type selector — flat list with category prefix *@
                <div class="irt-rm-field">
                    <label class="irt-rm-label" for="rm-type-select">
                        Work Item Type <span class="irt-rm-required">*</span>
                    </label>
                    <TelerikComboBox Data="@_mappingOptionLabels"
                                     TItem="string"
                                     TValue="string"
                                     @bind-Value="@_rmSelectedType"
                                     Filterable="true"
                                     Placeholder="Search or select work item type…"
                                     Width="100%" />
                    @if (_rmAttempted && string.IsNullOrWhiteSpace(_rmSelectedType))
                    {
                        <span class="irt-rm-error">A work item type is required.</span>
                    }
                </div>

            </div>
        </WindowContent>
        <WindowFooter>
            <div class="irt-rm-footer">
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                               OnClick="@CloseResolveMapping">Cancel</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               OnClick="@ApplyMapping">Apply Mapping</TelerikButton>
            </div>
        </WindowFooter>
    </TelerikWindow>

</div>

@code {
    [Parameter] public string? TaskId { get; set; }

    // ── Culture — class-level so templates and totals bar can share it ────────
    private static readonly CultureInfo _us = CultureInfo.GetCultureInfo("en-US");

    // ── Search ────────────────────────────────────────────────────────────────
    private string _searchTerm = "";

    private IEnumerable<IrtLineItem> FilteredLines =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _lines
            : _lines.Where(l =>
                l.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                l.LineItem.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    // ── Filtered line sets ────────────────────────────────────────────────────
    // FilteredMatchedLines: non-orphaned rows that match the search term.
    // Used for the main financial grid and its totals footer.
    // FilteredLines (all rows): kept for summary cards to show the full picture.

    private IEnumerable<IrtLineItem> FilteredMatchedLines =>
        FilteredLines.Where(l => !l.IsUnmapped && !l.IsExternallyCreated);

    // ── Aggregate totals for the summary bar and summary cards ───────────────
    // Summary cards use all FilteredLines; footer totals use FilteredMatchedLines.
    private decimal TotalVendorFeeTotal  => FilteredLines.Sum(l => l.VendorFeeTotal);
    private decimal TotalClientFeeTotal  => FilteredLines.Sum(l => l.ClientFeeTotal);
    // Spec: exclude dash rows (null variance) from variance sum.
    private decimal TotalVendorVariance  => FilteredLines.Sum(l => l.VendorVariance ?? 0m);
    private decimal TotalClientVariance  => FilteredLines.Sum(l => l.ClientVariance ?? 0m);
    // Prescribed Total = sum of matched WO AP totals.
    private decimal TotalPrescribed      => FilteredMatchedLines.Sum(l => l.WoTotalAP);
    // Requires Review = matched rows with null Business status (orphans handled separately).
    private int     RequiresReviewCount  => FilteredMatchedLines.Count(l => l.BusinessStatus == null);

    // ── Staging / draft state ─────────────────────────────────────────────────
    // LOCAL: edits are in-memory until the user explicitly saves to staging.
    // STAGED: staging saves preserve the task-scoped state; not yet globally visible.
    // COMMITTED: only after Complete Task do changes become live in global views.
    private bool _hasStagedChanges;
    private bool _taskSaved;
    private List<IrtLineItem>? _lastSavedLines;   // deep-copy snapshot for Reset

    private static IrtLineItem CloneLine(IrtLineItem s) => new()
    {
        LineItem            = s.LineItem,
        Description         = s.Description,
        WoDescription       = s.WoDescription,
        OriginalQty         = s.OriginalQty,
        WoUnit              = s.WoUnit,
        WoUnitCost          = s.WoUnitCost,
        WoCustomerUnitCost  = s.WoCustomerUnitCost,
        Qty                 = s.Qty,
        Unit                = s.Unit,
        VendorUnitCost      = s.VendorUnitCost,
        ClientUnitCost      = s.ClientUnitCost,
        BusinessStatus      = s.BusinessStatus,
        ClientStatus        = s.ClientStatus,
        InvestorStatus      = s.InvestorStatus,
        StatusComment       = s.StatusComment,
        WorkOrderNumber     = s.WorkOrderNumber,
        VendorName          = s.VendorName,
        VendorReference     = s.VendorReference,
        PhotoCount          = s.PhotoCount,
        IsUnmapped          = s.IsUnmapped,
        VendorRawDescription = s.VendorRawDescription,
        IsExternallyCreated = s.IsExternallyCreated,
    };

    private void TakeSnapshot() => _lastSavedLines = _lines.Select(CloneLine).ToList();

    private void SaveStagedChanges()
    {
        // TODO: persist to task staging table via API when data layer is wired.
        TakeSnapshot();
        _hasStagedChanges = false;
        _taskSaved        = true;
        StateHasChanged();
    }

    private void DiscardStagedChanges()
    {
        // Restore last saved snapshot, or leave unchanged if no save has occurred.
        if (_lastSavedLines is not null)
            _lines = _lastSavedLines.Select(CloneLine).ToList();
        _hasStagedChanges = false;
        StateHasChanged();
    }

    // ── Navigation / exit guard ──────────────────────────────────────────────
    private bool   _exitGuardVisible;
    private string _pendingNavUrl = "/property-details?tab=Tasks";

    private void HandleBackClick()
    {
        if (_hasStagedChanges)
            _exitGuardVisible = true;
        else
            Navigation.NavigateTo(_pendingNavUrl);
    }

    private void HandleExitTask()
    {
        if (_hasStagedChanges)
            _exitGuardVisible = true;
        else
            Navigation.NavigateTo(_pendingNavUrl);
    }

    private void DiscardAndNavigate()
    {
        _hasStagedChanges = false;
        _exitGuardVisible = false;
        Navigation.NavigateTo(_pendingNavUrl);
    }

    private void SaveDraftAndNavigate()
    {
        SaveStagedChanges();
        _exitGuardVisible = false;
        Navigation.NavigateTo(_pendingNavUrl);
    }

    // ── Complete Task validation ──────────────────────────────────────────────
    private bool         _completeValidVisible;
    private List<string> _completeValidErrors = [];

    private void HandleCompleteTask()
    {
        var errors = new List<string>();

        var unmapped = _lines.Count(l => l.IsUnmapped);
        if (unmapped > 0)
            errors.Add($"{unmapped} unmapped product type(s) must be resolved before completing.");

        var ncNoComment = _lines.Count(l => l.BusinessStatus == "Needs Corrections" && string.IsNullOrWhiteSpace(l.StatusComment));
        if (ncNoComment > 0)
            errors.Add($"{ncNoComment} \"Needs Corrections\" row(s) are missing a required comment.");

        var nullStatus = _lines.Count(l => l.BusinessStatus == null);
        if (nullStatus > 0)
            errors.Add($"{nullStatus} row(s) have no Business status set.");

        var unresolvedOrphans = BuildOrphanRows().Count;
        if (unresolvedOrphans > 0)
            errors.Add($"{unresolvedOrphans} orphaned / unmatched item(s) must be resolved before completing.");

        if (errors.Count > 0)
        {
            _completeValidErrors  = errors;
            _completeValidVisible = true;
            return;
        }

        // All validations passed — commit staged edits.
        // TODO: call task-completion API endpoint when wired.
        if (_hasStagedChanges)
            SaveStagedChanges();
        Navigation.NavigateTo(_pendingNavUrl);
    }


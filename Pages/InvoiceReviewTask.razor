@page "/invoice-review-task/{taskId}"
@layout PropertyShellLayout
@using BlazorBusiness.Web.Components.SingleSourceGrid
@using BlazorBusiness.Web.Components.Tasks.Cards
@using System.Globalization
@implements IDisposable
@inject NavigationManager Navigation

<PageTitle>Invoice Review — @TaskId</PageTitle>

<div class="irt-root">

    @if (_successToastVisible)
    {
        <div class="irt-toast" role="status" aria-live="polite">Expense added successfully</div>
    }

    @* ── Back link ──────────────────────────────────────────────────── *@
    <a href="/property-details?tab=Tasks" class="irt-back">← Back to Tasks</a>

    @* ── Header ─────────────────────────────────────────────────────── *@
    <div class="irt-header">
        <div class="irt-header__left">
            <h1 class="irt-header__title">Review vendor submitted invoice</h1>
            <span class="irt-header__meta">Last updated 9/11/2025 2:32 PM</span>
        </div>
        <div class="irt-header__actions">
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           OnClick="@(() => Navigation.NavigateTo("/property-details?tab=Tasks"))">
                Exit Task
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base">
                Save
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Solid"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Success">
                Complete Task
            </TelerikButton>
        </div>
    </div>

    @* ── Task data card ──────────────────────────────────────────────── *@
    <TaskDetailCard Status="In Progress"
                    StatusVariant="@StatusBadgeVariant.Active"
                    OrderNumber="ORD-882741"
                    FullAddress="1321 Posner Blvd, Davenport, FL 33837"
                    TaskTypeName="Invoice Review"
                    LoanNumber="935720463"
                    InvoiceDate="9/11/2025"
                    DueDate="9/17/2025"
                    InvoiceNumber="INV-29481"
                    TimeElapsed="1d 6h"
                    Assignee="Kristyn G"
                    Vendor="GreenScape LLC" />

    @* ── Submission guidance card ────────────────────────────────────── *@
    @* Cards parameter is omitted — TaskSubmissionGuidanceCard renders its built-in default content.
       TODO: pass Cards="@_guidanceCards" when API-backed guidance data is available. *@
    <TaskSubmissionGuidanceCard />

    @* ── Supporting documents card ───────────────────────────────────── *@
    @* Files parameter is omitted → renders empty state.
       TODO: pass Files="@_attachedFiles" and OnSelectFiles="@HandleSelectFiles" when file service is wired. *@
    <TaskSupportingDocumentsCard />

    @* ── Invoice line items grid ─────────────────────────────────────── *@
    <TelerikCard Class="irt-card" ThemeColor="@ThemeConstants.Card.ThemeColor.Light">
        <CardHeader Class="irt-card-hdr">
            <div class="irt-card-hdr-row">
                <CardTitle>Invoice Line Items</CardTitle>
                <TelerikTextBox @bind-Value="@_searchTerm"
                                PlaceHolder="Search description or line item…"
                                Width="280px" />
            </div>
        </CardHeader>
        <CardBody Class="irt-grid-body">
            @{
                // ── Display templates ─────────────────────────────────────────────
                var colTpl = new Dictionary<string, RenderFragment<IrtLineItem>>
                {
                    [nameof(IrtLineItem.LineItem)] = r =>
                        @<span class="@LineItemCellClass(r)">@r.LineItem</span>,

                    // Work Item — WO reference cost as currency
                    [nameof(IrtLineItem.WoUnitCost)] = r =>
                        @<span class="irt-num">@(r.WoUnitCost.HasValue ? r.WoUnitCost.Value.ToString("C2", _us) : "—")</span>,

                    // Qty — orange when vendor Qty ≠ original WO Qty
                    [nameof(IrtLineItem.Qty)] = r =>
                        @<span class="irt-num @(r.HasQtyMismatch ? "irt-qty-mismatch" : null)">@r.Qty.ToString("0.##")</span>,

                    // Unit costs — "—" when not set
                    [nameof(IrtLineItem.VendorUnitCost)] = r =>
                        @<span class="irt-num">@(r.VendorUnitCost.HasValue ? r.VendorUnitCost.Value.ToString("C2", _us) : "—")</span>,
                    [nameof(IrtLineItem.ClientUnitCost)] = r =>
                        @<span class="irt-num">@(r.ClientUnitCost.HasValue ? r.ClientUnitCost.Value.ToString("C2", _us) : "—")</span>,

                    // Auto-calculated totals
                    [nameof(IrtLineItem.VendorFeeTotal)] = r =>
                        @<span class="irt-num">@r.VendorFeeTotal.ToString("C2", _us)</span>,
                    [nameof(IrtLineItem.ClientFeeTotal)] = r =>
                        @<span class="irt-num">@r.ClientFeeTotal.ToString("C2", _us)</span>,

                    // Variance — "—" when WoUnitCost is null (no pricing rule)
                    [nameof(IrtLineItem.VendorVariance)] = r =>
                        @<span class="irt-num @VarCss(r.VendorVariance)">@(r.VendorVariance.HasValue ? r.VendorVariance.Value.ToString("C2", _us) : "—")</span>,
                    [nameof(IrtLineItem.ClientVariance)] = r =>
                        @<span class="irt-num @VarCss(r.ClientVariance)">@(r.ClientVariance.HasValue ? r.ClientVariance.Value.ToString("C2", _us) : "—")</span>,

                    // Status pills — existing CSS reused; Editable=false prevents inline editing
                    [nameof(IrtLineItem.BusinessStatus)] = r =>
                        @<span class="@StatusCss(r.BusinessStatus)">@StatusLabel(r.BusinessStatus)</span>,
                    [nameof(IrtLineItem.ClientStatus)] = r =>
                        @<span class="@StatusCss(r.ClientStatus)">@StatusLabel(r.ClientStatus)</span>,
                    [nameof(IrtLineItem.InvestorStatus)] = r =>
                        @<span class="@StatusCss(r.InvestorStatus)">@StatusLabel(r.InvestorStatus)</span>,
                };

                // ── Edit templates ────────────────────────────────────────────────
                // Each ValueChanged calls StateHasChanged() so computed totals and variance
                // update live while the row is open for editing.
                var editTpl = new Dictionary<string, RenderFragment<IrtLineItem>>
                {
                    [nameof(IrtLineItem.Qty)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@item.Qty"
                            ValueChanged="@((decimal v) => OnQtyChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,

                    [nameof(IrtLineItem.VendorUnitCost)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@(item.VendorUnitCost ?? 0m)"
                            ValueChanged="@((decimal v) => OnVendorUnitCostChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,

                    [nameof(IrtLineItem.ClientUnitCost)] = item =>
                        @<TelerikNumericTextBox T="decimal"
                            Value="@(item.ClientUnitCost ?? 0m)"
                            ValueChanged="@((decimal v) => OnClientUnitCostChanged(item, v))"
                            Min="0" Decimals="2" Width="100%" />,
                };
            }

            <SingleSourceGrid TItem="IrtLineItem"
                               Data="@FilteredLines"
                               Context="@SsgGridContext.Task"
                               HideGroupingBar="true"
                               ShowColumnMenu="false"
                               AllowEdit="true"
                               AllowSelect="true"
                               SaveButtonLabel="Save Changes"
                               ColumnTemplates="@colTpl"
                               EditTemplates="@editTpl"
                               OnSaveClicked="@HandleSaveClicked">
                <SelectionCommands Context="selected">
                    @if (selected.Any())
                    {
                        <span style="font-size: 0.8125rem; color: #6B7280; align-self: center;">
                            @selected.Count() row(s) selected
                        </span>
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       OnClick="@(() => OpenBulkEditDialog(selected.ToList()))">
                            Bulk Edit
                        </TelerikButton>
                    }
                </SelectionCommands>
            </SingleSourceGrid>

            @* ── Aggregates bar ── shown below the grid, outside Telerik pagination *@
            <div class="irt-totals-bar">
                <span class="irt-totals-label">Totals</span>
                <span class="irt-totals-count">@FilteredLines.Count() items</span>
                <span class="irt-totals-spacer"></span>
                <span class="irt-totals-item">
                    <span class="irt-totals-item__label">Vendor</span>
                    <span class="irt-totals-item__value irt-num">@TotalVendorFeeTotal.ToString("C2", _us)</span>
                </span>
                <span class="irt-totals-item">
                    <span class="irt-totals-item__label">Client</span>
                    <span class="irt-totals-item__value irt-num">@TotalClientFeeTotal.ToString("C2", _us)</span>
                </span>
                <span class="irt-totals-item">
                    <span class="irt-totals-item__label">Vendor Var.</span>
                    <span class="irt-totals-item__value irt-num @VarCss(TotalVendorVariance == 0m ? (decimal?)null : TotalVendorVariance)">@TotalVendorVariance.ToString("C2", _us)</span>
                </span>
                <span class="irt-totals-item">
                    <span class="irt-totals-item__label">Client Var.</span>
                    <span class="irt-totals-item__value irt-num @VarCss(TotalClientVariance == 0m ? (decimal?)null : TotalClientVariance)">@TotalClientVariance.ToString("C2", _us)</span>
                </span>
            </div>
        </CardBody>
    </TelerikCard>

    @* ── Requested work items without expense ──────────────────────────────── *@
    <TelerikCard Class="irt-uwe-card" ThemeColor="@ThemeConstants.Card.ThemeColor.Light">
        <CardHeader Class="irt-uwe-hdr">
            <div class="irt-uwe-hdr-row">
                <CardTitle>Requested Work Items Without Expense</CardTitle>
            </div>
            <p class="irt-uwe-subtitle">These work items were included in the work order but do not currently have associated invoice expenses.</p>
        </CardHeader>
        <CardBody Class="irt-uwe-body">
            <TelerikGrid Data="@_unexpensedItems"
                         Pageable="false"
                         Sortable="false"
                         ShowColumnMenu="false"
                         Class="irt-uwe-grid">
                <GridColumns>
                    <GridColumn Field="@nameof(IrtUnexpensedItem.WorkItem)"     Title="Work Item"  Width="110px" />
                    <GridColumn Field="@nameof(IrtUnexpensedItem.Description)"  Title="Description" />
                    <GridColumn Field="@nameof(IrtUnexpensedItem.RequestedQty)" Title="Req. Qty"   Width="90px" />
                    <GridColumn Field="@nameof(IrtUnexpensedItem.Unit)"         Title="UOM"        Width="72px" />
                    <GridColumn Field="@nameof(IrtUnexpensedItem.Status)"       Title="Status"     Width="218px">
                        <Template Context="item">
                            @{ var uweRow = (IrtUnexpensedItem)item; }
                            <span class="@UweStatusCss(uweRow.Status)">@uweRow.Status</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Title="Action" Width="150px">
                        <Template Context="item">
                            @{ var uweRow = (IrtUnexpensedItem)item; }
                            <div class="irt-uwe-action-cell">
                                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                               FillMode="@ThemeConstants.Button.FillMode.Outline"
                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                               Class="irt-uwe-action-btn"
                                               OnClick="@(() => HandleAddExpense(uweRow))">
                                    + Add Expense
                                </TelerikButton>
                            </div>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        </CardBody>
    </TelerikCard>

    @* ── Bulk edit dialog ─────────────────────────────────────────────────── *@
    <TelerikWindow @bind-Visible="@_bulkDialogVisible"
                   Modal="true"
                   Width="380px"
                   Draggable="false"
                   Resizable="false"
                   FooterLayoutAlign="WindowFooterLayoutAlign.End">
        <WindowTitle>Bulk Edit — @_bulkTargets.Count row(s)</WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@(() => _bulkDialogVisible = false)" />
        </WindowActions>
        <WindowContent>
            <p style="margin: 0 0 14px; font-size: 0.8125rem; color: #6B7280;">
                Leave a field blank to keep existing values unchanged.
            </p>
            <div style="display: flex; flex-direction: column; gap: 14px;">
                <div>
                    <label style="display: block; font-size: 0.8125rem; margin-bottom: 4px; color: #374151;">Qty</label>
                    <TelerikNumericTextBox T="decimal?"
                                          @bind-Value="@_bulkQty"
                                          Min="0" Decimals="2" Width="100%" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.8125rem; margin-bottom: 4px; color: #374151;">Vendor Unit Cost</label>
                    <TelerikNumericTextBox T="decimal?"
                                          @bind-Value="@_bulkVendorUnitCost"
                                          Min="0" Decimals="2" Width="100%" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.8125rem; margin-bottom: 4px; color: #374151;">Client Unit Cost</label>
                    <TelerikNumericTextBox T="decimal?"
                                          @bind-Value="@_bulkClientUnitCost"
                                          Min="0" Decimals="2" Width="100%" />
                </div>
            </div>
        </WindowContent>
        <WindowFooter>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                           OnClick="@(() => _bulkDialogVisible = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="@ApplyBulkEdit">Apply</TelerikButton>
        </WindowFooter>
    </TelerikWindow>

    @* ── Add Expense modal ────────────────────────────────────────────────── *@
    <TelerikWindow @bind-Visible="@_addExpenseModalVisible"
                   Modal="true"
                   Width="500px"
                   Class="irt-ae-window"
                   Draggable="false"
                   Resizable="false"
                   FooterLayoutAlign="WindowFooterLayoutAlign.End">
        <WindowTitle>Add Expense</WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@CloseAddExpenseModal" />
        </WindowActions>
        <WindowContent>
            <div class="irt-ae-form">
                <p class="irt-ae-intro">Enter expense details for the selected work item.</p>

                @* ── Reference context — read-only, above the divider ─ *@
                <div class="irt-ae-context">
                    <div class="irt-ae-row irt-ae-row--2col">
                        <div class="irt-ae-field">
                            <span class="irt-ae-label">Work Item</span>
                            <div class="irt-ae-context-val">@_addExpenseTarget?.WorkItem</div>
                        </div>
                        <div class="irt-ae-field">
                            <span class="irt-ae-label">Description</span>
                            <div class="irt-ae-context-val">@_addExpenseTarget?.Description</div>
                        </div>
                    </div>
                </div>

                <hr class="irt-ae-divider" />

                @* ── Qty + UOM ──────────────────────────────────────── *@
                <div class="irt-ae-row irt-ae-row--qty-uom">
                    <div class="irt-ae-field irt-ae-field--qty">
                        <label class="irt-ae-label">Qty <span class="irt-ae-required" aria-hidden="true">*</span></label>
                        <TelerikNumericTextBox @ref="_aeQtyRef"
                            T="decimal"
                            Value="@_aeQty"
                            ValueChanged="@((decimal v) => { _aeQty = v; _aeAttempted = true; StateHasChanged(); })"
                            Min="0.01m" Decimals="2" Width="100%" />
                        @if (_aeAttempted && _aeQty <= 0)
                        {
                            <span class="irt-ae-validation">Must be greater than 0.</span>
                        }
                    </div>
                    <div class="irt-ae-field irt-ae-field--uom">
                        <label class="irt-ae-label">UOM</label>
                        <TelerikTextBox @bind-Value="@_aeUnit" Width="100%" />
                    </div>
                </div>

                @* ── Vendor Cost + Vendor Total ─────────────────────── *@
                <div class="irt-ae-row irt-ae-row--cost">
                    <div class="irt-ae-field">
                        <label class="irt-ae-label">Vendor Cost <span class="irt-ae-required" aria-hidden="true">*</span></label>
                        <TelerikNumericTextBox T="decimal?"
                            Value="@_aeVendorCost"
                            ValueChanged="@((decimal? v) => { _aeVendorCost = v; _aeAttempted = true; StateHasChanged(); })"
                            Min="0" Decimals="2" Format="C2" Width="100%" />
                        @if (_aeAttempted && !_aeVendorCost.HasValue)
                        {
                            <span class="irt-ae-validation">Vendor cost is required.</span>
                        }
                    </div>
                    <div class="irt-ae-field">
                        <span class="irt-ae-label">Vendor Total</span>
                        <div class="irt-ae-calculated">@AeVendorTotal.ToString("C2", _us)</div>
                    </div>
                </div>

                @* ── Client Cost + Client Total ─────────────────────── *@
                <div class="irt-ae-row irt-ae-row--cost">
                    <div class="irt-ae-field">
                        <label class="irt-ae-label">Client Cost <span class="irt-ae-required" aria-hidden="true">*</span></label>
                        <TelerikNumericTextBox T="decimal?"
                            Value="@_aeClientCost"
                            ValueChanged="@((decimal? v) => { _aeClientCost = v; _aeAttempted = true; StateHasChanged(); })"
                            Min="0" Decimals="2" Format="C2" Width="100%" />
                        @if (_aeAttempted && !_aeClientCost.HasValue)
                        {
                            <span class="irt-ae-validation">Client cost is required.</span>
                        }
                    </div>
                    <div class="irt-ae-field">
                        <span class="irt-ae-label">Client Total</span>
                        <div class="irt-ae-calculated">@AeClientTotal.ToString("C2", _us)</div>
                    </div>
                </div>

                @* ── Notes — optional, full width ───────────────────── *@
                <div class="irt-ae-row">
                    <div class="irt-ae-field">
                        <label class="irt-ae-label">Notes <span class="irt-ae-optional">(optional)</span></label>
                        <textarea class="irt-ae-notes"
                                  @bind="@_aeNotes"
                                  placeholder="Add any notes about this expense…"
                                  rows="2"></textarea>
                    </div>
                </div>

            </div>
        </WindowContent>
        <WindowFooter>
            <div class="irt-ae-footer">
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                               OnClick="@CloseAddExpenseModal">Cancel</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Enabled="@AeFormIsValid"
                               OnClick="@CommitAddExpense">Add Expense</TelerikButton>
            </div>
        </WindowFooter>
    </TelerikWindow>

</div>

@code {
    [Parameter] public string? TaskId { get; set; }

    // ── Culture — class-level so templates and totals bar can share it ────────
    private static readonly CultureInfo _us = CultureInfo.GetCultureInfo("en-US");

    // ── Search ────────────────────────────────────────────────────────────────
    private string _searchTerm = "";

    private IEnumerable<IrtLineItem> FilteredLines =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _lines
            : _lines.Where(l =>
                l.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                l.LineItem.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    // ── Aggregate totals for the summary bar ─────────────────────────────────
    private decimal TotalVendorFeeTotal  => FilteredLines.Sum(l => l.VendorFeeTotal);
    private decimal TotalClientFeeTotal  => FilteredLines.Sum(l => l.ClientFeeTotal);
    private decimal TotalVendorVariance  => FilteredLines.Sum(l => l.VendorVariance ?? 0m);
    private decimal TotalClientVariance  => FilteredLines.Sum(l => l.ClientVariance ?? 0m);

    // ── Inline-edit handlers — trigger StateHasChanged for live calculated fields ──

    private void OnQtyChanged(IrtLineItem item, decimal v)
    {
        item.Qty = v;
        StateHasChanged();
    }

    private void OnVendorUnitCostChanged(IrtLineItem item, decimal v)
    {
        item.VendorUnitCost = v;
        StateHasChanged();
    }

    private void OnClientUnitCostChanged(IrtLineItem item, decimal v)
    {
        item.ClientUnitCost = v;
        StateHasChanged();
    }

    // ── Save handler ──────────────────────────────────────────────────────────
    // TODO: Persist changes via API when invoice data layer is wired.
    // changes.EditedItems contains every row that was modified.
    private Task HandleSaveClicked(SingleSourceGridChangeSet<IrtLineItem> changes)
        => Task.CompletedTask;

    // ── Bulk edit state ───────────────────────────────────────────────────────

    private bool _bulkDialogVisible;
    private List<IrtLineItem> _bulkTargets = [];
    private decimal? _bulkQty;
    private decimal? _bulkVendorUnitCost;
    private decimal? _bulkClientUnitCost;

    private void OpenBulkEditDialog(List<IrtLineItem> targets)
    {
        _bulkTargets = targets;
        _bulkQty = null;
        _bulkVendorUnitCost = null;
        _bulkClientUnitCost = null;
        _bulkDialogVisible = true;
    }

    private void ApplyBulkEdit()
    {
        foreach (var item in _bulkTargets)
        {
            if (_bulkQty.HasValue)             item.Qty = _bulkQty.Value;
            if (_bulkVendorUnitCost.HasValue)   item.VendorUnitCost = _bulkVendorUnitCost.Value;
            if (_bulkClientUnitCost.HasValue)   item.ClientUnitCost = _bulkClientUnitCost.Value;
        }
        _bulkDialogVisible = false;
        StateHasChanged();
    }

    // ── Add Expense state ─────────────────────────────────────────────────────

    private bool             _addExpenseModalVisible;
    private IrtUnexpensedItem? _addExpenseTarget;
    private TelerikNumericTextBox<decimal>? _aeQtyRef;
    private bool             _aeFocusQtyOnOpen;

    // Form fields — reset each time the modal opens
    private decimal  _aeQty;
    private string   _aeUnit      = "";
    private decimal? _aeVendorCost;
    private decimal? _aeClientCost;
    private string   _aeNotes     = "";
    private bool     _aeAttempted;   // true after first field interaction; gates validation messages

    // Success toast + newly added row highlight
    private bool     _successToastVisible;
    private string?  _newlyAddedLineItem;
    private CancellationTokenSource? _toastCts;
    private CancellationTokenSource? _highlightCts;

    // Live-calculated totals shown in the modal
    private decimal AeVendorTotal => _aeQty * (_aeVendorCost ?? 0m);
    private decimal AeClientTotal => _aeQty * (_aeClientCost ?? 0m);

    // Submit is enabled only when all required fields are valid
    private bool AeFormIsValid =>
        _aeQty > 0 &&
        _aeVendorCost.HasValue &&
        _aeClientCost.HasValue;

    private void HandleAddExpense(IrtUnexpensedItem item)
    {
        _addExpenseTarget    = item;
        _aeQty               = item.RequestedQty;  // pre-fill from WO requested qty
        _aeUnit              = item.Unit;
        _aeVendorCost        = null;
        _aeClientCost        = null;
        _aeNotes             = "";
        _aeAttempted         = false;
        _aeFocusQtyOnOpen    = true;
        _addExpenseModalVisible = true;
    }

    private void CloseAddExpenseModal()
    {
        _addExpenseModalVisible = false;
        _aeFocusQtyOnOpen = false;
    }

    private async Task CommitAddExpense()
    {
        _aeAttempted = true;
        if (!AeFormIsValid) return;

        var newItem = new IrtLineItem
        {
            LineItem       = _addExpenseTarget!.WorkItem,
            Description    = _addExpenseTarget.Description,
            WoUnit         = _addExpenseTarget.Unit,
            WoUnitCost     = null,   // no WO pricing rule — variance columns will show "—"
            OriginalQty    = _addExpenseTarget.RequestedQty,
            Qty            = _aeQty,
            Unit           = _aeUnit,
            VendorUnitCost = _aeVendorCost,
            ClientUnitCost = _aeClientCost,
            BusinessStatus = null,   // reviewer assigns status after the expense is added
            ClientStatus   = null,
            InvestorStatus = null,
        };

        // Create a new list reference so SingleSourceGrid.OnParametersSet detects the change
        // and rebuilds its working copy. TODO: persist via API when wired.
        var updatedLines = new List<IrtLineItem>(_lines) { newItem };
        _lines = updatedLines;

        // Remove the satisfied row from the unexpensed section.
        // ToList() produces a new reference so TelerikGrid re-renders.
        _unexpensedItems = _unexpensedItems.Where(i => i != _addExpenseTarget).ToList();

        _addExpenseModalVisible = false;
        _aeFocusQtyOnOpen = false;

        _newlyAddedLineItem = newItem.LineItem;
        await ShowSuccessToastAsync();
        ScheduleClearRowHighlight();

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_addExpenseModalVisible && _aeFocusQtyOnOpen && _aeQtyRef is not null)
        {
            _aeFocusQtyOnOpen = false;
            await _aeQtyRef.FocusAsync();
        }
    }

    private async Task ShowSuccessToastAsync()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        _successToastVisible = true;
        StateHasChanged();

        try
        {
            await Task.Delay(3000, token);
            _successToastVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private void ScheduleClearRowHighlight()
    {
        _highlightCts?.Cancel();
        _highlightCts?.Dispose();
        _highlightCts = new CancellationTokenSource();
        _ = ClearRowHighlightAfterDelayAsync(_highlightCts.Token);
    }

    private async Task ClearRowHighlightAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(2400, token);
            _newlyAddedLineItem = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private string LineItemCellClass(IrtLineItem item) =>
        item.LineItem == _newlyAddedLineItem ? "irt-row-new-marker" : "";

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _highlightCts?.Cancel();
        _highlightCts?.Dispose();
    }


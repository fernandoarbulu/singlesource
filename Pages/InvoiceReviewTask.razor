    // Build the related work items list for the drawer based on current _lines data.
    // The item matching the current override (or the drawer item's own LineItem) is marked "Currently linked".
    private IReadOnlyList<IrtDrawerRelatedWorkItem> GetRelatedWorkItems(string currentLineItemId)
    {
        var linkedTarget = _drawerLinkOverrides.GetValueOrDefault(currentLineItemId, currentLineItemId);
        return _lines
            .Select(l => new IrtDrawerRelatedWorkItem
            {
                WorkItemId       = l.LineItem,
                Description      = l.Description,
                ExpectedQty      = l.OriginalQty ?? l.Qty,
                ExpectedUnit     = l.WoUnit,
                ExpectedUnitCost = l.WoUnitCost ?? 0m,
                IsCurrentlyLinked = l.LineItem == linkedTarget,
            })
            .ToList();
    }


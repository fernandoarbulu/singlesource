    // Form fields reset each time the modal opens.

    private bool               _addExpenseModalVisible;
    private IrtUnexpensedItem? _addExpenseTarget;
    private TelerikNumericTextBox<decimal>? _aeQtyRef;
    private bool               _aeFocusQtyOnOpen;

    private string   _aeWorkItemName = "";
    private string   _aeDescription  = "";
    private decimal  _aeQty;
    private string   _aeUnit         = "";
    private decimal? _aeVendorCost;
    private decimal? _aeClientCost;
    private string   _aeNotes        = "";
    private bool     _aeAttempted;

    // Live-calculated totals shown in the modal
    private decimal AeVendorTotal => _aeQty * (_aeVendorCost ?? 0m);
    private decimal AeClientTotal => _aeQty * (_aeClientCost ?? 0m);

    // Submit enabled only when all required fields are valid
    private bool AeFormIsValid =>
        !string.IsNullOrWhiteSpace(_aeWorkItemName) &&
        _aeQty > 0 &&
        _aeVendorCost.HasValue &&
        _aeClientCost.HasValue;

    // ── Work-item type catalog ───────────────────────────────────────────────
    // Maps display name → (description template, default UOM).
    // Selecting a known type auto-populates description and UOM; user can edit afterward.
    // TODO: replace with API-backed service catalog when wired.

    private static readonly Dictionary<string, (string Description, string Unit)> _workItemCatalog
        = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Appliance Removal"]   = ("Remove and dispose of appliances from property", "EA"),
        ["Boarding"]            = ("Board windows and doors for property security",  "EA"),
        ["Debris Removal"]      = ("Remove debris from property",                    "LS"),
        ["Exterior Power Wash"] = ("Pressure wash exterior surfaces",                "LS"),
        ["Fertilization"]       = ("Apply fertilizer treatment to lawn",             "LS"),
        ["Gutter Cleaning"]     = ("Clean gutters and downspouts",                   "EA"),
        ["Hedge Trimming"]      = ("Trim hedges and shrubs",                         "EA"),
        ["HVAC Inspection"]     = ("Inspect and service HVAC system",                "EA"),
        ["Irrigation Check"]    = ("Inspect and service irrigation system",          "EA"),
        ["Lawn Mowing"]         = ("Mow lawn and edge borders",                      "EA"),
        ["Lock Change"]         = ("Change locks on all exterior doors",             "EA"),
        ["Mulch Installation"]  = ("Install fresh mulch in landscaped areas",        "CY"),
        ["Pest Treatment"]      = ("Apply pest control treatment",                   "LS"),
        ["Pool Cleanup"]        = ("Clean and treat pool water and surfaces",        "EA"),
        ["Stump Grinding"]      = ("Grind tree stumps to ground level",              "EA"),
        ["Tree Trimming"]       = ("Trim and shape trees",                           "EA"),
        ["Trash Out"]           = ("Remove trash and unwanted items from property",  "LS"),
    };

    private static readonly List<string> _workItemCatalogKeys =
        [.. _workItemCatalog.Keys.OrderBy(k => k)];

    private void OnAeWorkItemChanged(string value)
    {
        _aeWorkItemName = value ?? "";
        // Auto-populate description and UOM from the catalog when a known type is selected.
        // Always overwrite description so the user sees the canonical template.
        if (!string.IsNullOrWhiteSpace(value) && _workItemCatalog.TryGetValue(value, out var meta))
        {
            _aeDescription = meta.Description;
            if (string.IsNullOrWhiteSpace(_aeUnit))
                _aeUnit = meta.Unit;
        }
        StateHasChanged();
    }

    private void HandleAddExpense(IrtUnexpensedItem item)
    {
        _addExpenseTarget     = item;
        // Pre-fill work item name from the Description column (human-readable);
        // trigger catalog lookup to populate description template if it exists.
        _aeWorkItemName       = item.Description;
        _aeDescription        = item.Description;
        if (_workItemCatalog.TryGetValue(item.Description, out var catalogMeta))
            _aeDescription = catalogMeta.Description;
        _aeQty                = item.RequestedQty;
        _aeUnit               = item.Unit;
        _aeVendorCost         = null;
        _aeClientCost         = null;
        _aeNotes              = "";
        _aeAttempted          = false;
        _aeFocusQtyOnOpen     = true;
        _addExpenseModalVisible = true;
    }

    private void CloseAddExpenseModal()
    {
        _addExpenseModalVisible = false;
        _aeFocusQtyOnOpen = false;
    }

    private async Task CommitAddExpense()
    {
        _aeAttempted = true;
        if (!AeFormIsValid) return;

        var newItem = new IrtLineItem
        {
            LineItem       = _aeWorkItemName,
            Description    = string.IsNullOrWhiteSpace(_aeDescription) ? _aeWorkItemName : _aeDescription,
            WoUnit         = _aeUnit,
            WoUnitCost     = null,   // no WO pricing rule — variance columns will show "—"
            OriginalQty    = _addExpenseTarget?.RequestedQty,
            Qty            = _aeQty,
            Unit           = _aeUnit,
            VendorUnitCost = _aeVendorCost,
            ClientUnitCost = _aeClientCost,
            BusinessStatus = null,   // reviewer assigns status after the expense is added
            ClientStatus   = null,
            InvestorStatus = null,
        };

        // Create a new list reference so SingleSourceGrid.OnParametersSet detects the change.
        // TODO: persist via API when wired.
        _lines = [.. _lines, newItem];

        // Remove the satisfied row from the unexpensed section.
        if (_addExpenseTarget is not null)
            _unexpensedItems = _unexpensedItems.Where(i => i != _addExpenseTarget).ToList();

        _addExpenseModalVisible = false;
        _aeFocusQtyOnOpen       = false;
        _hasStagedChanges       = true;

        _newlyAddedLineItem = newItem.LineItem;
        await ShowSuccessToastAsync();
        ScheduleClearRowHighlight();

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_addExpenseModalVisible && _aeFocusQtyOnOpen && _aeQtyRef is not null)
        {
            _aeFocusQtyOnOpen = false;
            await _aeQtyRef.FocusAsync();
        }
    }

    // ── Toast / row-highlight helpers ─────────────────────────────────────────

    private bool     _successToastVisible;
    private string?  _newlyAddedLineItem;
    private CancellationTokenSource? _toastCts;
    private CancellationTokenSource? _highlightCts;

    private async Task ShowSuccessToastAsync()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        _successToastVisible = true;
        StateHasChanged();

        try
        {
            await Task.Delay(3000, token);
            _successToastVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private void ScheduleClearRowHighlight()
    {
        _highlightCts?.Cancel();
        _highlightCts?.Dispose();
        _highlightCts = new CancellationTokenSource();
        _ = ClearRowHighlightAfterDelayAsync(_highlightCts.Token);
    }

    private async Task ClearRowHighlightAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(2400, token);
            _newlyAddedLineItem = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private string LineItemCellClass(IrtLineItem item) =>
        item.LineItem == _newlyAddedLineItem ? "irt-row-new-marker" : "";

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _highlightCts?.Cancel();
        _highlightCts?.Dispose();
    }

